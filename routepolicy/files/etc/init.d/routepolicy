#!/bin/sh /etc/rc.common

# Consumed by OpenWrt's rc.common framework.
# shellcheck disable=SC2034
START=95
# shellcheck disable=SC2034
STOP=10
# shellcheck disable=SC2034
USE_PROCD=1

ROUTEPOLICY_CTL=${ROUTEPOLICY_CTL:-/usr/sbin/routepolicyctl}
ROUTEPOLICY_APPLY=${ROUTEPOLICY_APPLY:-/usr/libexec/routepolicy/apply}
ROUTEPOLICY_WATCH=${ROUTEPOLICY_WATCH:-/usr/libexec/routepolicy/watch}
ROUTEPOLICY_INIT_TRANSACTION=${ROUTEPOLICY_INIT_TRANSACTION:-/usr/libexec/routepolicy/init-transaction}

start_service() {
	if [ "${1:-}" = init-confirmed ]; then
		# Only the live confirmation writer may register watch without applying again.
		"$ROUTEPOLICY_INIT_TRANSACTION" watch-ready >/dev/null || return 1
	else
		# Startup is the reboot boundary; restore unfinished mutations before normal policy apply.
		if [ -x "$ROUTEPOLICY_INIT_TRANSACTION" ]; then
			"$ROUTEPOLICY_INIT_TRANSACTION" recover-startup >/dev/null || return 1
		fi
	fi
	config_load routepolicy
	enabled=0
	config_get_bool enabled main enabled 0
	if [ "$enabled" -ne 1 ]; then
		printf '%s\n' 'RoutePolicy 未启用；已跳过应用并保持停用'
		return 0
	fi
	# The coordinator owns cold boot policy/DNS admission; keep its watcher available.
	if [ "${1:-}" != init-confirmed ] && ! "$ROUTEPOLICY_INIT_TRANSACTION" boot-pending >/dev/null 2>&1; then
		"$ROUTEPOLICY_CTL" apply || return 1
	fi
	procd_open_instance
	procd_set_param command "$ROUTEPOLICY_WATCH"
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

reload_service() {
	config_load routepolicy
	enabled=0
	config_get_bool enabled main enabled 0
	if [ "$enabled" -eq 1 ]; then
		"$ROUTEPOLICY_CTL" reload
	else
		"$ROUTEPOLICY_APPLY" teardown
	fi
}

stop_service() {
	"$ROUTEPOLICY_APPLY" teardown
}

service_triggers() {
	procd_add_reload_trigger routepolicy
}
