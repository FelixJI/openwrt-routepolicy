#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
	config_load routepolicy
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0
	/usr/sbin/routepolicyctl apply || return 1
	procd_open_instance
	procd_set_param command /usr/libexec/routepolicy/watch
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

reload_service() {
	config_load routepolicy
	config_get_bool enabled main enabled 0
	if [ "$enabled" -eq 1 ]; then
		/usr/sbin/routepolicyctl reload
	else
		/usr/libexec/routepolicy/apply teardown
	fi
}

stop_service() {
	/usr/libexec/routepolicy/apply teardown
}

service_triggers() {
	procd_add_reload_trigger routepolicy
}
