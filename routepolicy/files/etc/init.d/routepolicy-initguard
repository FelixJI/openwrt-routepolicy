#!/bin/sh /etc/rc.common
# The recovery guard is independent of the browser, SSH session and policy watcher.
# shellcheck disable=SC2034
START=94
# shellcheck disable=SC2034
STOP=09
# shellcheck disable=SC2034
USE_PROCD=1
ROUTEPOLICY_INIT_TRANSACTION=${ROUTEPOLICY_INIT_TRANSACTION:-/usr/libexec/routepolicy/init-transaction}

start_service() {
	# A transient boot failure still needs the existing supervised retry worker.
	"$ROUTEPOLICY_INIT_TRANSACTION" boot-dns >/dev/null || true
	"$ROUTEPOLICY_INIT_TRANSACTION" guard-needed || return 0
	procd_open_instance guard
	procd_set_param command "$ROUTEPOLICY_INIT_TRANSACTION" guard
	procd_set_param respawn 3600 2 0
	procd_close_instance
}
