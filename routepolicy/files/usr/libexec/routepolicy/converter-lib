#!/bin/sh

set -eu

mode=$1
shift
[ "$#" -le 1 ] || { echo 'converter: expected zero or one input file' >&2; exit 2; }

temporary=
converted=
if [ "$#" -eq 1 ]; then
	input=$1
	[ -f "$input" ] || { echo 'converter: input is not a regular file' >&2; exit 2; }
else
	temporary=$(mktemp "${TMPDIR:-/tmp}/routepolicy-convert.XXXXXX") || exit 1
	trap 'rm -f "$temporary"' EXIT HUP INT TERM
	cat >"$temporary"
	input=$temporary
fi
converted=$(mktemp "${TMPDIR:-/tmp}/routepolicy-converted.XXXXXX") || exit 1
old_trap=$temporary
trap 'rm -f "$old_trap" "$converted"' EXIT HUP INT TERM

[ -s "$input" ] || { echo 'converter: empty input' >&2; exit 2; }
if head -c 2048 "$input" | LC_ALL=C grep -Eiq '<(!doctype|html|head|body)([[:space:]>])'; then
	echo 'converter: HTML response rejected' >&2
	exit 2
fi

if ! LC_ALL=C awk -v mode="$mode" -v strict="${ROUTEPOLICY_CONVERTER_STRICT:-0}" '
function trim(s) { sub(/^[ \t\r\n]+/, "", s); sub(/[ \t\r\n]+$/, "", s); return s }
function domain(s, n,a,i,label) {
  s=tolower(trim(s)); sub(/^\*\./, "", s); sub(/\.$/, "", s)
  if (length(s)<1 || length(s)>253 || s !~ /^[a-z0-9.-]+$/ || s ~ /\.\./) return ""
  n=split(s,a,"."); if (n<2) return ""
  for(i=1;i<=n;i++){label=a[i]; if(length(label)<1||length(label)>63||label~/^-/||label~/-$/) return ""}
  if (a[n] ~ /^[0-9]+$/) return ""
  return s
}
function ipnum(s, a,n,i,v) {
  if (s !~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) return -1
  n=split(s,a,"."); if(n!=4) return -1; v=0
  for(i=1;i<=4;i++){if(a[i] !~ /^[0-9]+$/ || a[i]+0>255) return -1; v=v*256+(a[i]+0)}
  return v
}
function iptext(v,a,b,c,d) {
  a=int(v/16777216); v-=a*16777216; b=int(v/65536); v-=b*65536; c=int(v/256); d=v-c*256
  return a "." b "." c "." d
}
function overlap(a,b,c,d){return a<=d && c<=b}
function reserved(a,b) {
  if(overlap(a,b,0,16777215)) return 1
  if(overlap(a,b,167772160,184549375)) return 1
  if(overlap(a,b,1681915904,1686110207)) return 1
  if(overlap(a,b,2130706432,2147483647)) return 1
  if(overlap(a,b,2851995648,2852061183)) return 1
  if(overlap(a,b,2886729728,2887778303)) return 1
  if(overlap(a,b,3221225472,3221225727)) return 1
  if(overlap(a,b,3221225984,3221226239)) return 1
  if(overlap(a,b,3227017984,3227018239)) return 1
  if(overlap(a,b,3232235520,3232301055)) return 1
  if(overlap(a,b,3323068416,3323199487)) return 1
  if(overlap(a,b,3325256704,3325256959)) return 1
  if(overlap(a,b,3405803776,3405804031)) return 1
  if(overlap(a,b,3758096384,4294967295)) return 1
  return 0
}
function cidr(s,p,a,ip,block,base,last,out) {
  s=trim(s); p=index(s,"/")
  if(p){ip=substr(s,1,p-1); a=substr(s,p+1); if(a!~/^[0-9]+$/||a+0>32)return ""; a+=0}else{ip=s;a=32}
  ip=ipnum(ip); if(ip<0)return ""; block=2^(32-a); base=int(ip/block)*block; last=base+block-1
  if(reserved(base,last))return ""; out=iptext(base); if(a<32)out=out "/" a; return out
}
function emit_domain(s,d){d=domain(s);if(d!=""){print d;return 1} invalid++;return 0}
function emit_ip(s,c){c=cidr(s);if(c!=""){print c;return 1} invalid++;return 0}
{
  sub(/\r$/, ""); line=trim($0); if(line==""||line~/^[#;]/)next
  if(mode=="plain-domain") {sub(/[ \t]+#.*/,"",line);emit_domain(line);next}
  if(mode=="plain-ipv4") {sub(/[ \t]+#.*/,"",line);emit_ip(line);next}
  if(mode=="hosts-domain") {
    sub(/[ \t]+#.*/,"",line); n=split(line,f,/[ \t]+/); if(n<2||ipnum(f[1])<0){invalid++;next}
    for(i=2;i<=n;i++)emit_domain(f[i]);next
  }
  if(mode=="adblock-domain") {
    if(line~/^@@/||line~/^!/)next
    if(line~/^\|\|/){sub(/^\|\|/,"",line);sub(/\^.*/,"",line);emit_domain(line)}
    else invalid++
    next
  }
  if(mode=="dnsmasq-domain") {
    if(line!~/^(server|address)=\//){invalid++;next}
    n=split(line,f,"/"); for(i=2;i<n;i++)emit_domain(f[i]);next
  }
  if(mode=="clash-domain") {
    n=split(line,f,","); kind=trim(f[1]); if(n>=2&&(kind=="DOMAIN"||kind=="DOMAIN-SUFFIX"))emit_domain(f[2]);else if(kind!="IP-CIDR"&&kind!="IP-CIDR6")invalid++;next
  }
  if(mode=="clash-ipv4") {
    n=split(line,f,","); kind=trim(f[1]); if(n>=2&&kind=="IP-CIDR")emit_ip(f[2]);else if(kind!="IP-CIDR6"&&kind!="DOMAIN"&&kind!="DOMAIN-SUFFIX")invalid++;next
  }
}
END { if(strict==1 && invalid>0) exit 3 }
' "$input" >"$converted"; then
	echo 'converter: invalid input rejected in strict mode' >&2
	exit 3
fi
[ -s "$converted" ] || { echo 'converter: no valid entries' >&2; exit 2; }
LC_ALL=C sort -u "$converted"
