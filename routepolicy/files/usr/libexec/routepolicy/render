#!/bin/sh

set -eu
LIBEXEC=${ROUTEPOLICY_LIBEXEC:-$(dirname "$0")}
. "$LIBEXEC/common"

rp_ensure_dirs
work=$(mktemp -d "$RP_RUN_DIR/render.XXXXXX") || exit 1
trap 'rm -rf "$work"' EXIT HUP INT TERM

normalize_list() {
	name=$1
	format=$2
	raw="$work/$name.raw"
	out="$RP_RUN_DIR/lists/$name.list.new"
	rp_merge_lists "$name" "$raw"
	if [ -s "$raw" ]; then
		"$LIBEXEC/converters/$format" "$raw" >"$out"
	else
		: >"$out"
	fi
	mv -f "$out" "$RP_RUN_DIR/lists/$name.list"
}

normalize_list domain-policy plain-domain
normalize_list domain-default plain-domain
normalize_list ipv4-policy plain-ipv4
normalize_list ipv4-default plain-ipv4

lan_if=$(rp_uci_get main lan_interface lan)
lan_device=$(rp_interface_device "$lan_if") || lan_device=
rp_is_device "$lan_device" || { rp_output_error render "无法解析 LAN 实际设备: $lan_if"; exit 1; }
mark=$(rp_uci_get main mark 0x100)
mask=$(rp_uci_get main mark_mask 0x100)
inv=$(rp_inverse_mask "$mask")
dns_redirect=$(rp_uci_get main dns_redirect 1)
route_local_traffic=$(rp_uci_get main route_local_traffic 0)
source_accounting=$(rp_uci_get main source_accounting 0)
source_idle_timeout=$(rp_uci_get main source_idle_timeout 600)
source_max_entries=$(rp_uci_get main source_max_entries 4096)
managed_devices=$lan_device
for managed_if in "$(rp_uci_get main default_interface wan)" "$(rp_uci_get main policy_interface usbwan)"; do
	managed_device=$(rp_interface_device "$managed_if" 2>/dev/null) || managed_device=
	rp_is_device "$managed_device" || continue
	case " $managed_devices " in *" $managed_device "*) ;; *) managed_devices="$managed_devices $managed_device" ;; esac
done

elements() {
	file=$1
	first=1
	while IFS= read -r item; do
		[ -n "$item" ] || continue
		if [ "$first" -eq 1 ]; then first=0; else printf ', '; fi
		printf '%s' "$item"
	done <"$file"
}

emit_full_rule() {
	chain=$1
	shift
	: "$chain"
	printf '\t\t%s\n' "$*"
}

emit_update_rule() {
	chain=$1
	shift
	printf 'add rule inet routepolicy %s %s\n' "$chain" "$*"
}

emit_prerouting_rules() {
	emitter=$1
	"$emitter" prerouting "iifname != \"$lan_device\" return comment \"routepolicy: non-LAN\""
	if [ "$dns_redirect" = 1 ]; then
		"$emitter" prerouting 'meta l4proto { tcp, udp } th dport 53 counter redirect to :53 comment "routepolicy: DNS redirect"'
	fi
	"$emitter" prerouting "ct mark & $mask != 0 meta mark set (meta mark & $inv) | $mark counter return comment \"routepolicy: established policy connection\""
	"$emitter" prerouting "ct mark & $mask == 0 meta mark set meta mark & $inv comment \"routepolicy: clear default connection mark\""
	"$emitter" prerouting 'jump classify comment "routepolicy: classify LAN destination"'
}

emit_output_rules() {
	emitter=$1
	if [ "$route_local_traffic" != 1 ]; then
		"$emitter" output 'counter return comment "routepolicy: local IPv4 routing disabled"'
		return
	fi
	"$emitter" output "ct state established,related ct mark & $mask != 0 counter meta mark set (meta mark & $inv) | $mark return comment \"routepolicy: restore local connection mark\""
	"$emitter" output "ct state new meta mark & $mask != 0 counter ct mark set (ct mark & $inv) | $mark return comment \"routepolicy: preserve local socket mark\""
	"$emitter" output 'jump classify comment "routepolicy: classify local destination"'
}

emit_classify_rules() {
	emitter=$1
	"$emitter" classify 'ip daddr { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/3 } counter return comment "routepolicy: excluded destination"'
	"$emitter" classify "ip daddr @domain_default4 counter ct mark set ct mark & $inv meta mark set meta mark & $inv return comment \"routepolicy: dynamic default override\""
	"$emitter" classify "ip daddr @static_default4 counter ct mark set ct mark & $inv meta mark set meta mark & $inv return comment \"routepolicy: static default override\""
	"$emitter" classify "ip daddr @domain_policy4 counter ct mark set (ct mark & $inv) | $mark meta mark set (meta mark & $inv) | $mark comment \"routepolicy: dynamic policy\""
	"$emitter" classify "ip daddr @static_policy4 counter ct mark set (ct mark & $inv) | $mark meta mark set (meta mark & $inv) | $mark comment \"routepolicy: static policy\""
}

emit_source_rules() {
	emitter=$1 chain=$2 direction=$3
	if [ "$source_accounting" != 1 ]; then
		"$emitter" "$chain" 'counter return comment "routepolicy: source accounting disabled"'
		return
	fi
	for device in $managed_devices; do
		if [ "$direction" = ingress ]; then
			"$emitter" "$chain" "iifname \"$device\" update @source_ingress4 { iifname . ip saddr counter } comment \"routepolicy: account ingress source\""
		else
			"$emitter" "$chain" "oifname \"$device\" update @source_egress4 { oifname . ip saddr counter } comment \"routepolicy: account egress source\""
		fi
	done
}

full="$work/rules.nft"
{
	cat <<EOF
table inet routepolicy {
	set domain_policy4 {
		type ipv4_addr
		flags timeout
		timeout 1h
		gc-interval 1m
	}
	set domain_default4 {
		type ipv4_addr
		flags timeout
		timeout 1h
		gc-interval 1m
	}
	set static_policy4 {
		type ipv4_addr
		flags interval
		auto-merge
EOF
	if [ -s "$RP_RUN_DIR/lists/ipv4-policy.list" ]; then printf '\t\telements = { '; elements "$RP_RUN_DIR/lists/ipv4-policy.list"; printf ' }\n'; fi
	cat <<EOF
	}
	set static_default4 {
		type ipv4_addr
		flags interval
		auto-merge
EOF
	if [ -s "$RP_RUN_DIR/lists/ipv4-default.list" ]; then printf '\t\telements = { '; elements "$RP_RUN_DIR/lists/ipv4-default.list"; printf ' }\n'; fi
	cat <<EOF
	}
	set source_ingress4 {
		type ifname . ipv4_addr
		flags dynamic,timeout
		timeout ${source_idle_timeout}s
		gc-interval 60s
		size $source_max_entries
		policy memory
		counter
	}
	set source_egress4 {
		type ifname . ipv4_addr
		flags dynamic,timeout
		timeout ${source_idle_timeout}s
		gc-interval 60s
		size $source_max_entries
		policy memory
		counter
	}
	chain prerouting {
		type filter hook prerouting priority mangle; policy accept;
EOF
	emit_prerouting_rules emit_full_rule
	cat <<EOF
	}
	chain output {
		type route hook output priority mangle; policy accept;
EOF
	emit_output_rules emit_full_rule
	cat <<EOF
	}
	chain classify {
EOF
	emit_classify_rules emit_full_rule
	cat <<EOF
	}
	chain source_prerouting {
		type filter hook prerouting priority mangle; policy accept;
EOF
	emit_source_rules emit_full_rule source_prerouting ingress
	cat <<EOF
	}
	chain source_postrouting {
		type filter hook postrouting priority mangle; policy accept;
EOF
	emit_source_rules emit_full_rule source_postrouting egress
	cat <<EOF
	}
}
EOF
} >"$full"

update="$work/update.nft"
{
	cat <<EOF
flush set inet routepolicy static_policy4
flush set inet routepolicy static_default4
EOF
	if [ -s "$RP_RUN_DIR/lists/ipv4-policy.list" ]; then printf 'add element inet routepolicy static_policy4 { '; elements "$RP_RUN_DIR/lists/ipv4-policy.list"; printf ' }\n'; fi
	if [ -s "$RP_RUN_DIR/lists/ipv4-default.list" ]; then printf 'add element inet routepolicy static_default4 { '; elements "$RP_RUN_DIR/lists/ipv4-default.list"; printf ' }\n'; fi
	cat <<EOF
flush chain inet routepolicy prerouting
flush chain inet routepolicy output
flush chain inet routepolicy classify
flush chain inet routepolicy source_prerouting
flush chain inet routepolicy source_postrouting
EOF
	emit_prerouting_rules emit_update_rule
	emit_output_rules emit_update_rule
	emit_classify_rules emit_update_rule
	emit_source_rules emit_update_rule source_prerouting ingress
	emit_source_rules emit_update_rule source_postrouting egress
} >"$update"

smartdns="$work/90-routepolicy.conf"
rp_render_smartdns90 "$smartdns" "$RP_LOCAL_HOSTS"

mv -f "$full" "$RP_NFT_FILE"
mv -f "$update" "$RP_RUN_DIR/update.nft"
mv -f "$smartdns" "$RP_RUN_DIR/90-routepolicy.conf"

if [ "${ROUTEPOLICY_OUTPUT:-text}" = json ]; then
	printf '{"ok":true,"operation":"render","nft":"%s","smartdns":"%s"}\n' "$(rp_json_escape "$RP_NFT_FILE")" "$(rp_json_escape "$RP_RUN_DIR/90-routepolicy.conf")"
else
	printf 'nft: %s\nSmartDNS: %s\n' "$RP_NFT_FILE" "$RP_RUN_DIR/90-routepolicy.conf"
fi
