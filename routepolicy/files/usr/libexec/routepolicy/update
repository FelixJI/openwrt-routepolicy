#!/bin/sh

set -u
LIBEXEC=${ROUTEPOLICY_LIBEXEC:-$(dirname "$0")}
. "$LIBEXEC/common"
[ "$#" = 0 ] || { [ "$#" = 1 ] && { [ "$1" = scheduled ] || [ "$1" = init-stage ]; }; } || { rp_output_error update '更新参数非法'; exit 1; }
rp_writer_enter update || { rp_output_error update '写入门禁忙或初始化尚未完成'; exit 1; }
init_stage=0
if [ "${1:-}" = init-stage ]; then
	init_wal="$RP_STATE_DIR/init-transaction/current"
	[ "${ROUTEPOLICY_WRITER_KIND:-}" = init ] && rp_writer_owned &&
		[ -n "${ROUTEPOLICY_INIT_GENERATION:-}" ] && [ "$(cat "$init_wal/token" 2>/dev/null)" = "$ROUTEPOLICY_INIT_GENERATION" ] &&
		[ "$(cat "$init_wal/phase" 2>/dev/null)" = applying ] && [ "$(cat "$init_wal/managed-phase" 2>/dev/null)" = prepared ] || { rp_output_error update 'init-stage 仅接受真实初始化 writer、当前 token 与写前快照'; exit 1; }
	init_stage=1
fi

if [ "${1:-}" = scheduled ]; then
	# Recheck and consume the daily attempt only after acquiring the shared writer gate.
	[ "$(rp_uci_get main enabled 0)" = 1 ] && [ "$(rp_uci_get main auto_update 1)" = 1 ] || exit 0
	now_date=$(date +%Y-%m-%d)
	now_hour=$(date +%H | sed 's/^0//'); [ -n "$now_hour" ] || now_hour=0
	now_minute=$(date +%M | sed 's/^0//'); [ -n "$now_minute" ] || now_minute=0
	target_hour=$(rp_uci_get main update_hour 4)
	target_minute=$(rp_uci_get main update_minute 17)
	last_date=; [ ! -f "$RP_STATE_DIR/last-update-attempt-day" ] || last_date=$(sed -n '1p' "$RP_STATE_DIR/last-update-attempt-day")
	rp_schedule_due "$now_date" "$now_hour" "$now_minute" "$target_hour" "$target_minute" "$last_date" || exit 0
	attempt="$RP_STATE_DIR/.last-update-attempt-day.$$"
	printf '%s\n' "$now_date" >"$attempt" && mv -f "$attempt" "$RP_STATE_DIR/last-update-attempt-day" || { rp_output_error update '不能记录定时更新尝试'; exit 1; }
fi

validation=$(ROUTEPOLICY_OUTPUT=text "$LIBEXEC/validate" 2>&1)
if [ "$?" -ne 0 ]; then rp_output_error update "更新前校验失败: $validation"; exit 1; fi
rp_have curl || { rp_output_error update '缺少 curl'; exit 1; }
rp_ensure_dirs
lock="$RP_RUN_DIR/update.lock"
rp_local_lock "$lock" || { rp_output_error update '另一个更新操作正在进行'; exit 1; }
candidate=$(mktemp -d "$RP_ETC/managed.d/candidate.XXXXXX") || { rp_local_unlock "$lock"; exit 1; }
work=$(mktemp -d "$RP_RUN_DIR/update.XXXXXX") || { rm -rf "$candidate"; rp_local_unlock "$lock"; exit 1; }
cleanup() { rm -rf "$work"; [ ! -d "$candidate" ] || rm -rf "$candidate"; rp_local_unlock "$lock"; }
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

sections=$(rp_source_sections)
[ -n "$sections" ] || { rp_output_error update '没有配置清单来源'; exit 1; }
updated=0
for section in $sections; do
	[ "$(rp_uci_get "$section" enabled 0)" = 1 ] || continue
	url=$(rp_uci_get "$section" url '')
	format=$(rp_uci_get "$section" format '')
	target=$(rp_uci_get "$section" target '')
	minimum=$(rp_uci_get "$section" min_entries 1)
	shrink=$(rp_uci_get "$section" max_shrink_percent 50)
	raw="$work/$section.download"
	out="$candidate/$section.$target.list"
	set -- --fail --silent --show-error --location --max-redirs 3 --connect-timeout 15 --max-time 120 --proto '=https' --tlsv1.2 --output "$raw"
	via_policy=$(rp_uci_get "$section" update_via_policy_interface "$(rp_uci_get main update_via_policy_interface 1)")
	if [ "$via_policy" = 1 ]; then
		policy_if=$(rp_uci_get main policy_interface usbwan)
		device=$(rp_interface_device "$policy_if" 2>/dev/null) || device=
		if ! rp_interface_up "$policy_if" || ! rp_is_device "$device"; then
			rp_output_error update "来源 $section 要求策略接口更新，但接口不在线"
			exit 1
		fi
		set -- "$@" --interface "if!$device"
	fi
	if ! curl "$@" "$url" >"$work/$section.curl.log" 2>&1; then
		rp_output_error update "来源 $section 下载失败"
		exit 1
	fi
	if ! "$LIBEXEC/converters/$format" "$raw" >"$out" 2>"$work/$section.convert.log"; then
		rp_output_error update "来源 $section 转换失败（空文件、HTML 或无有效条目）"
		exit 1
	fi
	count=$(rp_list_count "$out")
	if [ "$count" -lt "$minimum" ]; then
		rp_output_error update "来源 $section 仅 $count 条，低于最低值 $minimum"
		exit 1
	fi
	old="$RP_MANAGED_CURRENT/$section.$target.list"
	if [ -f "$old" ]; then
		old_count=$(rp_list_count "$old")
		if [ "$old_count" -gt 0 ] && [ $((count * 100)) -lt $((old_count * (100 - shrink))) ]; then
			rp_output_error update "来源 $section 数量从 $old_count 降至 $count，超过最大缩减比例"
			exit 1
		fi
	fi
	updated=$((updated + 1))
done
[ "$updated" -gt 0 ] || { rp_output_error update '没有启用的清单来源'; exit 1; }

next_previous="$RP_ETC/managed.d/previous.next.$$"
[ ! -e "$next_previous" ] || { rp_output_error update '内部候选目录冲突'; exit 1; }
if [ "$init_stage" = 1 ]; then
	[ ! -e "$init_wal/managed-expected" ] && [ ! -L "$init_wal/managed-expected" ] &&
		cp -pR "$candidate" "$init_wal/managed-expected" && printf '%s\n' "${next_previous##*/}" >"$init_wal/managed-swap-name" &&
		rp_managed_phase "$init_wal" publishing || { rp_output_error update '不能持久化初始化清单发布意图'; exit 1; }
	rp_managed_equal "$RP_MANAGED_CURRENT" "$init_wal/managed-before-current" && rp_managed_equal "$RP_MANAGED_PREVIOUS" "$init_wal/managed-before-previous" || { rp_output_error update '静态清单在发布前被外部修改；未覆盖'; exit 1; }
fi
mv "$RP_MANAGED_CURRENT" "$next_previous" || exit 1
mv "$candidate" "$RP_MANAGED_CURRENT" || { mv "$next_previous" "$RP_MANAGED_CURRENT"; exit 1; }
candidate=

if [ "$init_stage" != 1 ] && [ "$(rp_uci_get main enabled 0)" = 1 ]; then
	if ! ROUTEPOLICY_OUTPUT=text "$LIBEXEC/apply" >"$work/apply.log" 2>&1; then
		failed_current="$RP_ETC/managed.d/failed.$$.tmp"
		mv "$RP_MANAGED_CURRENT" "$failed_current"
		mv "$next_previous" "$RP_MANAGED_CURRENT"
		ROUTEPOLICY_OUTPUT=text "$LIBEXEC/apply" >/dev/null 2>&1 || true
		rm -rf "$failed_current"
		printf '%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ) update apply failed" >"$RP_STATE_DIR/last-error"
		rp_output_error update "新清单应用失败，已恢复原 current: $(tr '\n' ';' <"$work/apply.log")"
		exit 1
	fi
fi
if [ "$init_stage" = 1 ]; then
	rp_managed_equal "$RP_MANAGED_PREVIOUS" "$init_wal/managed-before-previous" || { rp_output_error update 'previous 出现外部修改；保留恢复证据'; exit 1; }
fi
rm -rf "$RP_MANAGED_PREVIOUS" && mv "$next_previous" "$RP_MANAGED_PREVIOUS" || { rp_output_error update 'previous 发布中断；保留恢复证据'; exit 1; }
[ "$init_stage" != 1 ] || rp_managed_phase "$init_wal" published || { rp_output_error update '初始化清单发布尚未收敛'; exit 1; }
date -u +%Y-%m-%dT%H:%M:%SZ >"$RP_STATE_DIR/last-update"
rp_output_ok update "已更新 $updated 个来源并保留 previous"
