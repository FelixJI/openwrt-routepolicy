#!/bin/sh

set -u
LIBEXEC=${ROUTEPOLICY_LIBEXEC:-$(dirname "$0")}
. "$LIBEXEC/common"

validation=$(ROUTEPOLICY_OUTPUT=text "$LIBEXEC/validate" 2>&1)
if [ "$?" -ne 0 ]; then rp_output_error update "更新前校验失败: $validation"; exit 1; fi
rp_have curl || { rp_output_error update '缺少 curl'; exit 1; }
rp_ensure_dirs
lock="$RP_RUN_DIR/update.lock"
mkdir "$lock" 2>/dev/null || { rp_output_error update '另一个更新操作正在进行'; exit 1; }
candidate=$(mktemp -d "$RP_ETC/managed.d/candidate.XXXXXX") || { rmdir "$lock"; exit 1; }
work=$(mktemp -d "$RP_RUN_DIR/update.XXXXXX") || { rm -rf "$candidate"; rmdir "$lock"; exit 1; }
cleanup() { rm -rf "$work"; [ ! -d "$candidate" ] || rm -rf "$candidate"; rmdir "$lock" 2>/dev/null || true; }
trap cleanup EXIT HUP INT TERM

sections=$(rp_source_sections)
[ -n "$sections" ] || { rp_output_error update '没有配置清单来源'; exit 1; }
updated=0
for section in $sections; do
	[ "$(rp_uci_get "$section" enabled 0)" = 1 ] || continue
	url=$(rp_uci_get "$section" url '')
	format=$(rp_uci_get "$section" format '')
	target=$(rp_uci_get "$section" target '')
	minimum=$(rp_uci_get "$section" min_entries 1)
	shrink=$(rp_uci_get "$section" max_shrink_percent 50)
	raw="$work/$section.download"
	out="$candidate/$section.$target.list"
	set -- --fail --silent --show-error --location --max-redirs 3 --connect-timeout 15 --max-time 120 --proto '=https' --tlsv1.2 --output "$raw"
	via_policy=$(rp_uci_get "$section" update_via_policy_interface "$(rp_uci_get main update_via_policy_interface 1)")
	if [ "$via_policy" = 1 ]; then
		policy_if=$(rp_uci_get main policy_interface usbwan)
		device=$(rp_interface_device "$policy_if" 2>/dev/null) || device=
		if ! rp_interface_up "$policy_if" || ! rp_is_device "$device"; then
			rp_output_error update "来源 $section 要求策略接口更新，但接口不在线"
			exit 1
		fi
		set -- "$@" --interface "if!$device"
	fi
	if ! curl "$@" "$url" >"$work/$section.curl.log" 2>&1; then
		rp_output_error update "来源 $section 下载失败"
		exit 1
	fi
	if ! "$LIBEXEC/converters/$format" "$raw" >"$out" 2>"$work/$section.convert.log"; then
		rp_output_error update "来源 $section 转换失败（空文件、HTML 或无有效条目）"
		exit 1
	fi
	count=$(rp_list_count "$out")
	if [ "$count" -lt "$minimum" ]; then
		rp_output_error update "来源 $section 仅 $count 条，低于最低值 $minimum"
		exit 1
	fi
	old="$RP_MANAGED_CURRENT/$section.$target.list"
	if [ -f "$old" ]; then
		old_count=$(rp_list_count "$old")
		if [ "$old_count" -gt 0 ] && [ $((count * 100)) -lt $((old_count * (100 - shrink))) ]; then
			rp_output_error update "来源 $section 数量从 $old_count 降至 $count，超过最大缩减比例"
			exit 1
		fi
	fi
	updated=$((updated + 1))
done
[ "$updated" -gt 0 ] || { rp_output_error update '没有启用的清单来源'; exit 1; }

next_previous="$RP_ETC/managed.d/previous.next.$$"
[ ! -e "$next_previous" ] || { rp_output_error update '内部候选目录冲突'; exit 1; }
mv "$RP_MANAGED_CURRENT" "$next_previous" || exit 1
mv "$candidate" "$RP_MANAGED_CURRENT" || { mv "$next_previous" "$RP_MANAGED_CURRENT"; exit 1; }
candidate=

if [ "$(rp_uci_get main enabled 0)" = 1 ]; then
	if ! ROUTEPOLICY_OUTPUT=text "$LIBEXEC/apply" >"$work/apply.log" 2>&1; then
		failed_current="$RP_ETC/managed.d/failed.$$.tmp"
		mv "$RP_MANAGED_CURRENT" "$failed_current"
		mv "$next_previous" "$RP_MANAGED_CURRENT"
		ROUTEPOLICY_OUTPUT=text "$LIBEXEC/apply" >/dev/null 2>&1 || true
		rm -rf "$failed_current"
		printf '%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ) update apply failed" >"$RP_STATE_DIR/last-error"
		rp_output_error update "新清单应用失败，已恢复原 current: $(tr '\n' ';' <"$work/apply.log")"
		exit 1
	fi
fi
rm -rf "$RP_MANAGED_PREVIOUS"
mv "$next_previous" "$RP_MANAGED_PREVIOUS"
date -u +%Y-%m-%dT%H:%M:%SZ >"$RP_STATE_DIR/last-update"
rp_output_ok update "已更新 $updated 个来源并保留 previous"
