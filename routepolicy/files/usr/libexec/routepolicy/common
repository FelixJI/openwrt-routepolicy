#!/bin/sh
# Shared constants are consumed by scripts that source this file.
# shellcheck disable=SC2034

# Shared, side-effect-free helpers. Do not enable errexit here: callers decide.
RP_ROOT=${ROUTEPOLICY_ROOT:-}
RP_ETC="$RP_ROOT/etc/routepolicy"
RP_UCI_CONFIG="$RP_ROOT/etc/config/routepolicy"
RP_USER_DIR="$RP_ETC/user.d"
RP_MANAGED_CURRENT="$RP_ETC/managed.d/current"
RP_MANAGED_PREVIOUS="$RP_ETC/managed.d/previous"
RP_STATE_DIR="$RP_ETC/state"
RP_RUN_DIR="$RP_ROOT/tmp/routepolicy"
RP_ACTIVE_DIR="$RP_RUN_DIR/active"
RP_NFT_FILE="$RP_RUN_DIR/rules.nft"
RP_SMARTDNS_FILE="$RP_ROOT/etc/smartdns/conf.d/90-routepolicy.conf"
RP_SMARTDNS_EXTRA_FILE="$RP_ROOT/etc/smartdns/conf.d/91-routepolicy-smartdns-extra.conf"
RP_SMARTDNS_GENERATED="$RP_ROOT/var/etc/smartdns/smartdns.conf"
RP_SMARTDNS_UCI="$RP_ROOT/etc/config/smartdns"
RP_SMARTDNS_CANDIDATE="$RP_RUN_DIR/smartdns-candidate.tsv"
RP_SMARTDNS_BASELINE="$RP_STATE_DIR/smartdns-baseline.uci"
RP_SMARTDNS_BASELINE_VERSION="$RP_STATE_DIR/smartdns-baseline.version"
RP_SMARTDNS_APPLIED="$RP_STATE_DIR/smartdns-applied.uci"
RP_LOCAL_HOSTS="$RP_USER_DIR/local-hosts.list"
RP_LOCAL_HOSTS_CANDIDATE="$RP_RUN_DIR/local-hosts-candidate.list"
RP_TABLE_FAMILY=inet
RP_TABLE_NAME=routepolicy
RP_SCHEMA_VERSION=1

rp_err() { printf '%s\n' "routepolicy: $*" >&2; }
rp_die() { rp_err "$*"; exit 1; }

rp_have() { command -v "$1" >/dev/null 2>&1; }

rp_uci_get() {
	section=$1
	option=$2
	default=${3-}
	value=$(uci -q get "routepolicy.$section.$option" 2>/dev/null) || value=$default
	[ -n "$value" ] || value=$default
	printf '%s\n' "$value"
}

rp_uci_config_get() {
	config=$1 section=$2 option=$3 default=${4-}
	value=$(uci -q get "$config.$section.$option" 2>/dev/null) || value=$default
	[ -n "$value" ] || value=$default
	printf '%s\n' "$value"
}

rp_smartdns_root_sections() {
	uci -q show smartdns 2>/dev/null |
		sed -n \
			-e 's/^smartdns\.\([A-Za-z0-9_][A-Za-z0-9_]*\)=smartdns$/\1/p' \
			-e 's/^smartdns\.\(@smartdns\[[0-9][0-9]*\]\)=smartdns$/\1/p'
}

rp_smartdns_server_sections() {
	uci -q show smartdns 2>/dev/null |
		sed -n \
			-e 's/^smartdns\.\([A-Za-z0-9_][A-Za-z0-9_]*\)=server$/\1/p' \
			-e 's/^smartdns\.\(@server\[[0-9][0-9]*\]\)=server$/\1/p'
}

rp_is_smartdns_server_ref() {
	value=${1-}
	[ -n "$value" ] && [ "${#value}" -le 64 ] || return 1
	if printf '%s\n' "$value" | LC_ALL=C grep -Eq '^[A-Za-z0-9_]+$'; then
		return 0
	fi
	printf '%s\n' "$value" | LC_ALL=C grep -Eq '^@server\[[0-9]+\]$'
}

# Decode libuci's quoted export without evaluating configuration as shell code.
# Lists use | internally; ambiguous/control-containing values fail before any write.
rp_uci_field_data() {
	awk -v section="$1" -v option="$2" '
		function unquote(s, out,i,c) {
			if(substr(s,1,1)!=q || substr(s,length(s),1)!=q){bad=1;return ""}
			s=substr(s,2,length(s)-2);out=""
			for(i=1;i<=length(s);i++) {
				c=substr(s,i,1)
				if(c==q) {if(substr(s,i,4)!=q "\\" q q){bad=1;return ""}i+=3}
				out=out c
			}
			if(out~/[[:cntrl:]|]/){bad=1;return ""}return out
		}
		BEGIN{q=sprintf("%c",39)}
		$1=="config" {
			type=$2;gsub(q,"",type);name=$3;gsub(q,"",name)
			ref="@" type "[" count[type]++ "]";selected=(section==name||section==ref)
		}
		selected && ($1=="option"||$1=="list") {
			name=$2;gsub(q,"",name);if(name!=option)next
			line=$0;sub(/^[[:space:]]*[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+/,"",line)
			value=unquote(line)
			if(n && (kind!="list"||$1!="list"))bad=1
			data=data (n?"|":"") value;kind=$1;n++
		}
		END{if(bad||!n||length(data)>4096)exit 1;print (kind=="list"?"list":"scalar") "\t" data}'
}

# Rebuild rules atomically while retaining the two DNS producer set objects.
# Their live members and kernel expiry times survive concurrent DNS answers.
rp_nft_rebuild() {
	nft_source=$1 nft_target=$2
	for nft_name in domain_policy4 domain_default4; do
		nft_schema=$(nft list set inet routepolicy "$nft_name") || return 1
		printf '%s\n' "$nft_schema" | grep -Eq 'type ipv4_addr([ ;]|$)' &&
			printf '%s\n' "$nft_schema" | grep -Eq 'flags timeout([ ;]|$)|^[[:space:]]*timeout [1-9][0-9]*(ms|[smhd])' || return 1
	done
	: >"$nft_target" || return 1
	for nft_name in prerouting dns_prerouting output classify source_prerouting source_postrouting; do
		if nft list chain inet routepolicy "$nft_name" >/dev/null 2>&1; then
			printf 'flush chain inet routepolicy %s\n' "$nft_name" >>"$nft_target" || return 1
		fi
	done
	for nft_name in prerouting dns_prerouting output classify source_prerouting source_postrouting; do
		if nft list chain inet routepolicy "$nft_name" >/dev/null 2>&1; then
			printf 'delete chain inet routepolicy %s\n' "$nft_name" >>"$nft_target" || return 1
		fi
	done
	for nft_name in static_policy4 static_default4 source_ingress4 source_egress4; do
		if nft list set inet routepolicy "$nft_name" >/dev/null 2>&1; then
			printf 'delete set inet routepolicy %s\n' "$nft_name" >>"$nft_target" || return 1
		fi
	done
	awk '
		BEGIN {chains=" prerouting dns_prerouting output classify source_prerouting source_postrouting ";sets=" static_policy4 static_default4 source_ingress4 source_egress4 "}
		depth==1 && NF && $1 !~ /^[}#]/ {
			keep=($1=="chain"&&index(chains," " $2 " "))||($1=="set"&&index(sets," " $2 " "))
			object=1
		}
		{line=$0;depth+=gsub(/\{/,"",line)-gsub(/}/,"",line);if(!object||keep)print;if(depth==1)object=0;if(depth<0)bad=1}
		END{if(depth||bad)exit 1}' "$nft_source" >>"$nft_target"
}

rp_smartdns_fragment_loaded() {
	fragment=$1
	configured_fragment=${fragment#"$RP_ROOT"}
	[ -f "$RP_SMARTDNS_GENERATED" ] && [ ! -L "$RP_SMARTDNS_GENERATED" ] || return 1
	awk -v wanted="$configured_fragment" '
		$1 == "conf-file" || $1 == "conf_file" { path=$2; q=sprintf("%c",39); if(substr(path,1,1)==q&&substr(path,length(path),1)==q)path=substr(path,2,length(path)-2); if (path == wanted) found=1 }
		$1 == "conf-file=" wanted || $1 == "conf_file=" wanted { found=1 }
		END { exit !found }
	' "$RP_SMARTDNS_GENERATED"
}

rp_smartdns_single_root() {
	roots=$(rp_smartdns_root_sections)
	count=$(printf '%s\n' "$roots" | awk 'NF{n++}END{print n+0}')
	[ "$count" -eq 1 ] || return 1
	printf '%s\n' "$roots" | sed -n '1p'
}

rp_smartdns_set_registration() {
	fragment=$1 wanted=$2
	root=$(rp_smartdns_single_root) || return 1
	configured_fragment=${fragment#"$RP_ROOT"}
	uci -q del_list "smartdns.$root.conf_files=$configured_fragment" >/dev/null 2>&1 || true
	if [ "$wanted" = 1 ]; then
		uci -q add_list "smartdns.$root.conf_files=$configured_fragment" >/dev/null 2>&1 || return 1
	fi
	uci commit smartdns >/dev/null 2>&1
}

rp_is_bool() { case ${1-} in 0|1) return 0 ;; *) return 1 ;; esac; }
rp_is_uint() { case ${1-} in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac; }
rp_uint_between() {
	rp_is_uint "$1" || return 1
	[ "$1" -ge "$2" ] 2>/dev/null && [ "$1" -le "$3" ] 2>/dev/null
}
rp_is_name() {
	value=${1-}
	[ -n "$value" ] && [ "${#value}" -le "${2:-32}" ] || return 1
	case "$value" in *[!A-Za-z0-9_.-]*) return 1 ;; esac
	case "$value" in -*|.*|*..*) return 1 ;; esac
	return 0
}
rp_is_group() { rp_is_name "$1" 64; }
rp_is_device() {
	value=${1-}
	[ -n "$value" ] && [ "${#value}" -le 32 ] || return 1
	case "$value" in *[!A-Za-z0-9_.:@-]*) return 1 ;; esac
	return 0
}
rp_is_ipv4() {
	printf '%s\n' "$1" | awk -F. '
		NF != 4 { exit 1 }
		{ for (i=1;i<=4;i++) if ($i !~ /^[0-9]+$/ || $i < 0 || $i > 255) exit 1 }
	' >/dev/null 2>&1
}
rp_network_cidr() {
	address=$1 prefix=$2
	rp_is_ipv4 "$address" && rp_uint_between "$prefix" 0 32 || return 1
	awk -v ip="$address" -v p="$prefix" '
		function text(v,a,b,c,d){a=int(v/16777216);v-=a*16777216;b=int(v/65536);v-=b*65536;c=int(v/256);d=v-c*256;return a"."b"."c"."d}
		BEGIN{split(ip,x,".");v=((x[1]*256+x[2])*256+x[3])*256+x[4];block=2^(32-p);print text(int(v/block)*block) "/" p}'
}
rp_is_hex32() {
	case ${1-} in 0x[0-9A-Fa-f]*) ;; *) return 1 ;; esac
	[ "${#1}" -le 10 ] || return 1
	case ${1#0x} in ''|*[!0-9A-Fa-f]*) return 1 ;; esac
	return 0
}
rp_hex_decimal() { printf '%u\n' "$(( $1 ))"; }
rp_hex8() { printf '0x%08x\n' "$(( $1 ))"; }
rp_inverse_mask() { printf '0x%08x\n' "$(( 0xffffffff ^ $1 ))"; }
rp_is_mark_bit() {
	rp_is_hex32 "$1" || return 1
	n=$(rp_hex_decimal "$1") || return 1
	[ "$n" -gt 0 ] && [ "$n" -le 2147483648 ] || return 1
	[ $(( n & (n - 1) )) -eq 0 ]
}
rp_is_https_url() {
	url=${1-}
	[ -n "$url" ] && [ "${#url}" -le 2048 ] || return 1
	case "$url" in https://*) ;; *) return 1 ;; esac
	case "$url" in *[[:space:]]*) return 1 ;; esac
	# C locale: reject every byte outside visible ASCII, including all whitespace
	# and control characters. The bracket expression is POSIX-sh parse-safe.
	if printf '%s' "$url" | LC_ALL=C grep -q '[^!-~]'; then return 1; fi
	return 0
}
rp_json_escape() {
	# Values passed here are already length-limited configuration/status fields.
	printf '%s' "$1" |
		sed 's/\\/\\\\/g; s/"/\\"/g; s/	/\\t/g; s//\\r/g' |
		awk 'NR > 1 { printf "\\n" } { printf "%s", $0 }'
}

rp_source_sections() {
	uci -q show routepolicy 2>/dev/null |
		sed -n 's/^routepolicy\.\([A-Za-z0-9_][A-Za-z0-9_]*\)=source$/\1/p'
}

rp_interface_json() {
	iface=$1
	rp_is_name "$iface" 32 || return 1
	ubus call "network.interface.$iface" status 2>/dev/null
}
rp_interface_device() {
	rp_interface_json "$1" | jsonfilter -e '@.l3_device' 2>/dev/null | sed -n '1p'
}
rp_interface_gateway() {
	rp_interface_json "$1" | jsonfilter -e '@.route[@.target="0.0.0.0"].nexthop' 2>/dev/null | sed -n '1p'
}
rp_interface_address() {
	rp_interface_json "$1" | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null | sed -n '1p'
}
rp_interface_prefix() {
	rp_interface_json "$1" | jsonfilter -e '@["ipv4-address"][0].mask' 2>/dev/null | sed -n '1p'
}
rp_interface_up() {
	value=$(rp_interface_json "$1" | jsonfilter -e '@.up' 2>/dev/null | sed -n '1p') || return 1
	[ "$value" = true ] || [ "$value" = 1 ]
}

rp_managed_device_signature() {
	for managed_interface in \
		"$(rp_uci_get main lan_interface lan)" \
		"$(rp_uci_get main default_interface wan)" \
		"$(rp_uci_get main policy_interface usbwan)"; do
		managed_device=$(rp_interface_device "$managed_interface" 2>/dev/null) || managed_device=
		rp_is_device "$managed_device" || continue
		printf '%s\n' "$managed_device"
	done | LC_ALL=C sort -u | awk 'BEGIN{first=1} NF{if(!first)printf ",";printf "%s",$0;first=0} END{print ""}'
}

rp_schedule_due() {
	now_date=$1 now_hour=$2 now_minute=$3 target_hour=$4 target_minute=$5 last_date=${6-}
	case "$now_date" in ????-??-??) ;; *) return 1 ;; esac
	rp_uint_between "$now_hour" 0 23 && rp_uint_between "$now_minute" 0 59 || return 1
	rp_uint_between "$target_hour" 0 23 && rp_uint_between "$target_minute" 0 59 || return 1
	[ "$now_date" != "$last_date" ] || return 1
	[ $((now_hour * 60 + now_minute)) -ge $((target_hour * 60 + target_minute)) ]
}

rp_state_get() {
	key=$1
	[ -f "$RP_STATE_DIR/applied" ] && [ ! -L "$RP_STATE_DIR/applied" ] || return 1
	sed -n "s/^$key=//p" "$RP_STATE_DIR/applied" | sed -n '1p'
}

rp_mark_conflicts() {
	ours_mark=$1 ours_mask=$2 ours_priority=$3 ours_table=$4
	previous_mark=${5-} previous_mask=${6-} previous_priority=${7-} previous_table=${8-}
	rp_is_hex32 "$ours_mark" && rp_is_hex32 "$ours_mask" && rp_is_uint "$ours_priority" && rp_is_uint "$ours_table" || return 0
	ours_mark_n=$((ours_mark)); ours_mask_n=$((ours_mask))
	ip -4 rule show 2>/dev/null | while IFS= read -r line; do
		token=$(printf '%s\n' "$line" | awk '{for(i=1;i<=NF;i++)if($i=="fwmark"){print $(i+1);exit}}')
		[ -n "$token" ] || continue
		other_mark=${token%%/*}; [ "$other_mark" != "$token" ] && other_mask=${token#*/} || other_mask=0xffffffff
		case "$other_mark:$other_mask" in 0x[0-9A-Fa-f]*:0x[0-9A-Fa-f]*) ;; *) continue ;; esac
		other_mark_n=$((other_mark)); other_mask_n=$((other_mask))
		[ $((other_mask_n & ours_mask_n)) -ne 0 ] || continue
		priority_token=$(printf '%s\n' "$line" | awk '{print $1}')
		lookup=$(printf '%s\n' "$line" | awk '{for(i=1;i<NF;i++)if($i=="lookup"||$i=="table"){print $(i+1);exit}}')
		if [ "$priority_token" = "$ours_priority:" ] && [ "$other_mark_n" -eq "$ours_mark_n" ] && [ "$other_mask_n" -eq "$ours_mask_n" ] && [ "$lookup" = "$ours_table" ]; then continue; fi
		if [ -n "$previous_mark" ] && [ "$priority_token" = "$previous_priority:" ] && [ "$other_mark_n" -eq $((previous_mark)) ] && [ "$other_mask_n" -eq $((previous_mask)) ] && [ "$lookup" = "$previous_table" ]; then continue; fi
		printf '%s\n' "$line"
	done
}

rp_validate_main() {
	main_errors=0
	for command_name in uci ubus jsonfilter nft ip; do
		rp_have "$command_name" || { rp_err "缺少命令: $command_name"; main_errors=$((main_errors + 1)); }
	done
	for field in enabled strict_enforcement dns_redirect warm_restore smartdns_enabled auto_update update_via_policy_interface; do
		value=$(rp_uci_get main "$field" '')
		rp_is_bool "$value" || { rp_err "main.$field 必须为 0 或 1"; main_errors=$((main_errors + 1)); }
	done
	route_local_traffic=$(rp_uci_get main route_local_traffic 0)
	rp_is_bool "$route_local_traffic" || { rp_err 'main.route_local_traffic 必须为 0 或 1'; main_errors=$((main_errors + 1)); }
	source_accounting=$(rp_uci_get main source_accounting 0)
	rp_is_bool "$source_accounting" || { rp_err 'main.source_accounting 必须为 0 或 1'; main_errors=$((main_errors + 1)); }
	source_idle_timeout=$(rp_uci_get main source_idle_timeout 600)
	rp_uint_between "$source_idle_timeout" 60 86400 || { rp_err 'main.source_idle_timeout 必须在 60..86400'; main_errors=$((main_errors + 1)); }
	source_max_entries=$(rp_uci_get main source_max_entries 4096)
	rp_uint_between "$source_max_entries" 256 16384 || { rp_err 'main.source_max_entries 必须在 256..16384'; main_errors=$((main_errors + 1)); }
	for field in lan_interface default_interface policy_interface; do
		value=$(rp_uci_get main "$field" '')
		rp_is_name "$value" 32 || { rp_err "main.$field 不是合法逻辑接口名"; main_errors=$((main_errors + 1)); }
	done
	table=$(rp_uci_get main route_table '')
	rp_uint_between "$table" 1 252 || { rp_err 'main.route_table 必须在 1..252'; main_errors=$((main_errors + 1)); }
	priority=$(rp_uci_get main rule_priority '')
	rp_uint_between "$priority" 1 32765 || { rp_err 'main.rule_priority 必须在 1..32765'; main_errors=$((main_errors + 1)); }
	mark=$(rp_uci_get main mark '')
	mask=$(rp_uci_get main mark_mask '')
	rp_is_mark_bit "$mark" || { rp_err 'main.mark 必须是 32 位范围内的单一非零 bit'; main_errors=$((main_errors + 1)); }
	rp_is_mark_bit "$mask" || { rp_err 'main.mark_mask 必须是 32 位范围内的单一非零 bit'; main_errors=$((main_errors + 1)); }
	[ "$mark" = "$mask" ] || { rp_err 'main.mark 与 main.mark_mask 必须表示同一 bit'; main_errors=$((main_errors + 1)); }
	group=$(rp_uci_get main smartdns_policy_group '')
	rp_is_group "$group" || { rp_err 'main.smartdns_policy_group 非法'; main_errors=$((main_errors + 1)); }
	hour=$(rp_uci_get main update_hour '')
	minute=$(rp_uci_get main update_minute '')
	rp_uint_between "$hour" 0 23 || { rp_err 'main.update_hour 必须在 0..23'; main_errors=$((main_errors + 1)); }
	rp_uint_between "$minute" 0 59 || { rp_err 'main.update_minute 必须在 0..59'; main_errors=$((main_errors + 1)); }
	[ "$main_errors" -eq 0 ]
}

rp_validate_sources() {
	source_errors=0
	for section in $(rp_source_sections); do
		rp_is_name "$section" 32 || { rp_err "非法 source 节名: $section"; source_errors=$((source_errors + 1)); continue; }
		enabled=$(rp_uci_get "$section" enabled 0)
		rp_is_bool "$enabled" || { rp_err "$section.enabled 必须为 0 或 1"; source_errors=$((source_errors + 1)); }
		[ "$enabled" = 1 ] || continue
		url=$(rp_uci_get "$section" url '')
		rp_is_https_url "$url" || { rp_err "$section.url 必须是长度受限、无空白的 HTTPS URL"; source_errors=$((source_errors + 1)); }
		format=$(rp_uci_get "$section" format '')
		case "$format" in plain-domain|plain-ipv4|hosts-domain|adblock-domain|dnsmasq-domain|clash-domain|clash-ipv4) ;; *) rp_err "$section.format 不受支持"; source_errors=$((source_errors + 1)) ;; esac
		target=$(rp_uci_get "$section" target '')
		case "$target" in domain-policy|domain-default|ipv4-policy|ipv4-default) ;; *) rp_err "$section.target 不受支持"; source_errors=$((source_errors + 1)) ;; esac
		case "$format:$target" in *domain:domain-*|*ipv4:ipv4-*) ;; *) rp_err "$section.format 与 target 类型不一致"; source_errors=$((source_errors + 1)) ;; esac
		minimum=$(rp_uci_get "$section" min_entries 1)
		shrink=$(rp_uci_get "$section" max_shrink_percent 50)
		rp_uint_between "$minimum" 1 10000000 || { rp_err "$section.min_entries 必须在 1..10000000"; source_errors=$((source_errors + 1)); }
		rp_uint_between "$shrink" 0 100 || { rp_err "$section.max_shrink_percent 必须在 0..100"; source_errors=$((source_errors + 1)); }
		via=$(rp_uci_get "$section" update_via_policy_interface "$(rp_uci_get main update_via_policy_interface 1)")
		rp_is_bool "$via" || { rp_err "$section.update_via_policy_interface 必须为 0 或 1"; source_errors=$((source_errors + 1)); }
	done
	[ "$source_errors" -eq 0 ]
}

rp_ensure_dirs() {
	umask 077
	mkdir -p "$RP_USER_DIR" "$RP_MANAGED_CURRENT" "$RP_MANAGED_PREVIOUS" "$RP_STATE_DIR" "$RP_RUN_DIR/lists"
}

rp_merge_lists() {
	target=$1
	output=$2
	user="$RP_USER_DIR/$target.list"
	{
		[ -f "$user" ] && cat "$user"
		for file in "$RP_MANAGED_CURRENT"/*."$target".list; do
			[ -f "$file" ] && cat "$file"
		done
	} | sed '/^[[:space:]]*$/d' | LC_ALL=C sort -u >"$output"
}

rp_render_smartdns90() {
	smartdns_output=$1 smartdns_hosts_file=${2:-$RP_LOCAL_HOSTS}
	rp_ensure_dirs
	smartdns_work=$(mktemp -d "$RP_RUN_DIR/smartdns-render.XXXXXX") || return 1
	for name in domain-policy domain-default; do
		rp_merge_lists "$name" "$smartdns_work/$name.raw"
		if [ -s "$smartdns_work/$name.raw" ]; then
			"$LIBEXEC/converters/plain-domain" "$smartdns_work/$name.raw" >"$RP_RUN_DIR/lists/$name.list.new" || { rm -rf "$smartdns_work"; return 1; }
		else
			: >"$RP_RUN_DIR/lists/$name.list.new"
		fi
		mv -f "$RP_RUN_DIR/lists/$name.list.new" "$RP_RUN_DIR/lists/$name.list"
	done
	group=$(rp_uci_get main smartdns_policy_group policy)
	cat >"$smartdns_output" <<EOF
# Generated by routepolicy. Do not edit.
nftset-timeout yes
domain-set -name routepolicy_policy -type list -file /tmp/routepolicy/active/domain-policy.list
domain-set -name routepolicy_default -type list -file /tmp/routepolicy/active/domain-default.list
nftset /domain-set:routepolicy_policy/#4:inet#routepolicy#domain_policy4
nftset /domain-set:routepolicy_default/#4:inet#routepolicy#domain_default4
domain-rules /domain-set:routepolicy_policy/ -nameserver $group -speed-check-mode none
domain-rules /domain-set:routepolicy_default/ -speed-check-mode none
EOF
	if [ -s "$smartdns_hosts_file" ] && [ ! -L "$smartdns_hosts_file" ]; then
		cat >>"$smartdns_output" <<'EOF'
hosts-file /etc/routepolicy/user.d/local-hosts.list
expand-ptr-from-address yes
EOF
		awk 'NF >= 2 && $0 !~ /^[[:space:]]*[#;]/ { printf "address /%s/%s\n", $2, $1 }' "$smartdns_hosts_file" >>"$smartdns_output"
		printf '%s\n' 'expand-ptr-from-address no' >>"$smartdns_output"
	fi
	rm -rf "$smartdns_work"
}

rp_list_count() { awk 'NF && $0 !~ /^[[:space:]]*[#;]/ { n++ } END { print n+0 }' "$1"; }

rp_output_ok() {
	operation=$1
	message=$2
	if [ "${ROUTEPOLICY_OUTPUT:-text}" = json ]; then
		printf '{"ok":true,"operation":"%s","message":"%s"}\n' "$(rp_json_escape "$operation")" "$(rp_json_escape "$message")"
	else
		printf '%s\n' "$message"
	fi
}

rp_output_error() {
	operation=$1
	message=$2
	if [ "${ROUTEPOLICY_OUTPUT:-text}" = json ]; then
		printf '{"ok":false,"operation":"%s","error":"%s"}\n' "$(rp_json_escape "$operation")" "$(rp_json_escape "$message")"
	else
		rp_err "$message"
	fi
}

rp_smartdns_init_probes() {
	printf '%s\n' '# routepolicy initialization probes' \
		'domain-rules /routepolicy-init-default.test/ -nameserver rp_init_default -speed-check-mode none' \
		'domain-rules /routepolicy-init-policy.test/ -nameserver rp_init_policy -speed-check-mode none'
}

# A confirmed DNS contract survives replacement of the reviewable candidate WAL.
rp_init_confirmed_record() {
	case "$1" in active|source) ;; *) return 1 ;; esac
	active_tx="$RP_STATE_DIR/init-transaction"
	[ ! -L "$active_tx" ] && [ -f "$active_tx/$1" ] && [ ! -L "$active_tx/$1" ] || return 1
	active_token=$(cat "$active_tx/$1") || return 1
	[ "${#active_token}" = 32 ] || return 1
	case "$active_token" in *[!0-9a-f]*) return 1 ;; esac
	active_record="$active_tx/confirmed-$active_token"
	[ -d "$active_record" ] && [ ! -L "$active_record" ] && [ ! -L "$active_record/token" ] && [ ! -L "$active_record/phase" ] &&
		[ "$(cat "$active_record/token")" = "$active_token" ] && [ "$(cat "$active_record/phase")" = confirmed ] || return 1
	printf '%s\n' "$active_record"
}
rp_init_active_record() { rp_init_confirmed_record active; }
rp_init_source_record() { rp_init_confirmed_record source; }
rp_init_section_owned() (
	section_key=$1 section_type=$2
	section_active=$(rp_init_active_record) || section_active=
	section_source=$(rp_init_source_record) || section_source=
	for section_record in "$RP_STATE_DIR/init-transaction/current" "$section_active" "$section_source"; do
		[ -n "$section_record" ] && [ -d "$section_record" ] && [ ! -L "$section_record" ] || continue
		[ -f "$section_record/phase" ] && [ ! -L "$section_record/phase" ] || continue
		case "$(cat "$section_record/phase")" in
			pending|confirming|confirmed) ;;
			applying)
				# This existing stage follows all successful field commits, before the
				# real planner verifies the runtime. attempted alone precedes commit.
				[ -f "$section_record/stage" ] && [ ! -L "$section_record/stage" ] && [ "$(cat "$section_record/stage")" = runtime-verify ] || continue ;;
			*) continue ;;
		esac
		[ -f "$section_record/candidate" ] && [ ! -L "$section_record/candidate" ] && [ -d "$section_record/fields" ] && [ ! -L "$section_record/fields" ] || continue
		# Candidate rows locate entries only; actual applied field evidence authorizes them.
		section_entries=$(awk -F '\t' -v key="$section_key" -v type="$section_type" '$1=="set"&&$2==key&&$3==type{print NR}' "$section_record/candidate") || continue
		for section_index in $section_entries; do
			section_entry="$section_record/fields/$section_index"
			[ -d "$section_entry" ] && [ ! -L "$section_entry" ] || continue
			for section_file in key expected attempted; do
				[ -f "$section_entry/$section_file" ] && [ ! -L "$section_entry/$section_file" ] || continue 2
			done
			# base614 set entries were scalar but had no expected-type file. The
			# set candidate, actual attempted entry and trusted phase remain required.
			section_expected_type=scalar
			if [ -e "$section_entry/expected-type" ] || [ -L "$section_entry/expected-type" ]; then
				[ -f "$section_entry/expected-type" ] && [ ! -L "$section_entry/expected-type" ] || continue
				section_expected_type=$(cat "$section_entry/expected-type") || continue
			fi
			[ "$(cat "$section_entry/key")" = "$section_key" ] && [ "$(cat "$section_entry/expected")" = "$section_type" ] && [ "$section_expected_type" = scalar ] && exit 0
		done
	done
	exit 1
)

rp_dns_boot_pending() {
	[ -f "$RP_STATE_DIR/init-transaction/current/dns-boot-pending" ] && return 0
	active_pending=$(rp_init_active_record) || return 1
	[ -f "$active_pending/dns-boot-pending" ]
}

# One kernel gate covers initialization, candidate publication and runtime writers.
rp_process_start() {
	case "$1" in ''|*[!0-9]*) return 1 ;; esac
	rp_proc_stat=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
	printf '%s\n' "${rp_proc_stat##*) }" | awk '{if($20~/^[0-9]+$/)print $20;else exit 1}'
}
rp_writer_fd_locked() {
	[ ! -L "$RP_STATE_DIR/init-transaction/lock" ] || return 1
	[ "$(readlink "/proc/$1/fd/9" 2>/dev/null)" = "$RP_STATE_DIR/init-transaction/lock" ] || return 1
	awk '$1=="lock:"&&$3=="FLOCK"&&$5=="WRITE"{found=1}END{exit !found}' "/proc/$1/fdinfo/9" 2>/dev/null || return 1
	rp_fd_inode=$(awk '$1=="ino:"{print $2}' "/proc/$1/fdinfo/9") || return 1
	[ "$rp_fd_inode" = "$(ls -di "$RP_STATE_DIR/init-transaction/lock" | awk '{print $1}')" ]
}
rp_writer_owned() {
	case "${ROUTEPOLICY_WRITER_OWNER:-}" in *:*) ;; *) return 1 ;; esac
	rp_owner_pid=${ROUTEPOLICY_WRITER_OWNER%:*}; rp_owner_start=${ROUTEPOLICY_WRITER_OWNER#*:}
	[ "$(rp_process_start "$rp_owner_pid")" = "$rp_owner_start" ] &&
		rp_writer_fd_locked "$rp_owner_pid" && rp_writer_fd_locked "$$"
}
rp_local_lock() {
	rp_local_path=$1
	if ! mkdir "$rp_local_path" 2>/dev/null; then
		rp_writer_owned && rp_local_lock_reap "$rp_local_path" && mkdir "$rp_local_path" || return 1
	fi
	printf 'routepolicy-writer-v1 %s %s\n' "$$" "$(rp_process_start "$$")" >"$rp_local_path/owner" || { rmdir "$rp_local_path"; return 1; }
}
rp_local_unlock() {
	rm -f "$1/owner"
	rmdir "$1" 2>/dev/null || true
}
rp_local_lock_reap() {
	rp_old_path=$1
	[ -d "$rp_old_path" ] && [ ! -L "$rp_old_path" ] && [ -f "$rp_old_path/owner" ] && [ ! -L "$rp_old_path/owner" ] || return 1
	read -r rp_old_version rp_old_pid rp_old_start rp_old_extra <"$rp_old_path/owner" || return 1
	[ "$rp_old_version" = routepolicy-writer-v1 ] || return 1
	case "$rp_old_pid:$rp_old_start" in *[!0-9:]*) return 1 ;; esac
	[ -n "$rp_old_pid" ] && [ -n "$rp_old_start" ] && [ -z "$rp_old_extra" ] || return 1
	if [ "$(rp_process_start "$rp_old_pid")" = "$rp_old_start" ]; then
		rp_old_stat=$(cat "/proc/$rp_old_pid/stat" 2>/dev/null) || return 1
		case "${rp_old_stat##*) }" in Z\ *|X\ *) ;; *) return 1 ;; esac
	fi
	# A dead shell alone is insufficient: its inherited synchronous writers must drain.
	rp_writer_idle || return 1
	[ "$(find "$rp_old_path" -mindepth 1 -maxdepth 1 | wc -l)" = 1 ] || return 1
	rm "$rp_old_path/owner" && rmdir "$rp_old_path"
}
rp_writer_drain_legacy() {
	for rp_old_lock in apply.lock update.lock smartdns-apply.lock import.lock; do
		rp_old_path="$RP_RUN_DIR/$rp_old_lock"
		[ ! -e "$rp_old_path" ] && [ ! -L "$rp_old_path" ] && continue
		rp_local_lock_reap "$rp_old_path" || return 1
	done
}
rp_writer_enter() {
	rp_writer_role=$1
	if [ -n "${ROUTEPOLICY_WRITER_OWNER:-}" ]; then
		rp_writer_owned || { rp_err 'writer owner 已失效或未继承真实写锁'; return 1; }
		[ "$rp_writer_role" != init ] || [ "${ROUTEPOLICY_WRITER_KIND:-}" = init ] || return 1
	else
		for rp_gate_path in "$RP_ETC" "$RP_STATE_DIR" "$RP_STATE_DIR/init-transaction" "$RP_RUN_DIR"; do
			[ ! -L "$rp_gate_path" ] && { [ ! -e "$rp_gate_path" ] || [ -d "$rp_gate_path" ]; } || return 1
		done
		mkdir -p "$RP_STATE_DIR/init-transaction" "$RP_RUN_DIR" && chmod 700 "$RP_STATE_DIR/init-transaction" || return 1
		[ ! -L "$RP_STATE_DIR/init-transaction/lock" ] || return 1
		exec 9>"$RP_STATE_DIR/init-transaction/lock"
		chmod 600 "$RP_STATE_DIR/init-transaction/lock" || return 1
		if [ "${operation:-}" = recover-startup ] || [ "${operation:-}" = recover-early ]; then
			flock -w 180 9 || return 1
		else flock -n 9 || { rp_err '另一个配置或运行态写入正在进行'; return 1; }; fi
		ROUTEPOLICY_WRITER_OWNER="$$:$(rp_process_start "$$")"
		ROUTEPOLICY_WRITER_KIND=$rp_writer_role
		export ROUTEPOLICY_WRITER_OWNER ROUTEPOLICY_WRITER_KIND
		rp_writer_drain_legacy || { rp_err '已有 apply/update/SmartDNS writer 尚未退出或旧锁归属未知'; return 1; }
	fi
	if [ "$rp_writer_role" != init ] && [ "${ROUTEPOLICY_WRITER_KIND:-}" != init ]; then
		if [ -e "$RP_STATE_DIR/init-transaction/active" ] || [ -L "$RP_STATE_DIR/init-transaction/active" ]; then rp_init_active_record >/dev/null || return 1; fi
		case "$(cat "$RP_STATE_DIR/init-transaction/current/phase" 2>/dev/null || printf absent)" in absent|expired|confirmed|rolled_back) ;; *) rp_err '初始化事务尚未完成'; return 1 ;; esac
		! rp_dns_boot_pending || { rp_err '已确认 DNS 启动尚未验证'; return 1; }
	fi
	if [ "${ROUTEPOLICY_WRITER_KIND:-}" = init ]; then
		ROUTEPOLICY_DNS_DEFER=1; export ROUTEPOLICY_DNS_DEFER
	else ROUTEPOLICY_INIT_RESTORE=0; ROUTEPOLICY_DNS_DEFER=0; export ROUTEPOLICY_INIT_RESTORE ROUTEPOLICY_DNS_DEFER; fi
}
# Only synchronous writers inherit FD9. Native services and their callbacks never do.
rp_native_run() {
	rp_native_timeout=$1; shift
	timeout -k 2 "$rp_native_timeout" sh -c '
		unset ROUTEPOLICY_WRITER_OWNER ROUTEPOLICY_WRITER_KIND ROUTEPOLICY_INIT_RESTORE ROUTEPOLICY_INIT_GENERATION ROUTEPOLICY_DNS_DEFER
		exec 9>&-
		exec "$@"' routepolicy-native "$@"
}
rp_native_service() { rp_native_run 15 "$RP_ROOT/etc/init.d/$1" "$2"; }

# Intent-only hotplug writes never wait for the configuration gate held by netifd.
rp_writer_event_mark() {
	[ ! -L "$RP_RUN_DIR" ] || return 1
	mkdir -p "$RP_RUN_DIR" || return 1
	[ ! -L "$RP_RUN_DIR/events.pending" ] || return 1
	rp_event_tmp=$(mktemp "$RP_RUN_DIR/.event.XXXXXX") || return 1
	mv "$rp_event_tmp" "$RP_RUN_DIR/events.pending" || { rm -f "$rp_event_tmp"; return 1; }
	rp_writer_event_wake
}
rp_writer_event_wake() {
	# Reuse the existing named procd guard; it acquires the gate outside this callback.
	[ ! -x "$RP_ROOT/etc/init.d/routepolicy-initguard" ] || rp_native_run 3 "$RP_ROOT/etc/init.d/routepolicy-initguard" start event >/dev/null 2>&1 || true
}
rp_writer_event_take() {
	for rp_event_file in events.pending events.inflight; do
		[ ! -L "$RP_RUN_DIR/$rp_event_file" ] && { [ ! -e "$RP_RUN_DIR/$rp_event_file" ] || [ -f "$RP_RUN_DIR/$rp_event_file" ]; } || return 1
	done
	if [ -f "$RP_RUN_DIR/events.pending" ]; then mv "$RP_RUN_DIR/events.pending" "$RP_RUN_DIR/events.inflight" || return 1; fi
	[ -f "$RP_RUN_DIR/events.inflight" ]
}
rp_writer_event_done() { rm -f "$RP_RUN_DIR/events.inflight"; }
rp_writer_event_pending() { [ -f "$RP_RUN_DIR/events.pending" ] || [ -f "$RP_RUN_DIR/events.inflight" ]; }

# Reuse admission only while the kernel still proves the inherited owner.
rp_writer_idle() {
	rp_writer_ancestors=" $$ "
	rp_writer_parent=$$
	while [ "$rp_writer_parent" -gt 1 ]; do
		rp_writer_stat=$(cat "/proc/$rp_writer_parent/stat" 2>/dev/null) || break
		rp_writer_parent=$(printf '%s\n' "${rp_writer_stat##*) }" | awk '{print $2}')
		case "$rp_writer_parent" in ''|*[!0-9]*) return 1 ;; esac
		rp_writer_ancestors="$rp_writer_ancestors$rp_writer_parent "
	done
	for rp_peer_fd in /proc/[0-9]*/fd/9; do
		rp_peer_pid=${rp_peer_fd#/proc/};rp_peer_pid=${rp_peer_pid%%/*}
		case "$rp_writer_ancestors" in *" $rp_peer_pid "*) continue ;; esac
		if rp_writer_fd_locked "$rp_peer_pid"; then return 1; fi
	done
}
