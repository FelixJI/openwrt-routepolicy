#!/bin/sh
# OpenWrt ash supports function-local variables.
# shellcheck disable=SC3043
set -eu
LIBEXEC=${ROUTEPOLICY_LIBEXEC:-$(dirname "$0")}
. "$LIBEXEC/common"
[ "$#" -ge 1 ] || exit 2
mode=$1
case "$mode" in
	save|restore) [ "$#" -eq 1 ] || exit 2 ;;
	live-save|live-restore) [ "$#" -eq 2 ] || exit 2 ;;
	*) exit 2 ;;
esac
rp_writer_enter warm-state || { rp_output_error warm-state '写入门禁忙或初始化尚未完成'; exit 1; }
rp_ensure_dirs

if [ "$#" = 2 ]; then
	snapshot=$2
	case "$snapshot" in "$RP_RUN_DIR"/*) ;; *) exit 2 ;; esac
	case "/${snapshot#"$RP_RUN_DIR/"}/" in *'/../'*|*'/./'*|*'//'*) exit 2 ;; esac
	parent=$(dirname "$snapshot")
	while [ "$parent" != "$RP_RUN_DIR" ]; do
		[ ! -L "$parent" ] || exit 1
		parent=$(dirname "$parent")
	done
	[ ! -L "$snapshot" ] || exit 1
fi

uptime_ms() {
	LC_ALL=C awk 'NR==1 && NF==2 && $1~/^[0-9]+\.[0-9][0-9]$/ && $2~/^[0-9]+\.[0-9][0-9]$/ && $1<10000000000 {printf "%.0f\n",$1*1000;ok=1} END{exit !ok||NR!=1}' "$RP_ROOT/proc/uptime"
}
boot=$(cat "$RP_ROOT/proc/sys/kernel/random/boot_id" 2>/dev/null) || boot=
if ! printf '%s\n' "$boot" | grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' || ! started=$(uptime_ms 2>/dev/null); then
	rp_err 'warm-state: boot/monotonic time unavailable; snapshot skipped'
	case "$mode" in save|live-save) exit 1 ;; *) exit 0 ;; esac
fi
work=$(mktemp -d "$RP_RUN_DIR/warm-state.XXXXXX")
new=
trap 'rm -rf "$work"; [ -z "$new" ] || rm -f "$new"' EXIT HUP INT TERM

capture_set() {
	local set_name=$1
	nft list set inet routepolicy "$set_name" >"$work/raw" 2>/dev/null || return 1
	LC_ALL=C awk -v set_name="$set_name" -v mode="$mode" '
		function duration(text, total,part,value,unit,rank,previous,multiplier) {
			previous=6
			while(length(text)) {
				if(!match(text,/^[0-9]+(ms|d|h|m|s)/))return -1
				part=substr(text,1,RLENGTH);text=substr(text,RLENGTH+1)
				value=part;sub(/[^0-9].*/,"",value);unit=part;sub(/^[0-9]+/,"",unit)
				rank=(unit=="d"?5:unit=="h"?4:unit=="m"?3:unit=="s"?2:1)
				multiplier=(unit=="d"?86400000:unit=="h"?3600000:unit=="m"?60000:unit=="s"?1000:1)
				if(rank>=previous||length(value)>16||(value+0)>9007199254740991/multiplier)return -1
				previous=rank;total+=value*multiplier
				if(total>9007199254740991)return -1
			}
			return total+0
		}
		{
			line=$0
			if(!inside){if(line!~/elements[[:space:]]*=[[:space:]]*\{/)next;sub(/^.*elements[[:space:]]*=[[:space:]]*\{/,"",line);inside=1}
			text=text " " line
			if(line~/}/){sub(/}.*/,"",text);inside=0}
		}
		END {
			if(inside)exit 1
			n=split(text,entry,",")
			for(i=1;i<=n;i++) {
				gsub(/^[[:space:]]+|[[:space:]]+$/,"",entry[i]);if(entry[i]=="")continue
				fields=split(entry[i],token,/[[:space:]]+/)
				if(split(token[1],octet,".")!=4)exit 1
				for(j=1;j<=4;j++)if(octet[j]!~/^[0-9]+$/||length(octet[j])>3||(octet[j]+0)>255)exit 1
				if(fields==3&&token[2]=="expires")ttl=duration(token[3])
				else if(fields==5&&token[2]=="timeout"&&token[4]=="expires"&&duration(token[3])>=0)ttl=duration(token[5])
				else exit 1
				if(ttl<0)exit 1
				if(ttl>0) {
					if(mode=="save"&&kept>=4096)continue
					printf "%s\t%s\t%.0f\n",set_name,token[1],ttl;kept++
				}
			}
		}
	' "$work/raw"
}
save_snapshot() {
	local target=$1 set_name
	shift
	[ ! -L "$target" ] && { [ ! -e "$target" ] || [ -f "$target" ]; } || return 1
	new=$(mktemp "$target.XXXXXX") || return 1
	printf 'routepolicy-warm-v1\t%s\t%s\n' "$boot" "$started" >"$new" || return 1
	for set_name do
		if ! capture_set "$set_name" >>"$new"; then
			rp_err "warm-state: $set_name has unavailable/invalid expires evidence; snapshot not replaced"
			return 1
		fi
	done
	mv -f "$new" "$target" || return 1
	new=
}
case "$mode" in
	save)
		save_snapshot "$RP_STATE_DIR/warm-domain_policy4.list" domain_policy4
		save_snapshot "$RP_STATE_DIR/warm-domain_default4.list" domain_default4
		exit 0 ;;
	live-save) save_snapshot "$snapshot" domain_policy4 domain_default4; exit 0 ;;
esac

read_snapshot() {
	local file=$1 expected_set=$2
	[ -f "$file" ] && [ ! -L "$file" ] || return 1
	LC_ALL=C awk -F '\t' -v boot="$boot" -v now="$started" -v expected_set="$expected_set" '
		function uint(value){return value~/^(0|[1-9][0-9]*)$/&&length(value)<=16&&(value+0)<=9007199254740991}
		NR==1 {
			if(NF!=3||$1!="routepolicy-warm-v1"||$2!=boot||!uint($3)||$3>now)exit 1
			captured=$3;next
		}
		{
			if(NF!=3||($1!="domain_policy4"&&$1!="domain_default4")||(expected_set!=""&&$1!=expected_set)||!uint($3))exit 1
			if(split($2,octet,".")!=4)exit 1
			for(i=1;i<=4;i++)if(octet[i]!~/^[0-9]+$/||length(octet[i])>3||(octet[i]+0)>255)exit 1
			if(seen[$1,$2]++)exit 1
			printf "%s\t%s\t%.0f\t%s\n",$1,$2,captured,$3
		}
		END{if(NR==0)exit 1}
	' "$file" >"$work/part"
}
: >"$work/values"
if [ "$mode" = live-restore ]; then
	if read_snapshot "$snapshot" ''; then cat "$work/part" >>"$work/values"
	else rp_err 'warm-state: invalid/legacy/other-boot live snapshot skipped'; fi
else
	for set_name in domain_policy4 domain_default4; do
		file="$RP_STATE_DIR/warm-$set_name.list"
		[ -e "$file" ] || [ -L "$file" ] || continue
		if read_snapshot "$file" "$set_name"; then cat "$work/part" >>"$work/values"
		else rp_err "warm-state: invalid/legacy/other-boot $set_name snapshot skipped"; fi
	done
fi
[ -s "$work/values" ] || exit 0
render_restore() {
	# /proc/uptime truncates to 10ms; round restoration up to avoid renewing that fraction.
	LC_ALL=C awk -F '\t' -v now="$1" '{remaining=$4-(now+10-$3);if(remaining>0)printf "add element inet routepolicy %s { %s timeout %.0fms }\n",$1,$2,remaining}' "$work/values" >"$work/restore.nft"
}
render_restore "$started"
[ -s "$work/restore.nft" ] || exit 0
nft -c -f "$work/restore.nft" >/dev/null 2>&1 || exit 1
if ! current=$(uptime_ms 2>/dev/null) || [ "$current" -lt "$started" ]; then
	rp_err 'warm-state: monotonic time moved backwards; restore skipped'; exit 0
fi
# Syntax checking can take time; commit only the still-valid subset with aged TTLs.
render_restore "$current"
[ -s "$work/restore.nft" ] || exit 0
nft -f "$work/restore.nft" >/dev/null 2>&1
