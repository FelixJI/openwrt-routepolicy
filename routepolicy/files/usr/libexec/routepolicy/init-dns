#!/bin/sh
# Sourced by the topology planner and its existing five-package transaction.
# Variables belong to the two sourcing entry points.
# shellcheck disable=SC3043,SC2154

init_dns_values() {
	local input=$1 logical=$2 raw item address port count=0 seen=''
	if [ "$input" = - ]; then
		raw=$(rp_interface_json "$logical") || return 1
		input=$(field "$raw" '@["dns-server"][*]' | awk '/^[0-9.]+$/' | tr '\n' ',')
		input=${input%,}
	fi
	[ -n "$input" ] || { rp_err "接口 $logical 没有可继承的 IPv4 DNS，请明确填写 DNS 来源"; return 1; }
	case "$input" in ,*|*,|*,,*|*[!0-9.,#]*) return 1 ;; esac
	for item in $(printf '%s' "$input" | tr ',' ' '); do
		address=${item%%#*}; port=53
		[ "$item" = "$address" ] || port=${item#*#}
		rp_is_ipv4 "$address" && rp_uint_between "$port" 1 65535 || return 1
		case "$address" in 0.*|127.*|169.254.*) return 1 ;; esac
		[ "${address%%.*}" -lt 224 ] || return 1
		case " $seen " in *" $address#$port "*) continue ;; esac
		seen="$seen $address#$port"; count=$((count+1)); [ "$count" -le 4 ] || return 1
		printf '%s#%s\n' "$address" "$port"
	done
	[ "$count" -gt 0 ]
}

init_ipv4_plan() {
	local logical device section configured proto seen='' devices='' related=''
	for logical in "$access" "$default_if" "$policy"; do
		case " $seen " in *" $logical "*) continue ;; esac
		seen="$seen $logical"
		case "$logical" in "$access") device=$access_device ;; "$default_if") device=$default_device ;; *) device=$policy_device ;; esac
		set_value "network.$logical.ipv6" 0
		set_value "network.$logical.ip6assign" 0
		set_value "network.$logical.delegate" 0
		for configured in ip6addr ip6gw ip6prefix; do printf 'delete\tnetwork.%s.%s\t-\n' "$logical" "$configured"; done
		case " $devices " in *" $device "*) continue ;; esac
		devices="$devices $device"
		for section in $(sections network device); do
			[ "$(get "network.$section.name")" != "$device" ] || set_value "network.$section.ipv6" 0
		done
	done
	for section in $(sections network interface); do
		case " $seen " in *" $section "*) continue ;; esac
		configured=$(get "network.$section.device")
		[ -n "$configured" ] || configured=$(get "network.$section.ifname")
		related=0
		for logical in $seen; do case " $configured " in *" @$logical "*) related=1 ;; esac; done
		for device in $devices; do case " $configured " in *" $device "*) related=1 ;; esac; done
		[ "$related" = 1 ] || continue
		proto=$(get "network.$section.proto")
		[ "$proto" = dhcpv6 ] || fail "IPv6 设备还被未选接口 $section 占用，请先明确接口归属"
		case "$configured" in *[[:space:]]*) fail "DHCPv6 接口 $section 同时引用其他设备，不能安全禁用" ;; esac
		set_value "network.$section.auto" 0
		set_value "network.$section.disabled" 1
	done
	for section in $(sections network route6); do
		configured=$(get "network.$section.interface")
		case " $seen " in *" $configured "*) [ -z "$configured" ] || fail "受管理接口有显式 IPv6 路由 $section，请先手工处理" ;; esac
	done
	for section in $(sections dhcp dhcp); do
		configured=$(get "dhcp.$section.interface")
		case " $seen " in *" $configured "*) ;; *) continue ;; esac
		[ -n "$configured" ] && [ "$configured" != "$access" ] || continue
		ident "$section" || fail '受管理出口的匿名 DHCP 段需要先改为稳定命名'
		for configured in ra dhcpv6 ndp; do set_value "dhcp.$section.$configured" disabled; done
	done
}

init_dns_native_side_effects() {
	local root=$1 running=$2 cache cron="$RP_ROOT/etc/crontabs/root" result
	# Match native config_get_bool(..., 0), including its accepted true aliases.
	case "$(get "smartdns.$root.cache_persist")" in
		1|on|true|yes|enabled) ;;
		*)
			if [ "$running" = 1 ]; then
				cache=$(get "smartdns.$root.cache_file"); cache=${cache:-/etc/smartdns/smartdns.cache}
				case "$cache" in /*) ;; *) fail '原 SmartDNS cache_file 是相对路径，无法证明回滚重启不会删除旧缓存' ;; esac
				[ ! -f "$RP_ROOT$cache" ] || fail "原 SmartDNS cache_persist 关闭且旧缓存存在: $cache；原生回滚启动会删除它，请先手工处理"
			fi ;;
	esac
	case "$(get "smartdns.$root.enable_auto_update")" in
		1|on|true|yes|enabled) fail 'SmartDNS enable_auto_update 已开启，原生启动可能改写 root crontab；请先关闭自动更新并检查定时项' ;;
	esac
	if [ -e "$cron" ] || [ -L "$cron" ]; then
		[ -f "$cron" ] && [ -r "$cron" ] || fail '无法安全读取 root crontab 以检查 SmartDNS 原生副作用'
		# Deliberately use native grep's BRE, including commented matches and dots.
		result=0; grep -q '/etc/init.d/smartdns updatefiles' "$cron" || result=$?
		case "$result" in
			0) fail 'root crontab 有原生 SmartDNS 自动更新匹配项（含注释）；原生启动会删除/改写它，请先手工处理' ;;
			1) ;;
			*) fail '读取 root crontab 失败，无法证明原生启动不会修改定时项' ;;
		esac
	fi
}

init_dns_plan() {
	local roots root dnsmasq port role logical device values item index section group previous data files
	rp_have dig || fail 'DNS 验证依赖缺失: dig'
	[ -x "$RP_ROOT/etc/init.d/smartdns" ] && [ -x "$RP_ROOT/usr/sbin/smartdns" ] || fail '需要官方 SmartDNS init 和二进制'
	roots=$(rp_smartdns_root_sections)
	[ "$(printf '%s\n' "$roots" | awk 'NF{n++}END{print n+0}')" -le 1 ] || fail '多个 SmartDNS 根段，不能安全初始化'
	root=$(printf '%s\n' "$roots" | sed -n '1p')
	if [ -z "$root" ]; then
		[ -z "$(get smartdns.rp_init)" ] || fail 'SmartDNS 保留根段 rp_init 已被用户配置占用'
		root=rp_init; set_value smartdns.rp_init smartdns
	fi
	[ -z "$(get "smartdns.$root.redirect")" ] || fail 'SmartDNS redirect 旧迁移项会修改 DHCP；请先在官方界面完成迁移'
	roots=$(sections dhcp dnsmasq)
	[ "$(printf '%s\n' "$roots" | awk 'NF{n++}END{print n+0}')" = 1 ] || fail '需要唯一 dnsmasq 实例；多实例请先明确接入归属'
	dnsmasq=$roots
	previous=$(init_dns_service_state smartdns) || fail '无法读取 SmartDNS 原运行状态'
	init_dns_native_side_effects "$root" "$previous"
	if [ "$previous" = 1 ]; then
		for item in port enabled auto_set_dnsmasq; do
			previous=$(get "smartdns.$root.$item")
			[ -n "$previous" ] || { case "$item" in port) previous=53 ;; enabled) previous=0 ;; *) previous=1 ;; esac; }
			[ "$(get "smartdns.$root.old_$item")" = "$previous" ] || fail "SmartDNS 运行配置与原生 old_$item 不一致；请先在原生界面完成重载"
		done
		if [ "$(get "smartdns.$root.auto_set_dnsmasq")" = 1 ]; then
			previous=$(get "smartdns.$root.port")
			if [ "$previous" = 53 ]; then
				[ "$(get "dhcp.$dnsmasq.port")" = 0 ] && [ "$(get "dhcp.$dnsmasq.dns_redirect")" != 1 ] || fail '原生 SmartDNS 自动主 DNS 与 DHCP 状态不一致，请先手工恢复'
			else
				case "$(get "dhcp.$dnsmasq.server") " in "127.0.0.1#$previous "*) ;; *) fail '原生 SmartDNS 自动转发与 DHCP 上游不一致，请先手工恢复' ;; esac
			fi
		fi
	fi
	for section in $(sections dhcp dhcp); do
		[ "$(get "dhcp.$section.interface")" = "$access" ] || [ "$(get "dhcp.$section.ignore")" = 1 ] || fail "dnsmasq 仍承担其他 DHCP 服务: $section"
	done
	for section in boot mac tag match host; do
		[ -z "$(sections dhcp "$section")" ] || [ "$section" = host ] || fail "dnsmasq 有额外 DHCP/PXE 配置: $section"
	done
	for item in enable_tftp dhcp_boot dhcp_range pxe_service; do
		previous=$(get "dhcp.$dnsmasq.$item")
		[ -z "$previous" ] || [ "$previous" = 0 ] || fail "dnsmasq 仍承担必要职责: $item"
	done
	# Unknown DNS daemons are never stopped or adopted on the strength of port alone.
	netstat -lnptu | awk '$1~/^(tcp|udp)(6)?$/&&$4~/:53$/&&$0!~/(smartdns|dnsmasq)/{bad=1}END{exit bad}' || fail '53 端口存在未知监听进程'
	port=53
	previous=$(get "smartdns.$root.server_flags")
	case "$previous" in ''|'-group rp_init_default') ;; *) fail 'SmartDNS server_flags 已有用户设置，不能安全接管默认上游组' ;; esac
	# Seed the official init bookkeeping to prevent its legacy dnsmasq auto-edit path.
	for item in enabled:1 port:"$port" tcp_server:1 ipv6_server:0 bind_device:1 bind_device_name:"$access_device" auto_set_dnsmasq:0 old_enabled:1 old_port:"$port" old_auto_set_dnsmasq:0 cache_persist:1 cache_file:/tmp/routepolicy/smartdns.cache force_aaaa_soa:1 tls_server:0 doh_server:0 seconddns_enabled:0; do
		set_value "smartdns.$root.${item%%:*}" "${item#*:}"
	done
	for item in client-rule domain-rule ip-rule; do
		if [ -z "$(sections smartdns "$item")" ]; then
			section=rp_init_$(printf '%s' "$item" | tr '-' '_')
			[ -z "$(get "smartdns.$section")" ] || fail "SmartDNS 保留段冲突: $section"
			set_value "smartdns.$section" "$item"
		fi
	done
	set_value "smartdns.$root.server_flags" '-group rp_init_default'
	set_value "dhcp.$dnsmasq.port" 0
	data=$(uci -q export smartdns | rp_uci_field_data "$root" conf_files) || {
		[ -z "$(get "smartdns.$root.conf_files")" ] || fail 'SmartDNS conf_files 包含不能无损处理的值'
		data=''
	}
	files=${data#*"$(printf '\t')"}
	files=$(printf '%s\n' "$files" | tr '|' '\n' | awk '$0!="/etc/smartdns/conf.d/90-routepolicy.conf"&&NF' | tr '\n' '|'); files=${files%|}
	case "|$files|" in *'|/etc/smartdns/conf.d/91-routepolicy-smartdns-extra.conf|'*) ;; *) files="${files:+$files|}/etc/smartdns/conf.d/91-routepolicy-smartdns-extra.conf" ;; esac
	files="$files|/etc/smartdns/conf.d/90-routepolicy.conf"
	init_dns_audit_user_files "$files" "$access_device" || fail '用户 SmartDNS include 占用保留上游组或含无法安全审计的语法；文件已保留，请先手工处理'
	printf 'list\tsmartdns.%s.conf_files\t%s\n' "$root" "$files"
	set_value routepolicy.main.smartdns_enabled 1
	set_value routepolicy.main.smartdns_policy_group rp_init_policy
	for role in default policy; do
		if [ "$role" = default ]; then logical=$default_if device=$default_device values=${dns_default:--}; else logical=$policy device=$policy_device values=${dns_policy:--}; fi
		values=$(init_dns_values "$values" "$logical") || fail "出口 $role 的 IPv4 DNS 来源无效或缺失"
		index=0
		for item in $values; do
			index=$((index+1)); section="rp_init_${role}_$index"; group="rp_init_$role"
			previous=$(get "smartdns.$section")
			[ -z "$previous" ] || { [ "$previous" = server ] && [ "$(get "smartdns.$section.routepolicy_init")" = 1 ]; } || fail "SmartDNS 保留段冲突: $section"
			set_value "smartdns.$section" server
			set_value "smartdns.$section.routepolicy_init" 1
			set_value "smartdns.$section.enabled" 1
			set_value "smartdns.$section.type" udp
			set_value "smartdns.$section.ip" "${item%#*}"
			set_value "smartdns.$section.port" "${item##*#}"
			set_value "smartdns.$section.server_group" "$group"
			set_value "smartdns.$section.exclude_default_group" 1
			set_value "smartdns.$section.addition_arg" "-interface $device"
		done
		# A smaller repeated input disables only our previously generated surplus.
		while [ "$index" -lt 4 ]; do
			index=$((index+1)); section="rp_init_${role}_$index"
			[ "$(get "smartdns.$section.routepolicy_init")" != 1 ] || set_value "smartdns.$section.enabled" 0
		done
	done
	for section in $(rp_smartdns_server_sections); do
		[ "$(get "smartdns.$section.routepolicy_init")" = 1 ] && continue
		group=$(get "smartdns.$section.server_group")
		case " $group " in *' rp_init_default '*|*' rp_init_policy '*) fail "用户上游占用了初始化保留组: $section" ;; esac
	done
}

init_dns_owned() { grep -q '^set[[:space:]]smartdns\.' "$WAL/candidate"; }
init_dns_managed() {
	local root
	init_dns_owned && [ "$(uci -q get routepolicy.main.enabled)" = 1 ] && [ "$(uci -q get routepolicy.main.smartdns_enabled)" = 1 ] || return 1
	root=$(rp_smartdns_single_root) || return 1
	[ "$(uci -q get "smartdns.$root.cache_file")" = /tmp/routepolicy/smartdns.cache ] &&
		[ "$(uci -q get "smartdns.$root.server_flags")" = '-group rp_init_default' ] &&
		[ "$(uci -q get "smartdns.$root.auto_set_dnsmasq")" = 0 ]
}
init_dns_service_state() {
	local service=$1 output
	output=$(ubus call service list "{\"name\":\"$service\"}") || return 1
	case "$output" in \{*\}) ;; *) return 1 ;; esac
	printf '%s\n' "$output" | jsonfilter -e '@' >/dev/null || return 1
	if printf '%s\n' "$output" | jsonfilter -e "@.$service.instances.*.running" | grep -Eq '^(true|1)$'; then printf 1; else printf 0; fi
}
init_dns_enabled() {
	local result=0
	rp_native_run 3 "$RP_ROOT/etc/init.d/$1" enabled >/dev/null 2>&1 || result=$?
	case "$result" in 0) printf 1 ;; 1) printf 0 ;; *) return 1 ;; esac
}
init_dns_call() {
	# The bounded supervisor retains FD9 until the service writer has exited.
	rp_native_service "$1" "$2"
}
init_dns_present() {
	local output
	output=$(timeout 3 ubus call service list '{"name":"smartdns"}') || return 2
	case "$output" in \{*\}) ;; *) return 2 ;; esac
	printf '%s\n' "$output" | jsonfilter -e '@' >/dev/null || return 2
	printf '%s\n' "$output" | jsonfilter -e '@.smartdns' >/dev/null 2>&1
}
init_dns_stop() {
	local result=0 remaining=10 present
	if init_dns_present; then :; else present=$?; [ "$present" = 1 ] && return 0; return 1; fi
	rp_native_run 15 ubus call service delete '{"name":"smartdns"}' >/dev/null || result=$?
	# Only NotFound is benign, and only after an independent successful readback.
	case "$result" in 0|4) ;; *) return 1 ;; esac
	while :; do
		if init_dns_present; then
			[ "$result" = 0 ] && [ "$remaining" -gt 0 ] || return 1
		else present=$?; [ "$present" = 1 ] && return 0; return 1; fi
		sleep 1; remaining=$((remaining-1))
	done
}
init_dns_original_probe() {
	local service=$1 mode=$2 endpoints protocol address port answer queried remaining family output configured dns_root
	endpoints="$WAL/$service-listeners"
	if [ "$mode" = save ]; then
		# BusyBox also reports upstream UDP source sockets under the daemon PID.
		case "$service" in
			dnsmasq) configured=$(uci -q get 'dhcp.@dnsmasq[0].port') || configured=53 ;;
			smartdns)
				dns_root=$(rp_smartdns_single_root) || return 1
				configured=$(uci -q get "smartdns.$dns_root.port") || configured=53 ;;
			*) return 1 ;;
		esac
		rp_uint_between "$configured" 0 65535 || return 1
		if [ "$configured" = 0 ]; then : >"$endpoints"; return; fi
		output=$(timeout 3 netstat -lnptu) || return 1
		printf '%s\n' "$output" | awk -v service="$service" -v configured="$configured" '
			$1~/^(tcp|udp)(6)?$/ && $NF~("/" service "$") && $4~/:+[0-9]+$/ {
				address=$4;sub(/:[0-9]+$/,"",address);port=$4;sub(/^.*:/,"",port)
				if(port!=configured)next
				if(address=="0.0.0.0")address="127.0.0.1"
				if(address=="::")address="::1"
				print $1 " " address " " port " 0"}' | sort -u >"$endpoints" || return 1
		: >"$endpoints.new" || return 1
	fi
	[ -f "$endpoints" ] || return 0
	while read -r protocol address port queried; do
		[ -n "$protocol" ] || continue
		if [ "$mode" != save ]; then
			remaining=10
			until timeout 3 netstat -lnptu | awk -v service="$service" -v protocol="$protocol" -v address="$address" -v port="$port" '
				$1==protocol && $NF~("/" service "$") && ($4==address ":" port || $4==(index(address,":")?":::" port:"0.0.0.0:" port)) {found=1}END{exit !found}'; do
				[ "$remaining" -gt 0 ] || return 1
				sleep 1; remaining=$((remaining-1))
			done
		fi
		if [ "$mode" = save ] || [ "$queried" = 1 ]; then
			case "$protocol" in tcp|tcp6) answer=+tcp ;; udp|udp6) answer=+notcp ;; *) return 1 ;; esac
			family=-4; case "$address" in *:*) family=-6 ;; esac
			if answer=$(timeout 6 dig "$family" "$answer" +time=2 +tries=1 +noall +comments +answer "@$address" -p "$port" routepolicy-init-restore.test A) && printf '%s\n' "$answer" | grep -Eq 'status: (NOERROR|NXDOMAIN),'; then queried=1
			else [ "$mode" = save ] || return 1; queried=0; fi
		fi
		[ "$mode" != save ] || printf '%s %s %s %s\n' "$protocol" "$address" "$port" "$queried" >>"$endpoints.new" || return 1
	done <"$endpoints"
	[ "$mode" != save ] || mv "$endpoints.new" "$endpoints"
}
init_dns_audit_binds() {
	local config=$1 depth=$2 port=$3 device=$4 user=${5:-0} includes include child
	[ "$depth" -lt 16 ] && [ -f "$config" ] || return 1
	# Native getopt_long_only also accepts -gVALUE, --gr=VALUE and quoted arguments.
	# Reject escapes/continuations and ambiguous quoting instead of guessing native parsing.
	includes=$(awk -v port="$port" -v device="$device" -v user="$user" '
		function tokens(line, i,c,q,word,n,started,closed,k) {
			for(k in arg)delete arg[k]
			for(i=1;i<=length(line);i++) {
				c=substr(line,i,1)
				if(q!=""){if(c==q){q="";closed=1}else word=word c;continue}
				if(c~/[ \t]/){if(started){arg[++n]=word;word="";started=closed=0}continue}
				if(closed)return 0
				if(c=="\""||c==sprintf("%c",39)){if(started)return 0;q=c;started=1;continue}
				word=word c;started=1
			}
			if(q!="")return 0
			if(started)arg[++n]=word
			return n
		}
		/^[ \t]*($|#)/ {next}
		{
			line=$0;sub(/\r$/,"",line);clean=line;gsub(/\t/,"",clean)
			if(length(line)>4095||index(line,"\\")||clean~/[[:cntrl:]]/){bad=1;next}
			key=$1
			if(key!~/^server/&&key!~/^bind/&&key!~/^group-/&&key!="conf-file"&&key!="conf_file")next
			n=tokens(line);if(!n){bad=1;next}
			if(user&& (key~/^server/||key=="group-begin"||key=="conf-file"||key=="conf_file")) {
				for(i=2;i<=n;i++) {
					value=arg[i];sub(/^.*=/,"",value)
					if(value~/^rp_init_(default|policy)$/||arg[i]~/^-[A-Za-z]*grp_init_(default|policy)$/)bad=1
				}
			}
			if(key~/^bind/&&(key!~/^bind(-tcp)?$/||(arg[2]!=":" port "@lo"&&arg[2]!=":" port "@" device)||arg[3]!="-group"||arg[4]!="rp_init_default"))bad=1
			if(key=="conf-file"||key=="conf_file"){if(n<2||arg[2]==""||arg[2]~/[[:cntrl:]]/)bad=1;else print arg[2]}
		}
		END{exit bad}' "$config") || { rp_err "SmartDNS include 审计失败: $config"; return 1; }
	[ -n "$includes" ] || return 0
	while IFS= read -r include; do
		case "$include" in *'*'*|*'?'*|*'['*|*']'*) rp_err 'SmartDNS include 通配路径无法安全审计，请改为明确文件'; return 1 ;; esac
		case "$include" in /*) child="$RP_ROOT$include" ;; *) child="$(dirname "$config")/$include" ;; esac
		# Native glob ignores missing paths and directories.
		[ -f "$child" ] || { [ ! -e "$child" ] || [ -d "$child" ]; } || return 1
		[ ! -f "$child" ] || init_dns_audit_binds "$child" "$((depth+1))" "$port" "$device" 1 || return 1
	done <<EOF
$includes
EOF
}
init_dns_audit_user_files() {
	local files=$1 device=$2 include exported sections section enabled data
	# Native init also loads enabled client-rule includes and these three fixed files.
	exported=$(uci -q export smartdns) || return 1
	sections=$(uci -q show smartdns | sed -n 's/^smartdns\.\([^.=]*\)=client-rule$/\1/p')
	for section in $sections; do
		enabled=$(uci -q get "smartdns.$section.enabled") || enabled=0
		case "$enabled" in 1|on|true|yes|enabled) ;; *) continue ;; esac
		if data=$(printf '%s\n' "$exported" | rp_uci_field_data "$section" conf_files); then files="$files|${data#*"$(printf '\t')"}"
		else [ -z "$(uci -q get "smartdns.$section.conf_files")" ] || return 1; fi
	done
	files="$files|/etc/smartdns/address.conf|/etc/smartdns/blacklist-ip.conf|/etc/smartdns/custom.conf"
	while IFS= read -r include; do
		[ -n "$include" ] || continue
		case "$include" in /*) ;; *) include="/etc/smartdns/conf.d/$include" ;; esac
		# Native init wraps these paths in single quotes before native argument parsing.
		case "$include" in *"'"*|*'\'*) rp_err 'SmartDNS conf_files 引号或转义路径无法安全审计'; return 1 ;; esac
		case "$include" in *'*'*|*'?'*|*'['*|*']'*) rp_err 'SmartDNS conf_files 通配路径无法安全审计，请改为明确文件'; return 1 ;; esac
		[ ! -f "$RP_ROOT$include" ] || init_dns_audit_binds "$RP_ROOT$include" 0 53 "$device" 1 || return 1
	done <<EOF
$(printf '%s\n' "$files" | tr '|' '\n')
EOF
}

init_dns_coordinate() {
	local action=$1 port answer protocol probe access_dev service running enabled section address group device temp remaining cache="$RP_RUN_DIR/smartdns.cache" path=$RP_SMARTDNS_EXTRA_FILE
	# Old #17 WALs contain no DNS fields and retain their original recovery path.
	init_dns_owned || return 0
	case "$action" in
		prepare)
			[ ! -L "$cache" ] && { [ ! -e "$cache" ] || [ -f "$cache" ]; } || return 1
			if [ -e "$cache" ]; then
				section=$(rp_smartdns_single_root) || return 1
				[ "$(uci -q get "smartdns.$section.cache_file")" = /tmp/routepolicy/smartdns.cache ] || return 1
			fi
			[ ! -L "$path" ] && { [ ! -e "$path" ] || [ -f "$path" ]; } || return 1
			if [ -e "$path" ]; then cp -p "$path" "$WAL/dns-file-old" || return 1; else : >"$WAL/dns-file-absent"; fi
			{ [ ! -f "$WAL/dns-file-old" ] || cat "$WAL/dns-file-old"; } >"$WAL/dns-file-new" || return 1
			if ! grep -Fqx '# routepolicy initialization probes' "$WAL/dns-file-new"; then
				{ printf '\n'; rp_smartdns_init_probes; } >>"$WAL/dns-file-new" || return 1
			fi
			for probe in default policy; do
				[ "$(grep -Fxc "domain-rules /routepolicy-init-$probe.test/ -nameserver rp_init_$probe -speed-check-mode none" "$WAL/dns-file-new")" = 1 ] || return 1
			done
			[ ! -L "$RP_SMARTDNS_FILE" ] && { [ ! -e "$RP_SMARTDNS_FILE" ] || [ -f "$RP_SMARTDNS_FILE" ]; } || return 1
			if [ -e "$RP_SMARTDNS_FILE" ]; then cp -p "$RP_SMARTDNS_FILE" "$WAL/dns90-old" || return 1; else : >"$WAL/dns90-absent"; fi
			if [ -e "$RP_ACTIVE_DIR" ]; then
				[ -d "$RP_ACTIVE_DIR" ] && [ ! -L "$RP_ACTIVE_DIR" ] || return 1
				[ -z "$(find "$RP_ACTIVE_DIR" -mindepth 1 ! -type f)" ] || return 1
				[ -z "$(find "$RP_ACTIVE_DIR" -mindepth 1 -maxdepth 1 ! -name generation ! -name domain-policy.list ! -name domain-default.list)" ] || return 1
				cp -pR "$RP_ACTIVE_DIR" "$WAL/dns-active-old" || return 1
			fi
			for service in smartdns dnsmasq; do
				[ -x "$RP_ROOT/etc/init.d/$service" ] || return 1
				running=$(init_dns_service_state "$service") && enabled=$(init_dns_enabled "$service") || return 1
				printf '%s\n' "$running" >"$WAL/$service-running" && printf '%s\n' "$enabled" >"$WAL/$service-enabled" || return 1
				[ "$running" = 0 ] || init_dns_original_probe "$service" save || return 1
			 done
			enabled=$(init_dns_enabled routepolicy) || return 1
			printf '%s\n' "$enabled" >"$WAL/routepolicy-enabled"
			;;
		quiesce)
			section=$(awk -F '\t' '$1=="list"&&$2~/^smartdns\.[^.]+\.conf_files$/ {print $3;exit}' "$WAL/candidate")
			init_dns_audit_user_files "$section" "$(awk -F '\t' '$2~/^smartdns\.[^.]+\.bind_device_name$/ {print $3;exit}' "$WAL/candidate")" || return 1
			for service in smartdns dnsmasq; do
				[ "$(init_dns_service_state "$service")" = "$(cat "$WAL/$service-running")" ] && [ "$(init_dns_enabled "$service")" = "$(cat "$WAL/$service-enabled")" ] || return 1
			done
			[ "$(init_dns_enabled routepolicy)" = "$(cat "$WAL/routepolicy-enabled")" ] || return 1
			printf '%s' '' >"$WAL/dns-service-attempted" && sync || return 1
			# Remove native config.reload writers before the first candidate commit.
			init_dns_stop
			;;
		apply)
			if [ -f "$WAL/dns-file-absent" ]; then [ ! -e "$path" ] && [ ! -L "$path" ] || return 1
			else cmp -s "$path" "$WAL/dns-file-old" || return 1; fi
			printf '%s' '' >"$WAL/dns-attempted" && sync || return 1
			temp="$path.init-$(cat "$WAL/token")"
			[ ! -L "$temp" ] && [ ! -e "$temp" ] || return 1
			mkdir -p "$(dirname "$path")" && (set -C; cat "$WAL/dns-file-new" >"$temp") && chmod 0644 "$temp" && mv "$temp" "$path" || return 1
			;;
		handoff)
			printf '%s' '' >"$WAL/dns-service-attempted" && sync || return 1
			{
				init_dns_call dnsmasq stop &&
				init_dns_call dnsmasq disable &&
				init_dns_stop &&
				init_dns_call routepolicy enable
			} >"$WAL/dns-service-result" 2>&1 || return 1
			remaining=10
			while netstat -lnptu | grep -Eq 'smartdns'; do
				[ "$remaining" -gt 0 ] || return 1
				sleep 1; remaining=$((remaining-1))
			done
			# A fresh table must not consume a warm cache left by a previous disable.
			# Keep this application's old /tmp cache only until confirm or rollback.
			temp="$cache.init-$(cat "$WAL/token")"
			[ ! -L "$cache" ] && [ ! -L "$temp" ] && [ ! -e "$temp" ] || return 1
			if [ -e "$cache" ]; then
				printf '%s' '' >"$WAL/dns-cache-move" && sync && mv "$cache" "$temp" || return 1
			else printf '%s' '' >"$WAL/dns-cache-absent" && sync || return 1; fi
			;;
		start)
			init_dns_call smartdns reload && init_dns_call smartdns enable
			;;
		policy-prepare)
			rp_render_smartdns90 "$WAL/dns90-new" || return 1
			printf '%s' '' >"$WAL/dns90-attempted" && sync
			;;
		verify)
			[ "$(init_dns_service_state smartdns)" = 1 ] && { [ "${operation:-}" = boot-dns ] || [ "$(init_dns_enabled smartdns)" = 1 ]; } &&
				[ "$(init_dns_service_state dnsmasq)" = 0 ] && [ "$(init_dns_enabled dnsmasq)" = 0 ] && rp_smartdns_fragment_loaded "$path" || return 1
			if [ "${operation:-}" = boot-dns ]; then
				for probe in default policy; do
					[ "$(grep -Fxc "domain-rules /routepolicy-init-$probe.test/ -nameserver rp_init_$probe -speed-check-mode none" "$path")" = 1 ] || return 1
				done
			else cmp -s "$path" "$WAL/dns-file-new" || return 1; fi
			rp_smartdns_fragment_loaded "$RP_SMARTDNS_FILE" || return 1
			port=$(awk -F '\t' '$2~/^smartdns\.[^.]+\.port$/ {print $3;exit}' "$WAL/candidate")
			access_dev=$(awk -F '\t' '$2~/^smartdns\.[^.]+\.bind_device_name$/ {print $3;exit}' "$WAL/candidate")
			awk -v port="$port" -v device="$access_dev" '
				$1~/^bind/ {if($1!~/^bind(-tcp)?$/||($2!=":" port "@lo"&&$2!=":" port "@" device)||$3!="-group"||$4!="rp_init_default")bad=1;else seen[$1,$2]=1}
				END{exit bad||!seen["bind",":" port "@lo"]||!seen["bind-tcp",":" port "@lo"]||!seen["bind",":" port "@" device]||!seen["bind-tcp",":" port "@" device]}' "$RP_SMARTDNS_GENERATED" || return 1
			init_dns_audit_binds "$RP_SMARTDNS_GENERATED" 0 "$port" "$access_dev" || return 1
			for group in default policy; do
				device=$(uci_committed get "routepolicy.main.${group}_interface") || return 1
				device=$(rp_interface_device "$device") || return 1
				rp_is_device "$device" || return 1
				awk -v group="rp_init_$group" -v device="$device" '
					$1~/^server/&&index(" " $0 " "," -group " group " ") {
						found=1;if(!index(" " $0 " "," -interface " device " ")||!index(" " $0 " "," -exclude-default-group "))bad=1
					}
					END{exit !found||bad}' "$RP_SMARTDNS_GENERATED" || return 1
			done
			netstat -lnptu | awk -v port="$port" '
				$1~/^(tcp|udp)$/ && $4~(":" port "$") && $0~/smartdns/ {seen[$1]=1}
				$1~/^(tcp|udp)(6)?$/ && $4~/:53$/ && $0!~/smartdns/ {bad=1}
				$1~/^(tcp6|udp6)$/ && $4~/:53$/ {bad=1}
				END{exit bad||!seen["tcp"]||!seen["udp"]}' || return 1
			# Query both transports and groups through the client-facing SmartDNS socket.
			for protocol in +notcp +tcp; do
				for probe in default policy; do
					answer=$(timeout 6 dig "$protocol" +time=2 +tries=1 +noall +comments +answer "@$(topology management-address)" "routepolicy-init-$probe.test" A) || return 1
					printf '%s\n' "$answer" >>"$WAL/dns-query-result"
					printf '%s\n' "$answer" | grep -Eq 'status: (NOERROR|NXDOMAIN),' || return 1
				done
			done
			;;
		rollback)
			if [ "${recovery_early:-0}" != 1 ] && [ -f "$WAL/dns-service-attempted" ]; then init_dns_stop || return 1; fi
			[ -f "$WAL/dns-attempted" ] || return 0
			temp="$path.init-$(cat "$WAL/token")"
			[ ! -L "$temp" ] || return 1
			[ ! -e "$temp" ] || { [ -f "$temp" ] && rm -f "$temp"; } || return 1
			[ ! -L "$path" ] || return 1
			if cmp -s "$path" "$WAL/dns-file-new"; then
				if [ -f "$WAL/dns-file-absent" ]; then rm -f "$path"; else cp -p "$WAL/dns-file-old" "$path"; fi
			elif [ -f "$WAL/dns-file-absent" ]; then [ ! -e "$path" ] || return 1
			else cmp -s "$path" "$WAL/dns-file-old" || return 1; fi
			;;
		restore-files|restore-service)
			[ -f "$WAL/dns-attempted" ] || [ -f "$WAL/dns-service-attempted" ] || [ -f "$WAL/dns-boot-quarantined" ] || return 0
			if [ -f "$WAL/dns90-attempted" ]; then
				[ ! -L "$RP_SMARTDNS_FILE" ] || return 1
				if cmp -s "$RP_SMARTDNS_FILE" "$WAL/dns90-new" || { [ -f "$WAL/dns90-restore" ] && cmp -s "$RP_SMARTDNS_FILE" "$WAL/dns90-restore"; }; then
					if [ -f "$WAL/dns90-absent" ]; then rm -f "$RP_SMARTDNS_FILE"; else cp -p "$WAL/dns90-old" "$RP_SMARTDNS_FILE"; fi
				elif [ -f "$WAL/dns90-absent" ]; then [ ! -e "$RP_SMARTDNS_FILE" ] || return 1
				else cmp -s "$RP_SMARTDNS_FILE" "$WAL/dns90-old" || return 1; fi
				if [ "$(cat "$WAL/policy-active")" = 0 ] && [ -d "$WAL/dns-active-old" ]; then
					if [ -e "$RP_ACTIVE_DIR" ]; then
						[ -d "$RP_ACTIVE_DIR" ] && [ ! -L "$RP_ACTIVE_DIR" ] || return 1
						for section in generation domain-policy.list domain-default.list; do
							if [ -e "$WAL/dns-active-old/$section" ]; then cmp -s "$WAL/dns-active-old/$section" "$RP_ACTIVE_DIR/$section" || return 1
							else [ ! -e "$RP_ACTIVE_DIR/$section" ] || return 1; fi
						done
					else mkdir -p "$RP_RUN_DIR" && cp -pR "$WAL/dns-active-old" "$RP_ACTIVE_DIR" || return 1; fi
				fi
			fi
			[ "$action" != restore-files ] || return 0
			[ -f "$WAL/dns-service-attempted" ] || [ -f "$WAL/dns-boot-quarantined" ] || return 0
			temp="$cache.init-$(cat "$WAL/token")"
			[ ! -L "$temp" ] && [ ! -L "$cache" ] || return 1
			if [ -f "$temp" ]; then rm -f "$cache" && mv "$temp" "$cache" || return 1
			elif [ -f "$WAL/dns-cache-absent" ]; then rm -f "$cache" || return 1; fi
			# An existing confirmed contract owns cold boot DNS admission after rollback.
			if rp_dns_boot_pending; then init_dns_restore_bookkeeping; return; fi
			for service in dnsmasq smartdns; do
				case "$(cat "$WAL/$service-enabled")" in 1) enabled=enable ;; 0) enabled=disable ;; *) return 1 ;; esac
				[ "$(init_dns_enabled "$service")" = "$(cat "$WAL/$service-enabled")" ] || init_dns_call "$service" "$enabled" >/dev/null || return 1
				case "$(cat "$WAL/$service-running")" in 1) running=start ;; 0) running=stop ;; *) return 1 ;; esac
				if [ "$service:$running" = smartdns:stop ]; then init_dns_stop || return 1
				elif [ "$running" = start ] && [ -f "$WAL/dns-attempted" ]; then
					init_dns_call "$service" restart >/dev/null || return 1
				elif [ "$(init_dns_service_state "$service")" != "$(cat "$WAL/$service-running")" ]; then init_dns_call "$service" "$running" >/dev/null || return 1; fi
				remaining=10
				until [ "$(init_dns_service_state "$service")" = "$(cat "$WAL/$service-running")" ]; do
					[ "$remaining" -gt 0 ] || return 1
					sleep 1; remaining=$((remaining-1))
				done
				[ "$(init_dns_service_state "$service")" = "$(cat "$WAL/$service-running")" ] && [ "$(init_dns_enabled "$service")" = "$(cat "$WAL/$service-enabled")" ] || return 1
				[ "$running" != start ] || init_dns_original_probe "$service" verify || return 1
			done
			case "$(cat "$WAL/routepolicy-enabled")" in 1) enabled=enable ;; 0) enabled=disable ;; *) return 1 ;; esac
			init_dns_call routepolicy "$enabled" || return 1
			init_dns_restore_bookkeeping
			;;
		quarantine-boot)
			printf '%s' '' >"$WAL/dns-boot-quarantined" && sync || return 1
			# Keep both S19 entries absent until S94 explicitly restores real state.
			# A pre-expanded rcS list may still mention the now-missing link paths.
			for service in smartdns dnsmasq; do init_dns_call "$service" disable >/dev/null || return 1; done
			[ "$(init_dns_enabled smartdns)$(init_dns_enabled dnsmasq)" = 00 ]
			;;
		confirm)
			temp="$cache.init-$(cat "$WAL/token")"
			[ ! -L "$temp" ] && { [ ! -e "$temp" ] || [ -f "$temp" ]; } && rm -f "$temp"
			;;
		*) return 1 ;;
	esac
}
