#!/bin/sh

set -u
LIBEXEC=${ROUTEPOLICY_LIBEXEC:-$(dirname "$0")}
. "$LIBEXEC/common"

enabled=$(rp_uci_get main enabled 0)
table=$(rp_uci_get main route_table 200); priority=$(rp_uci_get main rule_priority 12000)
mark=$(rp_uci_get main mark 0x100); mask=$(rp_uci_get main mark_mask 0x100)
lan_if=$(rp_uci_get main lan_interface lan); default_if=$(rp_uci_get main default_interface wan); policy_if=$(rp_uci_get main policy_interface usbwan)
rp_is_bool "$enabled" || enabled=0
rp_uint_between "$table" 1 252 || table=200
rp_uint_between "$priority" 1 32765 || priority=12000
rp_is_mark_bit "$mark" || mark=0x100
rp_is_mark_bit "$mask" || mask=0x100
rp_is_name "$lan_if" 32 || lan_if=lan
rp_is_name "$default_if" 32 || default_if=wan
rp_is_name "$policy_if" 32 || policy_if=usbwan
bool_json() { [ "$1" = 1 ] && printf true || printf false; }

table_present=0; nft list table inet routepolicy >/dev/null 2>&1 && table_present=1
rule_present=0; ip -4 rule show 2>/dev/null | awk -v p="$priority:" -v m="$mark/$mask" -v t="$table" '$1==p&&index($0,m)>0&&($0~("lookup "t"([[:space:]]|$)")||$0~("table "t"([[:space:]]|$)")){f=1}END{exit !f}' && rule_present=1
blackhole=0; ip -4 route show table "$table" 2>/dev/null | grep -Eq '^blackhole default([[:space:]]|$)' && blackhole=1
policy_default=0; ip -4 route show table "$table" 2>/dev/null | grep -Eq '^default([[:space:]]|$)' && policy_default=1
main_default=0; ip -4 route show table main 2>/dev/null | grep -Eq '^default([[:space:]]|$)' && main_default=1
smartdns_fragment=0; rp_smartdns_fragment_loaded "$RP_SMARTDNS_FILE" && smartdns_fragment=1
applied=0; [ -f "$RP_STATE_DIR/applied" ] && applied=1
service_running=0
ubus call service list '{"name":"routepolicy"}' 2>/dev/null | jsonfilter -e '@.routepolicy.instances.*.running' 2>/dev/null | grep -Eq '^(true|1)$' && service_running=1
smartdns_running=0
ubus call service list '{"name":"smartdns"}' 2>/dev/null | jsonfilter -e '@.smartdns.instances.*.running' 2>/dev/null | grep -Eq '^(true|1)$' && smartdns_running=1

set_count() {
	nft list set inet routepolicy "$1" 2>/dev/null | awk '
		/elements = \{/ { inside=1; sub(/^.*elements = \{/,"") }
		inside { text=text " " $0 }
		inside && /\}/ { sub(/\}.*/,"",text); gsub(/^[[:space:]]+|[[:space:]]+$/, "", text); if(text==""){print 0;exit}; print split(text,a,",");exit }
		END { if(!inside) print 0 }' | sed -n '1p'
}
interface_object() {
	iface=$1; device=$(rp_interface_device "$iface" 2>/dev/null) || device=
	address=$(rp_interface_address "$iface" 2>/dev/null) || address=
	online=0; rp_interface_up "$iface" && online=1
	if [ "$online" -eq 1 ]; then message='online'; elif [ -n "$device" ]; then message='device present, interface offline'; else message='interface unavailable'; fi
	printf '{"name":"%s","device":"%s","address":"%s","online":%s,"message":"%s"}' \
		"$(rp_json_escape "$iface")" "$(rp_json_escape "$device")" "$(rp_json_escape "$address")" "$(bool_json "$online")" "$(rp_json_escape "$message")"
}
dpc=$(set_count domain_policy4); ddc=$(set_count domain_default4); spc=$(set_count static_policy4); sdc=$(set_count static_default4)
last_apply=; [ ! -f "$RP_STATE_DIR/last-apply" ] || last_apply=$(sed -n '1p' "$RP_STATE_DIR/last-apply")
last_update=; [ ! -f "$RP_STATE_DIR/last-update" ] || last_update=$(sed -n '1p' "$RP_STATE_DIR/last-update")
last_error=; [ ! -f "$RP_STATE_DIR/last-error" ] || last_error=$(sed -n '1p' "$RP_STATE_DIR/last-error")

if [ "${ROUTEPOLICY_OUTPUT:-text}" = json ]; then
	printf '{"ok":true,"service":{"running":%s,"applied":%s,"enabled":%s},' "$(bool_json "$service_running")" "$(bool_json "$applied")" "$(bool_json "$enabled")"
	printf '"routing":{"real_default":%s,"blackhole":%s,"main_default":%s,"ip_rule":%s,"table":%s},' "$(bool_json "$policy_default")" "$(bool_json "$blackhole")" "$(bool_json "$main_default")" "$(bool_json "$rule_present")" "$table"
	printf '"smartdns":{"running":%s,"fragment_loaded":%s},' "$(bool_json "$smartdns_running")" "$(bool_json "$smartdns_fragment")"
	printf '"interfaces":{"lan":%s,"default":%s,"policy":%s},' "$(interface_object "$lan_if")" "$(interface_object "$default_if")" "$(interface_object "$policy_if")"
	printf '"sets":{"domain_policy4":%s,"domain_default4":%s,"static_policy4":%s,"static_default4":%s},' "$dpc" "$ddc" "$spc" "$sdc"
	printf '"timestamps":{"last_apply":"%s","last_update":"%s"},"last_apply":"%s","last_update":"%s","last_error":"%s",' "$(rp_json_escape "$last_apply")" "$(rp_json_escape "$last_update")" "$(rp_json_escape "$last_apply")" "$(rp_json_escape "$last_update")" "$(rp_json_escape "$last_error")"
	printf '"enabled":%s,"applied":%s,"nft_table":%s,"policy_default":%s,"blackhole_default":%s}\n' "$(bool_json "$enabled")" "$(bool_json "$applied")" "$(bool_json "$table_present")" "$(bool_json "$policy_default")" "$(bool_json "$blackhole")"
else
	printf 'enabled=%s running=%s applied=%s nft_table=%s ip_rule=%s\n' "$enabled" "$service_running" "$applied" "$table_present" "$rule_present"
	printf 'main_default=%s policy_default=%s blackhole=%s smartdns_running=%s smartdns_fragment=%s\n' "$main_default" "$policy_default" "$blackhole" "$smartdns_running" "$smartdns_fragment"
	printf 'sets domain_policy4=%s domain_default4=%s static_policy4=%s static_default4=%s\n' "$dpc" "$ddc" "$spc" "$sdc"
fi
