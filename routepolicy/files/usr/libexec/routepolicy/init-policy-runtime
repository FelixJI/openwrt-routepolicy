#!/bin/sh
# Private apply helpers: one unfinished initialization write, never a success record.
# OpenWrt ash supports function-local variables.
# apply supplies tuple/interface values, work and read_policy_routes; it consumes
# the IPR_* result fields and IPR_ERROR at its public error boundary.
# shellcheck disable=SC2034,SC3043,SC2154

ipr_context() {
	IPR_WAL="$RP_STATE_DIR/init-transaction/current"
	IPR_INTENT="$IPR_WAL/policy-runtime-intent"
	IPR_CONTEXT=0; IPR_ERROR=; IPR_TOKEN=; IPR_ENABLED=0; IPR_CROSSBOOT_EMPTY=0
	[ "${ROUTEPOLICY_WRITER_KIND:-}" = init ] || return 0
	rp_writer_owned || return 1
	if [ -z "${ROUTEPOLICY_INIT_GENERATION:-}" ] && [ ! -e "$IPR_WAL" ] && [ ! -L "$IPR_WAL" ]; then return 0; fi
	for IPR_PATH in "$RP_ETC" "$RP_STATE_DIR" "$RP_STATE_DIR/init-transaction" "$IPR_WAL"; do
		[ -d "$IPR_PATH" ] && [ ! -L "$IPR_PATH" ] || return 1
	done
	if [ -z "${ROUTEPOLICY_INIT_GENERATION:-}" ]; then
		[ -f "$IPR_WAL/phase" ] && [ ! -L "$IPR_WAL/phase" ] || return 1
		IPR_PHASE=$(cat "$IPR_WAL/phase") || return 1
		if [ -e "$IPR_WAL/token" ] || [ -L "$IPR_WAL/token" ]; then
			[ -f "$IPR_WAL/token" ] && [ ! -L "$IPR_WAL/token" ] || return 1
			IPR_TOKEN=$(cat "$IPR_WAL/token") && [ "${#IPR_TOKEN}" -eq 32 ] || return 1
			case "$IPR_TOKEN" in *[!0-9a-f]*) return 1 ;; esac
		fi
		if [ -e "$IPR_WAL/policy-attempted" ] || [ -L "$IPR_WAL/policy-attempted" ]; then
			[ -f "$IPR_WAL/policy-attempted" ] && [ ! -L "$IPR_WAL/policy-attempted" ] && [ -n "${IPR_TOKEN:-}" ] || return 1
			case "$IPR_PHASE" in applying|rolling_back|pending|confirming)
				IPR_ERROR='未完成的初始化 policy writer 缺少 INIT_GENERATION；拒绝按普通 apply 执行'
				return 1 ;;
			esac
		fi
		case "$IPR_PHASE" in applying|rolling_back|pending|confirming|confirmed|rolled_back|expired|prepared) return 0 ;; *) return 1 ;; esac
	fi
	for IPR_NAME in token boot-id phase policy-active policy-attempted; do
		[ -f "$IPR_WAL/$IPR_NAME" ] && [ ! -L "$IPR_WAL/$IPR_NAME" ] || return 1
	done
	IPR_TOKEN=$(cat "$IPR_WAL/token") && IPR_WAL_BOOT=$(cat "$IPR_WAL/boot-id") &&
		IPR_BOOT=$(cat "$RP_ROOT/proc/sys/kernel/random/boot_id") && IPR_ACTIVE=$(cat "$IPR_WAL/policy-active") || return 1
	[ "${#IPR_TOKEN}" -eq 32 ] && [ "$IPR_TOKEN" = "$ROUTEPOLICY_INIT_GENERATION" ] || return 1
	case "$IPR_TOKEN" in *[!0-9a-f]*) return 1 ;; esac
	for IPR_ID in "$IPR_BOOT" "$IPR_WAL_BOOT"; do
		printf '%s\n' "$IPR_ID" | grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' || return 1
	done
	case "$IPR_ACTIVE" in 0|1) ;; *) return 1 ;; esac
	IPR_PHASE=$(cat "$IPR_WAL/phase") || return 1
	case "$IPR_PHASE:${ROUTEPOLICY_INIT_RESTORE:-0}" in applying:0|rolling_back:1) ;; *) return 1 ;; esac
	if ! rp_init_routing_id_between "$(rp_uci_get main route_table 200)" 1 252 || ! rp_init_routing_id_between "$(rp_uci_get main rule_priority 12000)" 1 32765; then
		IPR_ERROR='初始化 route_table/rule_priority 必须为无前导零的十进制整数；未改变配置或实际表号'
		return 1
	fi
	IPR_CONTEXT=1
}

# Normalize only the three route forms written by apply. Unknown attributes or
# duplicate route keys are conflicts, not material to replay as command text.
ipr_normalize_routes() {
	awk '
	function ip(s,a,n,i){n=split(s,a,".");if(n!=4)return 0;for(i=1;i<=4;i++)if(a[i]!~/^[0-9]+$/||a[i]>255)return 0;return 1}
	function prefix(s,a,n){if(s=="default")return 1;n=split(s,a,"/");return n==2&&ip(a[1])&&a[2]~/^[0-9]+$/&&a[2]<=32}
	NF {
		kind="unicast";p=$1;i=2;d=g=s="-";m=0;scope="global";proto="boot"
		if(p=="blackhole"){kind=p;p=$2;i=3}
		if(ip(p))p=p "/32"
		for(;i<=NF;i++) {
			k=$i
			if(k=="linkdown")continue
			if(i==NF||seen[k]++){bad=1;break}
			v=$(++i)
			if(k=="dev")d=v;else if(k=="via")g=v;else if(k=="src")s=v
			else if(k=="metric")m=v;else if(k=="scope")scope=v;else if(k=="proto")proto=v;else bad=1
		}
		for(k in seen)delete seen[k]
		if(!prefix(p)||m!~/^[0-9]+$/||proto!="boot")bad=1
		if(kind=="blackhole") {if(p!="default"||d!="-"||g!="-"||s!="-"||m!=32760||scope!="global")bad=1}
		else {
			if(d!~/^[A-Za-z0-9_.:-]+$/||d=="-"||length(d)>32||m!=10)bad=1
			if(p=="default") {if(s!="-"||(g!="-"&&!ip(g))||(scope!="global"&&scope!="link"))bad=1}
			else if(g!="-"||!ip(s)||scope!="link")bad=1
		}
		if(keys[p,m]++)bad=1
		print kind "\t" p "\t" d "\t" g "\t" s "\t" m "\t" scope "\t" proto
	} END{exit bad}'
}

ipr_read_live() {
	local raw relevant mark_value mask_value
	raw=$(ip -4 -N rule show) || return 1
	IPR_RULES_RAW=$raw
	relevant=$(printf '%s\n' "$raw" | awk -v priority="$IPR_PRIORITY:" -v t="$IPR_TABLE" '
		NF&&$1!~/^[0-9]+:$/{bad=1}
		{used=($1==priority);for(i=1;i<NF;i++)if(($i=="lookup"||$i=="table")&&$(i+1)==t)used=1
		 if(used){if(NF!=7||$1!=priority||$2!="from"||$3!="all"||$4!="fwmark"||$6!~/^(lookup|table)$/||$7!=t)bad=1;else print $5}}
		END{exit bad}') || return 1
	IPR_RULE_NOW=0
	if [ -n "$relevant" ]; then
		[ "$(printf '%s\n' "$relevant" | wc -l)" -eq 1 ] || return 1
		mark_value=${relevant%/*}; mask_value=${relevant#*/}
		rp_is_hex32 "$mark_value" && rp_is_hex32 "$mask_value" &&
			[ "$((mark_value))" -eq "$((IPR_MARK))" ] && [ "$((mask_value))" -eq "$((IPR_MASK))" ] || return 1
		IPR_RULE_NOW=1
	fi
	read_policy_routes "$IPR_TABLE" || return 1
	# A pipeline must retain the parser failure as well as sort successful rows.
	IPR_ROUTES_NOW=$(printf '%s\n' "$policy_routes" | ipr_normalize_routes) || return 1
	IPR_ROUTES_NOW=$(printf '%s\n' "$IPR_ROUTES_NOW" | sed '/^$/d' | LC_ALL=C sort)
}

ipr_catalog() {
	local entries
	IPR_CATALOG_NOW=0; IPR_GENERATION_NOW=-
	[ -e "$RP_ACTIVE_DIR" ] || [ -L "$RP_ACTIVE_DIR" ] || return 0
	[ -d "$RP_ACTIVE_DIR" ] && [ ! -L "$RP_ACTIVE_DIR" ] || return 1
	entries=$(find "$RP_ACTIVE_DIR" -mindepth 1 ! -type f) && [ -z "$entries" ] || return 1
	entries=$(find "$RP_ACTIVE_DIR" -mindepth 1 ! -name generation ! -name domain-policy.list ! -name domain-default.list) && [ -z "$entries" ] || return 1
	for IPR_NAME in generation domain-policy.list domain-default.list; do
		[ -f "$RP_ACTIVE_DIR/$IPR_NAME" ] && [ ! -L "$RP_ACTIVE_DIR/$IPR_NAME" ] || return 1
	done
	IPR_GENERATION_NOW=$(cat "$RP_ACTIVE_DIR/generation") || return 1
	case "$IPR_GENERATION_NOW" in ''|*[!A-Za-z0-9_.-]*|?????????????????????????????????????????????????????????????????*) return 1 ;; esac
	IPR_CATALOG_NOW=1
}

ipr_read_nft() {
	local tables
	tables=$(nft list tables) || return 1
	IPR_NFT_NOW=$(printf '%s\n' "$tables" | awk '
		NF&&(NF!=3||$1!="table"){bad=1}
		$3=="routepolicy"{if($2!="inet"||found++)bad=1}
		END{if(bad)exit 1;print found?1:0}') || return 1
	[ "$IPR_NFT_NOW" = 0 ] || nft list table inet routepolicy >/dev/null 2>&1
}

ipr_applied() {
	IPR_APPLIED_NOW=0; IPR_APPLIED_IF=-
	[ -e "$RP_STATE_DIR/applied" ] || [ -L "$RP_STATE_DIR/applied" ] || return 0
	[ -f "$RP_STATE_DIR/applied" ] && [ ! -L "$RP_STATE_DIR/applied" ] || return 1
	awk -F= '$1~/^(schema|route_table|rule_priority|mark|mark_mask|policy_interface|policy_device|policy_cidr)$/{if(NF!=2||seen[$1]++)bad=1;n++}END{exit bad||n!=8}' "$RP_STATE_DIR/applied" || return 1
	[ "$(rp_state_get schema)" = 1 ] && [ "$(rp_state_get route_table)" = "$IPR_TABLE" ] &&
		[ "$(rp_state_get rule_priority)" = "$IPR_PRIORITY" ] && [ "$(rp_state_get mark)" = "$IPR_MARK" ] && [ "$(rp_state_get mark_mask)" = "$IPR_MASK" ] || return 1
	IPR_APPLIED_IF=$(rp_state_get policy_interface) && rp_is_name "$IPR_APPLIED_IF" 32 || return 1
	IPR_APPLIED_NOW=1
}

ipr_validate_rows() {
	awk -F '\t' '
		NR==1 {if(NF!=11||$1!="routepolicy-init-runtime-v1")bad=1;next}
		$1=="before-rule"{if(NF!=2||$2!~/^[01]$/||rule++)bad=1;next}
		$1=="before-nft"{if(NF!=2||$2!~/^[01]$/||nft++)bad=1;next}
		$1=="catalog-before"{if(NF!=3||$2!~/^[01]$/||catalog++)bad=1;next}
		$1=="applied-before"{if(NF!=3||$2!~/^[01]$/||applied++)bad=1;next}
		$1~/^(before-route|planned-route)$/ {if(NF!=9||seen[$1,$3,$7]++)bad=1;routes[$1]++;next}
		{bad=1}
		END{exit bad||NR<5||rule!=1||nft!=1||catalog!=1||applied!=1||routes["before-route"]>3||routes["planned-route"]>3}' "$IPR_INTENT" || return 1
	IPR_BEFORE_ROUTES=$(sed -n 's/^before-route	//p' "$IPR_INTENT")
	IPR_PLANNED_ROUTES=$(sed -n 's/^planned-route	//p' "$IPR_INTENT")
	# Reuse the narrow native-output validator by rendering typed fields, never eval.
	local rows canonical native
	for rows in "$IPR_BEFORE_ROUTES" "$IPR_PLANNED_ROUTES"; do
		native=$(printf '%s\n' "$rows" | ipr_rows_native) || return 1
		canonical=$(printf '%s\n' "$native" | ipr_normalize_routes) || return 1
		canonical=$(printf '%s\n' "$canonical" | sed '/^$/d' | LC_ALL=C sort)
		[ "$canonical" = "$(printf '%s\n' "$rows" | sed '/^$/d' | LC_ALL=C sort)" ] || return 1
	done
}

ipr_rows_native() {
	awk -F '\t' 'NF {
		if(NF!=8){bad=1;next}
		line=($1=="blackhole"?"blackhole ":"") $2
		if($3!="-")line=line " dev " $3;if($4!="-")line=line " via " $4;if($5!="-")line=line " src " $5
		print line " metric " $6 " scope " $7 " proto " $8
	}END{exit bad}'
}

ipr_matches_plan() {
	printf '%s\n' "$IPR_ROUTES_NOW" | awk -v before="$IPR_BEFORE_ROUTES" -v planned="$IPR_PLANNED_ROUTES" '
		BEGIN{n=split(before,a,"\n");for(i=1;i<=n;i++)ok[a[i]]=1;n=split(planned,a,"\n");for(i=1;i<=n;i++)ok[a[i]]=1}
		NF&&!($0 in ok){bad=1}END{exit bad}'
}

ipr_delete_route() {
	local kind=$1 prefix=$2 device=$3 gateway=$4 address=$5 metric=$6
	if [ "$kind" = blackhole ]; then ip -4 route del blackhole default table "$IPR_TABLE" metric "$metric"
	elif [ "$prefix" != default ]; then ip -4 route del table "$IPR_TABLE" "$prefix" dev "$device" scope link src "$address" metric "$metric"
	elif [ "$gateway" != - ]; then ip -4 route del table "$IPR_TABLE" default via "$gateway" dev "$device" metric "$metric"
	else ip -4 route del table "$IPR_TABLE" default dev "$device" metric "$metric"; fi
}

ipr_recover() {
	IPR_RECOVERED=0; IPR_STALE=0
	[ -e "$IPR_INTENT" ] || [ -L "$IPR_INTENT" ] || return 0
	[ "$IPR_CONTEXT" = 1 ] && [ "$IPR_PHASE" = rolling_back ] && [ -f "$IPR_INTENT" ] && [ ! -L "$IPR_INTENT" ] || return 1
	ipr_validate_rows || return 1
	local version token boot wal_boot active policy_if kind prefix device gateway address metric scope proto row before_key
	IFS="$(printf '\t')" read -r version token boot wal_boot active IPR_TABLE IPR_PRIORITY IPR_MARK IPR_MASK policy_if IPR_WRITE_MODE <"$IPR_INTENT" || return 1
	[ "$version" = routepolicy-init-runtime-v1 ] || return 1
	[ "$token" = "$IPR_TOKEN" ] && [ "$wal_boot" = "$IPR_WAL_BOOT" ] && [ "$active" = "$IPR_ACTIVE" ] && rp_is_name "$policy_if" 32 || return 1
	case "$IPR_WRITE_MODE" in forward|restore) ;; *) return 1 ;; esac
	if [ "$IPR_ACTIVE" = 0 ]; then
		[ "$(awk -F '\t' '$1=="before-rule"{print $2}' "$IPR_INTENT")" = 0 ] && [ -z "$IPR_BEFORE_ROUTES" ] || return 1
		[ "$(awk -F '\t' '$1=="before-nft"{print $2}' "$IPR_INTENT")" = 0 ] || return 1
	fi
	local catalog_before generation_before
	catalog_before=$(awk -F '\t' '$1=="catalog-before"{print $2}' "$IPR_INTENT")
	generation_before=$(awk -F '\t' '$1=="catalog-before"{print $3}' "$IPR_INTENT")
	if [ "$catalog_before" = 0 ]; then [ "$generation_before" = - ] || return 1
	else
		case "$generation_before" in ''|*[!A-Za-z0-9_.-]*|?????????????????????????????????????????????????????????????????*) return 1 ;; esac
	fi
	local applied_before applied_if_before
	applied_before=$(awk -F '\t' '$1=="applied-before"{print $2}' "$IPR_INTENT")
	applied_if_before=$(awk -F '\t' '$1=="applied-before"{print $3}' "$IPR_INTENT")
	if [ "$applied_before" = 0 ]; then [ "$applied_if_before" = - ] || return 1
	else rp_is_name "$applied_if_before" 32 || return 1; fi
	if [ "$IPR_WRITE_MODE:$IPR_ACTIVE" = forward:1 ]; then
		[ "$applied_before" = 1 ] &&
			[ "$(awk -F '\t' '$1=="before-rule"{print $2}' "$IPR_INTENT")" = 1 ] &&
			[ "$(awk -F '\t' '$1=="before-nft"{print $2}' "$IPR_INTENT")" = 1 ] || return 1
	fi
	printf '%s\n' "$boot" | grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' || return 1
	if ! rp_init_routing_id_between "$IPR_TABLE" 1 252 || ! rp_init_routing_id_between "$IPR_PRIORITY" 1 32765; then
		IPR_ERROR='初始化写前意图含非规范十进制 table/priority；已保留对象和意图'
		return 1
	fi
	rp_is_mark_bit "$IPR_MARK" && [ "$IPR_MARK" = "$IPR_MASK" ] || return 1
	[ "$IPR_WRITE_MODE" != forward ] || [ "$boot" = "$wal_boot" ] || return 1
	if [ "$boot" != "$IPR_BOOT" ]; then IPR_STALE=1; return 0; fi
	ipr_applied || return 1
	if [ "$IPR_APPLIED_NOW" = 1 ] && [ "$IPR_APPLIED_IF" != "$policy_if" ]; then
		[ "$applied_before" = 1 ] && [ "$IPR_APPLIED_IF" = "$applied_if_before" ] || return 1
	fi
	ipr_catalog || return 1
	if [ "$IPR_CATALOG_NOW" = 1 ] && [ "$IPR_GENERATION_NOW" != "$IPR_TOKEN" ]; then
		[ "$catalog_before" = 1 ] && [ "$IPR_GENERATION_NOW" = "$generation_before" ] || return 1
	fi
	ipr_read_nft || return 1
	[ "$(awk -F '\t' '$1=="before-nft"{print $2}' "$IPR_INTENT")" = 0 ] || [ "$IPR_NFT_NOW" = 1 ] || return 1
	ipr_read_live && ipr_matches_plan || return 1
	# Validate every live difference before issuing the first compensation command.
	while IFS="$(printf '\t')" read -r kind prefix device gateway address metric scope proto; do
		[ -n "$kind" ] || continue
		row=$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s' "$kind" "$prefix" "$device" "$gateway" "$address" "$metric" "$scope" "$proto")
		printf '%s\n' "$IPR_PLANNED_ROUTES" | grep -Fxq "$row" || continue
		if [ "$IPR_ACTIVE" = 1 ]; then
			[ "$kind" = unicast ] && [ "$prefix" != default ] || continue
			before_key=$(printf '%s\n' "$IPR_BEFORE_ROUTES" | awk -F '\t' -v p="$prefix" -v m="$metric" 'NF&&$2==p&&$6==m{print 1}')
			[ -z "$before_key" ] || continue
		fi
		ipr_delete_route "$kind" "$prefix" "$device" "$gateway" "$address" "$metric" || return 1
	done <<EOF
$IPR_ROUTES_NOW
EOF
	if [ "$IPR_ACTIVE" = 0 ] && [ "$IPR_RULE_NOW" = 1 ]; then
		ip -4 rule del priority "$IPR_PRIORITY" fwmark "$IPR_MARK/$IPR_MASK" lookup "$IPR_TABLE" || return 1
	fi
	ipr_read_live && ipr_matches_plan || return 1
	if [ "$IPR_ACTIVE" = 0 ]; then [ "$IPR_RULE_NOW" = 0 ] && [ -z "$IPR_ROUTES_NOW" ] || return 1; fi
	IPR_RECOVERED=1
}

ipr_prepare() {
	IPR_ENABLED=0
	[ "$IPR_CONTEXT" = 1 ] || return 0
	local stage="$IPR_INTENT.new" before catalog generation old_device old_cidr applied_before applied_if_before before_nft
	if ! rp_init_routing_id_between "$table" 1 252 || ! rp_init_routing_id_between "$priority" 1 32765; then
		IPR_ERROR='初始化 route_table/rule_priority 必须为无前导零的十进制整数；未执行内核写入'
		return 1
	fi
	if [ "$IPR_RECOVERED" = 1 ]; then
		[ "$IPR_TABLE:$IPR_PRIORITY:$IPR_MARK:$IPR_MASK" = "$table:$priority:$mark:$mask" ] || return 1
	fi
	IPR_TABLE=$table; IPR_PRIORITY=$priority; IPR_MARK=$mark; IPR_MASK=$mask
	ipr_applied || return 1
	applied_before=$IPR_APPLIED_NOW; applied_if_before=$IPR_APPLIED_IF
	ipr_catalog || return 1
	catalog=$IPR_CATALOG_NOW; generation=$IPR_GENERATION_NOW
	ipr_read_live && ipr_read_nft || return 1
	before_nft=$IPR_NFT_NOW
	# A failed earlier table read must not turn an existing producer table into a
	# fresh-table candidate, even if a later read succeeds.
	if [ "$before_nft" = 1 ]; then
		[ "$incremental" = 1 ] || [ "$live_snapshot" = retained ] || return 1
	else [ "$incremental" = 0 ] && [ -z "$live_snapshot" ] || return 1; fi
	if [ "$IPR_RECOVERED" = 1 ]; then ipr_matches_plan || return 1
	elif [ "${IPR_CROSSBOOT_EMPTY:-0}" = 1 ]; then [ "$IPR_RULE_NOW" = 0 ] && [ -z "$IPR_ROUTES_NOW" ] && [ "$before_nft" = 0 ] || return 1
	elif [ "$IPR_ACTIVE" = 0 ]; then
		[ "$IPR_RULE_NOW" = 0 ] && [ -z "$IPR_ROUTES_NOW" ] && [ "$before_nft" = 0 ] || return 1
	else
		[ "$IPR_APPLIED_NOW" = 1 ] && [ "$before_nft" = 1 ] || return 1
		[ "$(rp_state_get route_table)" = "$table" ] && [ "$(rp_state_get rule_priority)" = "$priority" ] &&
			[ "$(rp_state_get mark)" = "$mark" ] && [ "$(rp_state_get mark_mask)" = "$mask" ] && [ "$IPR_RULE_NOW" = 1 ] || return 1
		old_device=$(rp_state_get policy_device) && old_cidr=$(rp_state_get policy_cidr) || return 1
		[ -z "$old_device" ] || rp_is_device "$old_device" || return 1
		printf '%s\n' "$IPR_ROUTES_NOW" | awk -F '\t' -v device="$old_device" -v cidr="$old_cidr" '
			NF&&$1=="unicast" {if($3!=device||($2!="default"&&$2!=cidr))bad=1}END{exit bad}' || return 1
	fi
	before=$IPR_ROUTES_NOW
	printf '%s\n' "$policy_routes" >"$work/routes.previous" || return 1
	printf '%s\n' "$IPR_RULES_RAW" >"$work/rules.previous" || return 1
	policy_up=0; if rp_interface_up "$policy_if"; then policy_up=1; fi
	policy_cidr=
	if [ "$policy_up" = 1 ]; then
		rp_is_device "$policy_device" && rp_is_ipv4 "$policy_address" && rp_uint_between "$policy_prefix" 0 32 || return 1
		[ -z "$policy_gateway" ] || rp_is_ipv4 "$policy_gateway" || return 1
		policy_cidr=$(rp_network_cidr "$policy_address" "$policy_prefix") || return 1
	fi
	IPR_PLANNED_ROUTES=$(
		[ "$strict" != 1 ] || printf 'blackhole\tdefault\t-\t-\t-\t32760\tglobal\tboot\n'
		if [ "$policy_up" = 1 ]; then
			printf 'unicast\t%s\t%s\t-\t%s\t10\tlink\tboot\n' "$policy_cidr" "$policy_device" "$policy_address"
			if [ -n "$policy_gateway" ]; then printf 'unicast\tdefault\t%s\t%s\t-\t10\tglobal\tboot\n' "$policy_device" "$policy_gateway"
			else printf 'unicast\tdefault\t%s\t-\t-\t10\tlink\tboot\n' "$policy_device"; fi
		fi
	)
	IPR_WRITE_MODE=forward; [ "${ROUTEPOLICY_INIT_RESTORE:-0}" != 1 ] || IPR_WRITE_MODE=restore
	[ ! -L "$stage" ] && { [ ! -e "$stage" ] || [ -f "$stage" ]; } && rm -f "$stage" || return 1
	[ ! -L "$IPR_INTENT" ] && { [ ! -e "$IPR_INTENT" ] || [ "$IPR_RECOVERED" = 1 ] || [ "$IPR_STALE" = 1 ]; } || return 1
	(
		umask 077; set -C
		{
			printf 'routepolicy-init-runtime-v1\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$IPR_TOKEN" "$IPR_BOOT" "$IPR_WAL_BOOT" "$IPR_ACTIVE" "$table" "$priority" "$mark" "$mask" "$policy_if" "$IPR_WRITE_MODE" || exit 1
			printf 'before-rule\t%s\ncatalog-before\t%s\t%s\n' "$IPR_RULE_NOW" "$catalog" "$generation" || exit 1
			printf 'before-nft\t%s\n' "$before_nft" || exit 1
			printf 'applied-before\t%s\t%s\n' "$applied_before" "$applied_if_before" || exit 1
			if [ -n "$before" ]; then printf '%s\n' "$before" | sed 's/^/before-route\t/' || exit 1; fi
			if [ -n "$IPR_PLANNED_ROUTES" ]; then printf '%s\n' "$IPR_PLANNED_ROUTES" | sed 's/^/planned-route\t/' || exit 1; fi
		} >"$stage"
	) && ( IPR_INTENT="$stage"; ipr_validate_rows ) && sync && mv -f "$stage" "$IPR_INTENT" && sync || return 1
	IPR_ENABLED=1
	IPR_BEFORE_ROUTES=$before
}

ipr_remove_old_connected() {
	local kind prefix device gateway address metric scope proto
	while IFS="$(printf '\t')" read -r kind prefix device gateway address metric scope proto; do
		[ "$kind" = unicast ] && [ "$prefix" = "$old_policy_cidr" ] && [ "$device" = "$old_policy_device" ] || continue
		ipr_delete_route "$kind" "$prefix" "$device" "$gateway" "$address" "$metric" || return 1
	done <<EOF
$IPR_BEFORE_ROUTES
EOF
}

ipr_policy_online() {
	if [ "$IPR_ENABLED" = 1 ]; then [ "$policy_up" = 1 ]; else rp_interface_up "$policy_if"; fi
}

# Old interrupted writers have no provenance. Prove only a globally empty policy
# runtime; unrelated custom objects are evidence gaps, never claimed as ours.
ipr_legacy_empty() {
	local rules routes tables
	rules=$(ip -4 -N rule show) && routes=$(ip -4 -N route show table all) && tables=$(nft list tables) || return 1
	printf '%s\n' "$rules" | awk 'NF&&!(NF==5&&$2=="from"&&$3=="all"&&$4=="lookup"&&(($1=="0:"&&$5==255)||($1=="32766:"&&$5==254)||($1=="32767:"&&$5==253))){bad=1}END{exit bad}' || return 1
	printf '%s\n' "$routes" | awk '{for(i=1;i<=NF;i++)if($i=="table"&&(i==NF||$(i+1)!~/^(253|254|255)$/))bad=1}END{exit bad}' || return 1
	printf '%s\n' "$tables" | awk 'NF&&(NF!=3||$1!="table"||$3=="routepolicy"){bad=1}END{exit bad}'
}

ipr_finish() {
	[ "$IPR_CONTEXT" = 1 ] || return 0
	[ "${IPR_ENABLED:-0}" = 1 ] || [ "$IPR_RECOVERED" = 1 ] || [ "$IPR_STALE" = 1 ] || return 0
	[ -f "$IPR_INTENT" ] && [ ! -L "$IPR_INTENT" ] || return 1
	rm "$IPR_INTENT" && [ ! -e "$IPR_INTENT" ] && [ ! -L "$IPR_INTENT" ] && sync
}
