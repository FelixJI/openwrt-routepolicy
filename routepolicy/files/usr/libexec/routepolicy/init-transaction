#!/bin/sh
# Initialization owns only its journaled fields; never restore whole UCI packages.
# OpenWrt ash supports function-local variables.
# shellcheck disable=SC3043
set -u
LIBEXEC=${ROUTEPOLICY_LIBEXEC:-$(dirname "$0")}
. "$LIBEXEC/common"
umask 077
TX="$RP_STATE_DIR/init-transaction"
WAL="$TX/current"
TAB=$(printf '\t')
PACKAGES='network dhcp firewall routepolicy smartdns'
. "$LIBEXEC/init-dns"

fail() { rp_output_error "init-${operation:-transaction}" "$*"; exit 1; }
phase() { printf '%s\n' "$1" >"$WAL/phase.new" && mv "$WAL/phase.new" "$WAL/phase" && sync; }
read_phase() { cat "$WAL/phase" 2>/dev/null || printf absent; }
safe_dir() {
	[ ! -L "$1" ] || fail '事务目录不能是符号链接'
	[ ! -e "$1" ] || [ -d "$1" ] || fail '事务目录类型非法'
	mkdir -p "$1" && chmod 700 "$1" || fail '无法创建受限事务目录'
}
lock() {
	rp_writer_enter init || fail '统一写入门禁忙、owner 失效或已有 writer 未退出'
	for parent in "$RP_ETC" "$RP_STATE_DIR"; do
		[ ! -L "$parent" ] && { [ ! -e "$parent" ] || [ -d "$parent" ]; } || fail '事务父目录不安全'
	done
	mkdir -p "$RP_STATE_DIR" || fail '不能创建事务父目录'
	safe_dir "$TX"
	safe_dir "$TX/confirmed"
	# Upgrade the existing archive layout, never duplicate an ownership ledger.
	for archive_pointer in active source; do
		if [ -f "$TX/$archive_pointer" ] && [ ! -L "$TX/$archive_pointer" ]; then
			archive_token=$(cat "$TX/$archive_pointer") || fail '不能读取确认归档指针'
			[ "${#archive_token}" = 32 ] || fail '确认归档指针非法'
			case "$archive_token" in *[!0-9a-f]*) fail '确认归档指针非法' ;; esac
			archive_old="$TX/confirmed-$archive_token"; archive_new="$TX/confirmed/$archive_token"
			if [ -d "$archive_old" ] && [ ! -e "$archive_new" ]; then
				[ ! -L "$archive_old" ] && [ ! -L "$archive_new" ] && [ "$(cat "$archive_old/token")" = "$archive_token" ] && [ "$(cat "$archive_old/phase")" = confirmed ] || fail '旧确认归档非法'
				mv "$archive_old" "$archive_new" && sync || fail '不能迁移旧确认归档'
			fi
			if [ -d "$archive_new" ] && [ ! -L "$archive_new" ]; then
				find "$archive_new" -type d -exec chmod 700 '{}' + && find "$archive_new" -type f -exec chmod 600 '{}' + || fail '不能恢复确认记录的最小权限'
			fi
		fi
	done
	[ ! -L "$TX/lock" ] || fail '事务锁不是安全文件'
	[ ! -L "$WAL" ] && [ ! -L "$TX/previous" ] || fail '事务记录路径不安全'
	# Restore the previous terminal/prepared generation if power failed during promotion.
	if [ ! -e "$WAL" ] && [ -d "$TX/previous" ]; then
		mv "$TX/previous" "$WAL" && sync || fail '不能恢复准备事务记录'
	fi
	prepared_finish_locked || fail 'prepared 记录不能证明零变更；已保留候选与门禁'
	if [ "${operation:-}" = recover-early ]; then
		case "$(read_phase)" in confirmed|confirming)
			if init_dns_managed; then init_dns_coordinate quarantine-boot || fail '不能隔离已确认或提升中的 DNS 自启动'; fi ;;
		esac
	fi
	if [ -e "$TX/active" ] || [ -L "$TX/active" ]; then rp_init_active_record >/dev/null || fail '已确认接管合同路径或内容不安全'; fi
	# Recover an interrupted confirmation before any caller may consume active.
	case "$(read_phase)" in
		confirming) active_publish || fail '接管合同提升中断；保留确认记录等待恢复' ;;
		confirmed)
			if init_dns_owned; then active_publish || fail '不能收敛已有确认接管合同'; fi ;;
	esac
	declaration_confirmed_finish || fail '网络确认与声明提交点尚未收敛'
	if [ -e "$TX/active" ] || [ -L "$TX/active" ]; then rp_init_active_record >/dev/null || fail '已确认接管合同路径或内容不安全'; fi
}
declaration_confirmed_finish() {
	[ "$(read_phase)" = confirmed ] || return 0
	[ -f "$TX/declarations/init-token" ] && [ ! -L "$TX/declarations/init-token" ] || return 0
	[ "$(cat "$TX/declarations/init-token")" = "$(cat "$WAL/token")" ] || return 0
	case "$(cat "$TX/declarations/phase" 2>/dev/null)" in committed) return 0 ;; installed) ;; *) return 1 ;; esac
	printf 'committed\n' >"$TX/declarations/phase.new" && sync && mv "$TX/declarations/phase.new" "$TX/declarations/phase" && sync
}
prepared_finish_locked() {
	[ "$(read_phase)" = prepared ] || return 0
	prepared_reason=
	if [ "${operation:-}" = recover ]; then prepared_reason=cancelled-unapplied
	elif [ -f "$WAL/prepared-boot-id" ] && [ ! -L "$WAL/prepared-boot-id" ]; then
		prepared_boot=$(cat "$WAL/prepared-boot-id") && prepared_running_boot=$(cat "$RP_ROOT/proc/sys/kernel/random/boot_id") || return 1
		[ -n "$prepared_boot" ] && [ -n "$prepared_running_boot" ] || return 1
		[ "$prepared_boot" = "$prepared_running_boot" ] || prepared_reason=boot-changed
	fi
	[ -n "$prepared_reason" ] || return 0
	[ ! -L "$WAL/fields" ] && { [ ! -e "$WAL/fields" ] || [ -d "$WAL/fields" ]; } || return 1
	if [ -d "$WAL/fields" ]; then [ -z "$(find "$WAL/fields" -name attempted)" ] || return 1; fi
	for prepared_marker in link-attempted dns-service-attempted dns-attempted policy-attempted dns90-attempted dns-cache-move dns-boot-quarantined stage; do
		[ ! -e "$WAL/$prepared_marker" ] && [ ! -L "$WAL/$prepared_marker" ] || return 1
	done
	# No resource was touched: invalidate the candidate, never run rollback/service writers.
	printf '%s\n' "$prepared_reason" >"$WAL/prepared-expired-reason" && phase expired
}
origin_validate() {
	# The same typed field journal serves rollback and eventual explicit exit.
	[ -d "$1" ] && [ ! -L "$1" ] && [ -z "$(find "$1" -type l)" ] || return 1
	[ "$(cat "$1/schema" 2>/dev/null)" = 1 ] || return 1
	local n i entry key keys=''
	n=$(cat "$1/count") && rp_uint_between "$n" 1 2048 || return 1
	i=0
	while [ "$i" -lt "$n" ]; do
		i=$((i+1)); entry="$1/fields/$i"
		for key in key existed old type expected expected-type attempted; do [ -f "$entry/$key" ] && [ ! -L "$entry/$key" ] || return 1; done
		key=$(cat "$entry/key") || return 1
		case "$keys" in *"|$key|"*) return 1 ;; esac; keys="$keys|$key|"
		case "$(cat "$entry/existed"):$(cat "$entry/type")" in 0:scalar|1:scalar|1:list) ;; *) return 1 ;; esac
		case "$(cat "$entry/expected-type")" in 0|scalar|list) ;; *) return 1 ;; esac
		printf 'set\t%s\t%s\n' "$key" "$(cat "$entry/expected")" | plan_valid /dev/stdin || return 1
	done
}
origin_publish() {
	local stage=$1 prior source n i entry key match dest item origin_index=''
	prior=$(rp_init_active_record) || prior=
	if [ -n "$prior" ] && [ -d "$prior/origin" ]; then
		origin_validate "$prior/origin" || return 1
		cp -pR "$prior/origin" "$stage/origin" || return 1
	else
		mkdir "$stage/origin" "$stage/origin/fields" || return 1
		printf '1\n' >"$stage/origin/schema"; printf '0\n' >"$stage/origin/count"
		# Earlier versions discarded intermediate first writes; never invent them.
		source=$(rp_init_source_record) || source=
		if [ -n "$prior" ] && [ "$prior" != "$source" ]; then printf 'legacy-confirmation-history\n' >"$stage/origin/incomplete"; fi
		if [ -n "$source" ]; then
			[ -d "$source/fields" ] && [ ! -L "$source/fields" ] && [ -z "$(find "$source/fields" -type l)" ] || return 1
			cp -pR "$source/fields/." "$stage/origin/fields/" && cp "$source/count" "$stage/origin/count" || return 1
		fi
		for item in smartdns-enabled smartdns-running dnsmasq-enabled dnsmasq-running routepolicy-enabled policy-active dns-file-old dns-file-absent dns90-old dns90-absent smartdns-listeners dnsmasq-listeners; do
			if [ -n "$source" ] && [ -f "$source/$item" ]; then [ ! -L "$source/$item" ] && cp -p "$source/$item" "$stage/origin/$item" || return 1
			elif [ -f "$WAL/$item" ]; then cp -p "$WAL/$item" "$stage/origin/$item" || return 1; fi
		done
	fi
	n=$(cat "$stage/origin/count") && rp_uint_between "$n" 0 2048 || return 1
	i=0
	while [ "$i" -lt "$n" ]; do
		i=$((i+1)); dest="$stage/origin/fields/$i"
		origin_index="$origin_index$(cat "$dest/key")$TAB${dest##*/}
"
	done
	i=0
	while [ "$i" -lt "$(cat "$WAL/count")" ]; do
		i=$((i+1)); entry="$WAL/fields/$i"; key=$(cat "$entry/key") || return 1
		match=$(printf '%s' "$origin_index" | awk -F '\t' -v key="$key" '$1==key{print $2;exit}') || return 1
		if [ -z "$match" ]; then
			n=$((n+1)); [ "$n" -le 2048 ] || return 1
			match="$stage/origin/fields/$n"; cp -pR "$entry" "$match" || return 1
		else
			match="$stage/origin/fields/$match"
			cp "$entry/expected" "$match/expected" && cp "$entry/expected-type" "$match/expected-type" || return 1
		fi
	done
	printf '%s\n' "$n" >"$stage/origin/count" || return 1
	for item in dns-file-new dns90-new; do
		[ ! -f "$WAL/$item" ] || cp -p "$WAL/$item" "$stage/origin/$item" || return 1
	done
	origin_validate "$stage/origin"
}
exit_check() {
	local record=$1 n i entry key present type value expected old missing=0 owned_keys='' child service state desired managed
	origin_validate "$record/origin" || { printf 'invalid-origin\n'; return 1; }
	[ ! -f "$record/origin/incomplete" ] || { cat "$record/origin/incomplete"; return 1; }
	no_pending || { printf 'pending-uci\n'; return 1; }
	n=$(cat "$record/origin/count"); i=0
	while [ "$i" -lt "$n" ]; do i=$((i+1)); owned_keys="$owned_keys|$(cat "$record/origin/fields/$i/key")|"; done
	i=0
	while [ "$i" -lt "$n" ]; do
		i=$((i+1)); entry="$record/origin/fields/$i"; key=$(cat "$entry/key")
		present=0; value=; type=0
		if read_current "$key"; then present=1; value=$FIELD_VALUE; type=$FIELD_TYPE
		elif [ "$?" != 1 ]; then printf 'unreadable:%s\n' "$key"; missing=1; continue; fi
		expected=$(cat "$entry/expected"); old=$(cat "$entry/old")
		case "$key:$(cat "$entry/existed")" in
			*.*.*:*) ;;
			*:0)
				for child in $(uci_committed show "$key" 2>/dev/null | sed 's/=.*//'); do
					child="${key%%.*}.${child#*.}"
					case "$owned_keys" in *"|$child|"*) ;; *) printf 'unknown-child:%s\n' "$child"; missing=1 ;; esac
				done ;;
		esac
		if { [ "$present" = "$(cat "$entry/existed")" ] && { [ "$present" = 0 ] || { [ "$value" = "$old" ] && [ "$type" = "$(cat "$entry/type")" ]; }; }; } ||
			{ [ "$present" = 0 ] && [ "$(cat "$entry/expected-type")" = 0 ]; } ||
			{ [ "$type" = "$(cat "$entry/expected-type")" ] && [ "$value" = "$expected" ]; }; then :
		else printf 'field:%s\n' "$key"; missing=1; fi
	done
	for service in smartdns dnsmasq; do
		for key in enabled running; do
			desired=$(cat "$record/origin/$service-$key") || return 1
			if [ "$key" = enabled ]; then state=$(init_dns_enabled "$service") || return 1
			else state=$(init_dns_service_state "$service") || return 1; fi
			managed=0; [ "$service" != smartdns ] || managed=1
			if [ "$state" != "$managed" ] && [ "$state" != "$desired" ]; then printf 'service:%s:%s\n' "$service" "$key"; missing=1; fi
		done
	done
	for key in dns-file dns90; do
		case "$key" in dns-file) value=$RP_SMARTDNS_EXTRA_FILE ;; *) value=$RP_SMARTDNS_FILE ;; esac
		[ ! -L "$value" ] || { printf 'file-link:%s\n' "$key"; missing=1; continue; }
		if [ ! -e "$value" ] && [ -f "$record/origin/$key-absent" ]; then continue; fi
		if [ -f "$value" ] && { cmp -s "$value" "$record/origin/$key-new" || cmp -s "$value" "$record/origin/$key-old"; }; then continue; fi
		printf 'file:%s\n' "$key"; missing=1
	done
	[ "$missing" = 0 ]
}
exit_finish() {
	[ "$(cat "$WAL/kind" 2>/dev/null)" = exit ] || return 0
	[ "$(read_phase)" = rolled_back ] || return 1
	# The terminal marker precedes pointer removal, so a power loss is retryable.
	printf '1\n' >"$WAL/exit-complete" && sync || return 1
	rm -f "$TX/active" "$TX/source" "$TX/exit-token" || return 1
	for exit_service in routepolicy-prerecover routepolicy-initguard; do
		[ ! -x "$RP_ROOT/etc/init.d/$exit_service" ] || init_dns_call "$exit_service" disable || return 1
	done
	phase exited
}
exit_prepare() {
	local record=$1 token problems
	uci_layout || return 1
	problems=$(exit_check "$record") || { rp_output_error exit-prepare "退出缺少归属证据或存在外部修改: $problems"; return 1; }
	token=$(sed 's/-//g' /proc/sys/kernel/random/uuid) || return 1
	[ "${#token}" = 32 ] || return 1
	printf '%s\n' "$token" >"$TX/exit-token" && sync || return 1
	printf '{"ok":true,"operation":"exit-prepare","token":"%s","confirmation_required":true,"management_may_change":true,"warning":"退出将恢复最初接入地址与 DHCP/DNS 服务状态；请使用带外控制台。"}\n' "$token"
}
exit_apply() {
	local record=$1 supplied=$2 item stage original
	[ "${#supplied}" = 32 ] && [ "$(cat "$TX/exit-token" 2>/dev/null)" = "$supplied" ] || return 1
	uci_layout && exit_check "$record" || return 1
	stage="$TX/exiting"; safe_dir "$stage"
	if [ -n "$(find "$stage" -mindepth 1)" ]; then
		# This private stage cannot have written public fields before WAL promotion.
		[ -z "$(find "$stage" -type l)" ] && [ "$(cat "$stage/token" 2>/dev/null)" = "$supplied" ] && [ "$(cat "$stage/kind" 2>/dev/null)" = exit ] || return 1
		rm -rf "$stage" && mkdir "$stage" || return 1
	fi
	cp -pR "$record/origin/." "$stage/" || return 1
	for item in candidate parameters; do cp "$record/$item" "$stage/$item" || return 1; done
	printf '%s\n' "$supplied" >"$stage/token"; printf 'exit\n' >"$stage/kind"
	cat "$RP_ROOT/proc/sys/kernel/random/boot_id" >"$stage/boot-id" || return 1
	printf 'rolling_back\n' >"$stage/phase"
	for item in dns-attempted dns-service-attempted dns90-attempted policy-attempted; do : >"$stage/$item" || return 1; done
	safe_dir "$stage/delta"
	original=$WAL
	[ ! -L "$TX/previous" ] && [ ! -e "$TX/previous" ] || return 1
	[ ! -e "$original" ] || mv "$original" "$TX/previous" || return 1
	mv "$stage" "$original" && sync || return 1
	rollback_fields && exit_finish
}
active_publish() {
	# shellcheck disable=SC3043
	local token record stage item prior source
	token=$(cat "$WAL/token") || return 1
	[ "${#token}" = 32 ] || return 1
	case "$token" in *[!0-9a-f]*) return 1 ;; esac
	safe_dir "$TX/confirmed"
	record="$TX/confirmed/$token"; stage="$WAL/confirmed-record"
	[ ! -L "$record" ] && [ ! -L "$stage" ] && [ ! -L "$TX/active" ] && [ ! -L "$TX/source" ] && [ ! -L "$TX/active.new" ] && [ ! -L "$TX/source.new" ] || return 1
	if [ ! -e "$record" ]; then
		[ ! -e "$stage" ] || { [ -d "$stage" ] && [ -z "$(find "$stage" -type l)" ] && rm -rf "$stage"; } || return 1
		mkdir "$stage" || return 1
		# Keep the existing field/file provenance, without private UCI deltas or DNS caches.
		for item in candidate parameters token boot-id count baseline fields policy-active policy-attempted smartdns-enabled smartdns-running dnsmasq-enabled dnsmasq-running routepolicy-enabled smartdns-listeners dnsmasq-listeners dns-file-old dns-file-absent dns90-old dns90-absent dns-active-old dns-boot-pending dns-boot-ready failed-stage; do
			[ ! -L "$WAL/$item" ] || return 1
			[ ! -e "$WAL/$item" ] || cp -pR "$WAL/$item" "$stage/$item" || return 1
		done
		origin_publish "$stage" || return 1
		printf 'confirmed\n' >"$stage/phase" && sync && mv "$stage" "$record" && sync || return 1
	fi
	[ -d "$record" ] && [ "$(cat "$record/token")" = "$token" ] && [ "$(cat "$record/phase")" = confirmed ] || return 1
	if [ ! -e "$TX/source" ]; then
		printf '%s\n' "$token" >"$TX/source.new" && mv "$TX/source.new" "$TX/source" && sync || return 1
	fi
	source=$(cat "$TX/source") || return 1
	[ "${#source}" = 32 ] || return 1
	case "$source" in *[!0-9a-f]*) return 1 ;; esac
	rp_init_source_record >/dev/null || return 1
	if [ ! -f "$WAL/prior-active" ]; then
		prior=$(cat "$TX/active" 2>/dev/null) || prior=-
		printf '%s\n' "$prior" >"$WAL/prior-active" && sync || return 1
	fi
	# This atomic pointer replacement is the sole durable confirmation commit point.
	printf '%s\n' "$token" >"$TX/active.new" && mv "$TX/active.new" "$TX/active" && sync && phase confirmed || return 1
	rm -f "$WAL/dns-boot-pending" || return 1
	prior=$(cat "$WAL/prior-active") || return 1
	if [ "$prior" != - ] && [ "$prior" != "$token" ] && [ "$prior" != "$source" ]; then
		[ "${#prior}" = 32 ] || return 1
		case "$prior" in *[!0-9a-f]*) return 1 ;; esac
		for item in "$TX/confirmed/$prior" "$TX/confirmed-$prior"; do
		if [ -e "$item" ] || [ -L "$item" ]; then
			[ ! -L "$item" ] && [ "$(cat "$item/token")" = "$prior" ] && [ "$(cat "$item/phase")" = confirmed ] || return 1
			rm -rf "$item" || return 1
		fi
		done
	fi
}
uci_layout() {
	namespace_token=$(cat "$WAL/token") || return 1
	[ "${#namespace_token}" -eq 32 ] || return 1
	case "$namespace_token" in *[!0-9a-f]*) return 1 ;; esac
	safe_dir "$WAL/config"; safe_dir "$WAL/delta"; safe_dir "$WAL/read-delta"
	for namespace_package in $PACKAGES; do
		namespace_target="$RP_ROOT/etc/config/$namespace_package"
		[ -f "$namespace_target" ] && [ ! -L "$namespace_target" ] || return 1
		namespace_link="$WAL/config/rp_${namespace_token}_$namespace_package"
		if [ -e "$namespace_link" ] || [ -L "$namespace_link" ]; then
			[ -L "$namespace_link" ] && [ "$(readlink "$namespace_link")" = "$namespace_target" ] || return 1
		else ln -s "$namespace_target" "$namespace_link" || return 1; fi
	done
}
uci_alias() {
	namespace_package=${1%%.*}
	case "$namespace_package" in network|dhcp|firewall|routepolicy|smartdns) ;; *) return 1 ;; esac
	namespace_token=$(cat "$WAL/token") || return 1
	namespace_argument="rp_${namespace_token}_${namespace_package}${1#"$namespace_package"}"
}
# -t still searches /tmp/.uci. Token-named package aliases isolate the delta lookup,
# while libuci commits through the symlink target after its locked fresh-file merge.
uci_private() {
	uci_alias "$2" || return 1
	uci -c "$WAL/config" -t "$WAL/delta" "$1" "$namespace_argument"
}
uci_committed() {
	uci_alias "$2" || return 1
	uci -q -c "$WAL/config" -t "$WAL/read-delta" "$1" "$namespace_argument"
}
field_pending() {
	pending_field=$1
	pending_package=${pending_field%%.*}
	pending_changes=$(uci -q changes "$pending_package") || return 2
	printf '%s\n' "$pending_changes" | awk -F= -v wanted="$pending_field" -v package="$pending_package" '
		NF {
			key=$1; sub(/^[+-]/,"",key); sub(/[+-]$/,"",key)
			if(key !~ ("^" package "\\.[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)?$")) {unknown=1;next}
			if(key==wanted || index(wanted,key ".")==1 || index(key,wanted ".")==1) found=1
		} END {exit !(found||unknown)}'
}
no_pending() {
	for pkg in $PACKAGES; do
		pending=$(uci -q changes "$pkg") || return 1
		[ -z "$pending" ] || return 1
	done
}
args_valid() {
	[ "$#" -eq 11 ] || [ "$#" -eq 13 ] || return 1
	for argument do
		[ -n "$argument" ] && [ "${#argument}" -le 256 ] || return 1
		case "$argument" in *[!A-Za-z0-9_.:/,#-]*) return 1 ;; esac
	done
}
plan_valid() {
	# The topology helper validates values and role semantics; this is the write boundary.
	awk -F '\t' '
		NF != 3 || $1 !~ /^(set|list|delete)$/ || length($3)>4096 || $3 ~ /[^ -~]/ {exit 1}
		$2 !~ /^(network|dhcp|firewall|routepolicy|smartdns)\.([A-Za-z0-9_]+|@(smartdns|dnsmasq|device)\[[0-9]+\])(\.[A-Za-z0-9_]+)?$/ {exit 1}
		seen[$2]++ {exit 1}
		{
			key=$2
			if(key ~ /^routepolicy\.main\.(lan_interface|default_interface|policy_interface|smartdns_policy_group|smartdns_enabled|enabled)$/) next
			if(key ~ /^dhcp\.([A-Za-z0-9_]+|@dnsmasq\[[0-9]+\])\.(port|disabled)$/) next
			if(key ~ /^smartdns\.([A-Za-z0-9_]+|@smartdns\[[0-9]+\])\.(enabled|port|tcp_server|ipv6_server|bind_device|bind_device_name|auto_set_dnsmasq|old_enabled|old_port|old_auto_set_dnsmasq|cache_persist|cache_file|force_aaaa_soa|tls_server|doh_server|seconddns_enabled|server_flags|conf_files)$/) next
			if(key ~ /^smartdns\.rp_init(_(client_rule|domain_rule|ip_rule))?$/) next
			if(key ~ /^smartdns\.rp_init_(default|policy)_[1-4](\.(routepolicy_init|enabled|type|ip|port|server_group|exclude_default_group|addition_arg))?$/) next
			if(key ~ /^network\.([A-Za-z0-9_]+|@device\[[0-9]+\])\.(ipaddr|netmask|ipv6|ip6assign|delegate|ip6addr|ip6gw|ip6prefix|auto|disabled)$/) next
			if(key ~ /^network\.[A-Za-z0-9_]+\.metric$/ && $3=="200") next
			if(key ~ /^network\.rp_init_(default|policy)(\.(device|proto|gateway|defaultroute|peerdns|metric))?$/) next
			if(key ~ /^dhcp\.[A-Za-z0-9_]+\.(ignore|ra|dhcpv6|ndp)$/) next
			if(key ~ /^firewall\.rp_init_(default|policy|default4|policy4|default_nat|policy_nat|default_dhcp_client|policy_dhcp_client|dns|ipv6|dhcp4|dhcp6|ra|redirects)(\.(name|network|input|output|forward|src|dest|src_ip|family|proto|target|src_port|dest_port|icmp_type))?$/) next
			exit 1
		}
		END {if (NR<1 || NR>256) exit 1}
	' "$1"
}
make_plan() { "$LIBEXEC/init-topology" plan "$@" 9>&-; }
link_value() { awk -F '\t' -v wanted="$1" '$1==wanted {print $2}' "$2"; }
link_plan_valid() {
	awk -F '\t' 'NF!=2 || length($2)>256 || $2~/[^ -~]/ || seen[$1]++ {exit 1}
		$1!~/^(required|dad_required|device|ifindex|mac|device_path|up|carrier|target|dad)$/ {exit 1}
		{value[$1]=$2}
		END {
			if(NR<1 || NR>10 || value["required"] !~ /^[01]$/) exit 1
			if(value["required"]==1) {
				if(value["device"] !~ /^[A-Za-z0-9_-]+$/ || value["device"]=="lo" || length(value["device"])>32) exit 1
				if(value["ifindex"] !~ /^[0-9]+$/ || value["ifindex"]<1 || value["ifindex"]>2147483647) exit 1
				if(value["device_path"] !~ /^\// || value["up"] !~ /^[01]$/) exit 1
				if(value["dad_required"] !~ /^[01]$/) exit 1
				if(split(value["mac"],mac,":")!=6) exit 1
				for(i=1;i<=6;i++) if(length(mac[i])!=2 || mac[i] !~ /^[0-9a-fA-F]+$/) exit 1
				if(value["dad_required"]==1) {
					if(split(value["target"],ip,".")!=4) exit 1
					for(i=1;i<=4;i++) if(ip[i] !~ /^[0-9]+$/ || ip[i]>255) exit 1
				} else if(value["target"]!="-" || value["dad"]!="not-required") exit 1
			}
		}' "$1"
}
link_live_up() {
	link_flags=$(cat "$RP_ROOT/sys/class/net/$LINK_DEVICE/flags" 2>/dev/null) || return 1
	rp_is_hex32 "$link_flags" || return 1
	LINK_UP=$((link_flags & 1))
}
link_identity_matches() {
	LINK_DEVICE=$(link_value device "$WAL/link-plan")
	rp_is_device "$LINK_DEVICE" || return 1
	[ "$(cat "$RP_ROOT/sys/class/net/$LINK_DEVICE/address" 2>/dev/null)" = "$(link_value mac "$WAL/link-plan")" ] || return 1
	[ "$(readlink -f "$RP_ROOT/sys/class/net/$LINK_DEVICE/device")" = "$(link_value device_path "$WAL/link-plan")" ] || return 1
	current_boot=$(cat "$RP_ROOT/proc/sys/kernel/random/boot_id" 2>/dev/null) || return 1
	old_boot=$(cat "$WAL/link-boot") || return 1
	if [ "$current_boot" = "$old_boot" ]; then
		[ "$(cat "$RP_ROOT/sys/class/net/$LINK_DEVICE/ifindex" 2>/dev/null)" = "$(link_value ifindex "$WAL/link-plan")" ] || return 1
	fi
}
link_apply() {
	[ "$(link_value required "$WAL/link-plan")" = 1 ] || return 0
	printf '%s\n' link-preparation >"$WAL/stage" || return 1
	link_identity_matches && link_live_up || return 1
	[ "$LINK_UP" = "$(link_value up "$WAL/link-plan")" ] || return 1
	topology link-unclaimed >"$WAL/link-unclaimed-result" 2>"$WAL/link-error" || return 1
	[ "$(link_value dad_required "$WAL/link-plan")" = 1 ] || return 0
	if [ "$LINK_UP" = 0 ]; then
		printf '%s\n' link-up >"$WAL/stage" &&
			printf '%s\n' 1 >"$WAL/link-expected-up" &&
			printf '%s' '' >"$WAL/link-attempted" && sync || return 1
		timeout 5 ip link set dev "$LINK_DEVICE" up >"$WAL/link-result" 2>"$WAL/link-error" || return 1
		link_live_up && [ "$LINK_UP" = 1 ] || return 1
	fi
	printf '%s\n' link-dad >"$WAL/stage" && sync || return 1
	timeout 20 "$LIBEXEC/init-topology" link-dad "$a1" "$a2" "$a3" "$a4" "$a5" "$a6" "$a7" "$a8" "$a9" "$a10" "$a11" "$a12" "$a13" 9>&- >"$WAL/link-result" 2>"$WAL/link-error"
}
link_restore() {
	[ -f "$WAL/link-attempted" ] || return 0
	load_args || return 1
	# A different physical card or external owner always wins over our old admin state.
	link_identity_matches && link_live_up || return 1
	[ "$LINK_UP" = "$(link_value up "$WAL/link-plan")" ] && return 0
	[ "$LINK_UP" = "$(cat "$WAL/link-expected-up")" ] || return 1
	topology link-unclaimed >"$WAL/link-unclaimed-result" 2>"$WAL/link-restore-error" || return 1
	printf '%s\n' link-restore >"$WAL/stage" && sync || return 1
	timeout 5 ip link set dev "$LINK_DEVICE" down >"$WAL/link-result" 2>"$WAL/link-restore-error" || return 1
	link_live_up && [ "$LINK_UP" = "$(link_value up "$WAL/link-plan")" ]
}
read_current() {
	# Sentinel retains trailing newlines, which shell command substitution otherwise loses.
	raw=$(uci_committed get "$1" 2>/dev/null && printf '.') || return 1
	FIELD_VALUE=${raw%.}
	newline='
'
	case "$FIELD_VALUE" in *"$newline") FIELD_VALUE=${FIELD_VALUE%"$newline"} ;; *) return 2 ;; esac
	case "$FIELD_VALUE" in *"$newline"*) return 2 ;; esac
	[ "${#FIELD_VALUE}" -le 4096 ] || return 2
	if printf '%s' "$FIELD_VALUE" | LC_ALL=C grep -q '[^ -~]'; then return 2; fi
	FIELD_TYPE=scalar
	case "$1" in
		*.*.*)
			field_package=${1%%.*}; field_rest=${1#*.}; field_section=${field_rest%%.*}; field_option=${field_rest#*.}
			exported=$(uci_committed export "$field_package") || return 2
			field_data=$(printf '%s\n' "$exported" | rp_uci_field_data "$field_section" "$field_option") || return 2
			FIELD_TYPE=${field_data%%"$TAB"*}
			FIELD_VALUE=${field_data#*"$TAB"}
			;;
	esac
}
action_type() { case "$1" in set) printf scalar ;; list) printf list ;; delete) printf 0 ;; *) return 1 ;; esac; }
write_field() {
	write_key=$1 write_type=$2 write_value=$3
	if [ "$write_type" = 0 ]; then
		if uci_private get "$write_key" >/dev/null 2>&1; then uci_private delete "$write_key"; else return 0; fi
		return
	fi
	if [ "$write_type" = scalar ]; then uci_private set "$write_key=$write_value"; return; fi
	if uci_private get "$write_key" >/dev/null 2>&1; then uci_private delete "$write_key" || return 1; fi
	printf '%s\n' "$write_value" | tr '|' '\n' | while IFS= read -r item; do
		uci_private add_list "$write_key=$item" || exit 1
	done
}
init_dns_restore_bookkeeping() {
	# The native init refreshes old_* even while restoring the original service.
	book_index=0
	while [ "$book_index" -lt "$(cat "$WAL/count")" ]; do
		book_index=$((book_index+1)); book_entry="$WAL/fields/$book_index"
		[ -f "$book_entry/attempted" ] || continue
		book_key=$(cat "$book_entry/key") || return 1
		case "$book_key" in smartdns.*.old_port) book_option=port book_default=53 ;; smartdns.*.old_enabled) book_option=enabled book_default=0 ;; smartdns.*.old_auto_set_dnsmasq) book_option=auto_set_dnsmasq book_default=1 ;; *) continue ;; esac
		book_old=$(cat "$book_entry/old") && book_type=$(cat "$book_entry/type") && book_existed=$(cat "$book_entry/existed") || return 1
		if read_current "$book_key"; then
			if [ "$book_existed" = 1 ] && [ "$FIELD_TYPE" = "$book_type" ] && [ "$FIELD_VALUE" = "$book_old" ]; then continue; fi
			book_runtime=$(uci_committed get "${book_key%.*}.$book_option") || book_runtime=$book_default
			[ "$FIELD_TYPE" = scalar ] && [ "$FIELD_VALUE" = "$book_runtime" ] || return 1
		else [ "$?" = 1 ] && [ "$book_existed" = 0 ] || return 1; continue; fi
		no_pending || return 1
		if [ "$book_existed" = 1 ]; then write_field "$book_key" "$book_type" "$book_old" || return 1
		else write_field "$book_key" 0 - || return 1; fi
		uci_private commit smartdns || return 1
	done
}
snapshot() {
	while IFS="$TAB" read -r _action key value; do
		if read_current "$key"; then
			printf '%s\t%s\t%s\n' "$key" "$FIELD_TYPE" "$FIELD_VALUE"
		else
			[ "$?" -eq 1 ] || return 1
			printf '%s\t0\t-\n' "$key"
		fi
	done <"$1"
}
preview_json() {
	printf '{"ok":true,"operation":"init-%s","candidate":"%s","confirmation_timeout":120,"smartdns_coordination":["prepare","apply","verify","rollback"],"packet_evidence":"EVIDENCE_MISSING","ipv6_policy":{"forwarding":"reject-new-only","exceptions":["existing-conntrack","external-router-RA-bypass"]}' \
		"$operation" "$(rp_json_escape "$1")"
	[ -z "${2:-}" ] || printf ',"token":"%s"' "$2"
	printf ',"maintenance_notice":"初始化期间，请暂停自动改配置的脚本，也不要在其他页面或 SSH 中保存网络、DHCP、防火墙、SmartDNS 或 RoutePolicy 设置。等到确认成功或回滚完成后再修改；即使改的是不同选项，同时保存也可能丢失修改。"'
	printf ',"link_preparation":"%s"' "$(rp_json_escape "${link_preview:-required\t0}")"
	printf '}\n'
}
smartdns_coordinate() {
	# DNS shares the field journal, lock and recovery lifecycle with topology changes.
	case "$1" in prepare|apply|verify|rollback) ;; *) return 1 ;; esac
	printf '%s\n' "$1" >>"$WAL/smartdns-stages" && sync && init_dns_coordinate "$1"
}
check_token() {
	[ "$#" -eq 1 ] && [ "${#1}" -eq 32 ] || fail '事务 token 非法'
	case "$1" in *[!0-9a-f]*) fail '事务 token 非法' ;; esac
	[ -f "$WAL/token" ] && [ ! -L "$WAL" ] && [ "$(cat "$WAL/token")" = "$1" ] || fail '事务 token 不匹配'
}
load_args() {
	[ -f "$WAL/parameters" ] || return 1
	# Values are fixed-position validated words, never shell source or eval.
	set -f
	IFS="$TAB" read -r a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 <"$WAL/parameters"
	a12=${a12:--} a13=${a13:--}
	args_valid "$a1" "$a2" "$a3" "$a4" "$a5" "$a6" "$a7" "$a8" "$a9" "$a10" "$a11" "$a12" "$a13"
}
topology() { "$LIBEXEC/init-topology" "$1" "$a1" "$a2" "$a3" "$a4" "$a5" "$a6" "$a7" "$a8" "$a9" "$a10" "$a11" "$a12" "$a13" 9>&-; }
verify_runtime() {
	# Only the fixed topology verifier writes this private diagnostic; no UCI export is exposed.
	while IFS="$TAB" read -r verify_action verify_key verify_expected; do
		if [ "$verify_action" = delete ]; then
			if uci_committed get "$verify_key" >/dev/null 2>&1; then
				printf 'prepared candidate differs: %s\n' "$verify_key" >"$WAL/verify-error"; return 1
			fi
			continue
		fi
		if ! read_current "$verify_key" || [ "$FIELD_TYPE" != "$(action_type "$verify_action")" ] || [ "$FIELD_VALUE" != "$verify_expected" ]; then
			printf 'prepared candidate differs: %s\n' "$verify_key" >"$WAL/verify-error"
			return 1
		fi
	done <"$WAL/candidate"
	if [ "$(link_value required "$WAL/link-plan")" = 1 ] && ! link_identity_matches; then
		printf '%s\n' 'new egress physical identity differs from the prepared candidate' >"$WAL/verify-error"
		return 1
	fi
	topology verify >"$WAL/verify-result" 2>"$WAL/verify-error"
}
new_dhcp_probe() {
	dhcp_dump=$(timeout 3 ubus call network.interface dump) || return 1
	dhcp_interfaces=$(printf '%s\n' "$dhcp_dump" | jsonfilter -e '@.interface') || return 1
	case "$dhcp_interfaces" in \[*\]) ;; *) return 1 ;; esac
	dhcp_status=$(printf '%s\n' "$dhcp_dump" | jsonfilter -e "@.interface[@.interface=\"$dhcp_interface\"]") || return 75
	dhcp_proto=$(printf '%s\n' "$dhcp_status" | jsonfilter -e '@.proto') || return 1
	[ "$dhcp_proto" = dhcp ] || return 1
	dhcp_errors=$(printf '%s\n' "$dhcp_status" | jsonfilter -e '@.errors[*]' 2>/dev/null) || dhcp_errors=
	[ -z "$dhcp_errors" ] || return 1
	dhcp_device=$(printf '%s\n' "$dhcp_status" | jsonfilter -e '@.device' 2>/dev/null) || dhcp_device=
	dhcp_l3=$(printf '%s\n' "$dhcp_status" | jsonfilter -e '@.l3_device' 2>/dev/null) || dhcp_l3=
	[ -z "$dhcp_device" ] || [ "$dhcp_device" = "$a5" ] || return 1
	[ -z "$dhcp_l3" ] || [ "$dhcp_l3" = "$a5" ] || return 1
	dhcp_up=$(printf '%s\n' "$dhcp_status" | jsonfilter -e '@.up') || return 1
	case "$dhcp_up" in true) ;; false) return 75 ;; *) return 1 ;; esac
	dhcp_address=$(printf '%s\n' "$dhcp_status" | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null) || dhcp_address=
	dhcp_gateway=$(printf '%s\n' "$dhcp_status" | jsonfilter -e '@.route[@.target="0.0.0.0"].nexthop' 2>/dev/null) || dhcp_gateway=
	[ -n "$dhcp_address" ] && [ -n "$dhcp_gateway" ] && [ -n "$dhcp_l3" ] || return 75
	rp_is_ipv4 "$dhcp_address" && rp_is_ipv4 "$dhcp_gateway" || return 1
	# A dev filter makes native ip omit dev, so inspect explicit devices instead.
	dhcp_routes=$(timeout 3 ip -4 route show table main default) || return 1
	[ -n "$dhcp_routes" ] || return 75
	printf '%s\n' "$dhcp_routes" | awk -v device="$a5" -v gateway="$dhcp_gateway" '
		$1=="default"{d="";g="";for(i=1;i<NF;i++){if($i=="dev")d=$(i+1);if($i=="via")g=$(i+1)}if(d==device){if(g==gateway)n++;else bad=1}}
		END{if(bad||n>1)exit 1;if(n==0)exit 75}'
}
wait_new_dhcp() {
	case "$a4:$a6" in default:dhcp|policy:dhcp) ;; *) return 0 ;; esac
	dhcp_interface="rp_init_$a4"
	[ "$(uci_committed get "network.$dhcp_interface.proto")" = dhcp ] &&
		[ "$(uci_committed get "network.$dhcp_interface.device")" = "$a5" ] || return 1
	printf '%s\n' dhcp-readiness >"$WAL/stage" && sync || return 1
	while :; do
		pending_recovery_due && break
		dhcp_wait_now=$(monotonic_now) || break
		dhcp_started=$(cat "$WAL/uptime-start-cs") || break
		# Spend the existing window, leaving 20 seconds for management confirmation.
		[ "$dhcp_wait_now" -lt "$((dhcp_started + 10000))" ] || break
		link_identity_matches || break
		if new_dhcp_probe; then return 0; else dhcp_result=$?; fi
		if [ "$dhcp_result" != 75 ]; then
			printf '%s\n' 'new DHCP egress has invalid protocol/device or explicit netifd error' >"$WAL/verify-error"
			return 1
		fi
		sleep 1
	done
	printf '%s\n' 'new DHCP egress readiness timed out within the original confirmation window' >"$WAL/verify-error"
	return 1
}
policy_runtime_present() {
	policy_state_interface=$(rp_state_get policy_interface) || return 1
	rp_is_name "$policy_state_interface" 32 && timeout 3 nft list table inet routepolicy >/dev/null 2>&1
}
policy_sync() {
	policy_mode=${1:-apply}
	policy_log=policy
	[ "$policy_mode" != restore ] || policy_log=policy-restore
	if ! policy_required=$(cat "$WAL/policy-active" 2>/dev/null); then
		policy_required=$(uci_committed get routepolicy.main.enabled) || return 1
		[ "$policy_required" != 1 ] || policy_runtime_present || return 1
	fi
	case "$policy_required" in 0|1) ;; *) return 1 ;; esac
	if [ "$policy_required" = 0 ]; then
		if [ "$policy_mode" = restore ]; then
			[ ! -f "$WAL/policy-attempted" ] || ROUTEPOLICY_INIT_RESTORE=1 ROUTEPOLICY_INIT_GENERATION="$(cat "$WAL/token")" timeout -s KILL 30 sh -c 'exec "$1" teardown' routepolicy-policy-restore "$LIBEXEC/apply" >"$WAL/policy-restore-result" 2>"$WAL/policy-restore-error" || return 1
			return 0
		fi
		# A DNS initialization activates policy routing in this same transaction.
		grep -q '^set[[:space:]]routepolicy.main.enabled[[:space:]]1$' "$WAL/candidate" || return 0
	fi
	[ "$(uci_committed get routepolicy.main.enabled)" = 1 ] || return 1
	for policy_package in routepolicy network smartdns; do
		policy_pending=$(uci -q changes "$policy_package") || return 1
		if [ -n "$policy_pending" ]; then
			printf 'policy-runtime:%s\n' "$policy_package" >>"$WAL/deferred-services"
			return 1
		fi
	done
	policy_timeout=30
	if [ "$policy_mode" != restore ]; then
		[ "$policy_required" = 0 ] || policy_runtime_present || return 1
		! pending_recovery_due || return 1
		policy_now=$(monotonic_now) || return 1
		policy_started=$(cat "$WAL/uptime-start-cs") || return 1
		policy_remaining=$(( (policy_started + 12000 - policy_now) / 100 ))
		case "$a4:$a6" in default:dhcp|policy:dhcp) policy_remaining=$((policy_remaining - 20)) ;; esac
		[ "$policy_remaining" -gt 0 ] || return 1
		[ "$policy_remaining" -ge "$policy_timeout" ] || policy_timeout=$policy_remaining
	fi
	policy_wait_started=$(monotonic_now) || return 1
	policy_wait_now=$(monotonic_now) || return 1
	policy_timeout=$((policy_timeout - (policy_wait_now - policy_wait_started + 99) / 100))
	[ "$policy_timeout" -gt 0 ] || return 1
	printf '%s\n' policy-runtime >"$WAL/stage" && sync || return 1
	if [ "$policy_mode" = restore ] && init_dns_owned; then
		rp_render_smartdns90 "$WAL/dns90-restore" || return 1
	else init_dns_coordinate policy-prepare || return 1; fi
	printf '%s' '' >"$WAL/policy-attempted" && sync || return 1
	# Synchronous policy writers retain the same OFD; native services close it.
	ROUTEPOLICY_SOURCE_BOOTSTRAP="$( [ "$policy_mode" = bootstrap ] && printf 1 || printf 0 )" ROUTEPOLICY_DNS_DEFER="$( init_dns_owned && printf 1 || printf 0 )" ROUTEPOLICY_INIT_RESTORE="$( [ "$policy_mode" = restore ] && printf 1 || printf 0 )" ROUTEPOLICY_INIT_GENERATION="$(cat "$WAL/token")" ROUTEPOLICY_OUTPUT=text timeout -s KILL "$policy_timeout" sh -c 'exec "$1"' routepolicy-policy-sync "$LIBEXEC/apply" >"$WAL/$policy_log-result" 2>"$WAL/$policy_log-error" || return 1
	if ! policy_verify_runtime; then
		printf '%s\n' 'RoutePolicy policy table does not match the selected interface/gateway' >"$WAL/$policy_log-error"
		return 1
	fi
}
policy_verify_runtime() {
	policy_required=$(cat "$WAL/policy-active" 2>/dev/null) || policy_required=$(uci_committed get routepolicy.main.enabled) || return 1
	case "$policy_required" in 0)
		[ -f "$WAL/policy-attempted" ] && [ "$(uci_committed get routepolicy.main.enabled)" = 1 ] || return 0
		;; 1) ;; *) return 1 ;; esac
	policy_runtime_present || return 1
	policy_expected=$(uci_committed get routepolicy.main.policy_interface) || return 1
	[ "$(rp_state_get policy_interface)" = "$policy_expected" ] || return 1
	rp_is_name "$policy_expected" 32 || return 1
	policy_status=$(timeout 3 ubus call "network.interface.$policy_expected" status) || return 1
	policy_device=$(printf '%s\n' "$policy_status" | jsonfilter -e '@.l3_device') || return 1
	policy_gateway=$(printf '%s\n' "$policy_status" | jsonfilter -e '@.route[@.target="0.0.0.0"].nexthop') || return 1
	rp_is_device "$policy_device" && rp_is_ipv4 "$policy_gateway" && [ "$(rp_state_get policy_device)" = "$policy_device" ] || return 1
	policy_table=$(rp_state_get route_table) && rp_uint_between "$policy_table" 1 252 || return 1
	policy_config_table=$(uci_committed get routepolicy.main.route_table) || policy_config_table=200
	[ "$policy_table" = "$policy_config_table" ] || return 1
	policy_routes=$(timeout 3 ip -4 route show table "$policy_table") || return 1
	printf '%s\n' "$policy_routes" | awk -v device="$policy_device" -v gateway="$policy_gateway" '
		$1=="default" || ($2=="default" && $1~/^(blackhole|unreachable|prohibit|throw)$/) {
			d="";g="";m=0;for(i=1;i<NF;i++){if($i=="dev")d=$(i+1);if($i=="via")g=$(i+1);if($i=="metric")m=$(i+1)}
			if($1=="default"&&m==10){n++;if(d!=device||g!=gateway)bad=1}else if(m<=10)bad=1}
		END{exit n!=1||bad}'
}
services_reload() {
	reload_mode=${1:-apply}
	reload_errors=0
	printf '%s' '' >"$WAL/deferred-services" || return 1
	for service in network firewall dnsmasq odhcpd; do
		if [ "$service" = dnsmasq ] && init_dns_owned; then continue; fi
		if [ "$service" = odhcpd ] && [ ! -e "$RP_ROOT/etc/init.d/$service" ] && [ ! -L "$RP_ROOT/etc/init.d/$service" ]; then continue; fi
		case "$service" in network) service_packages=network ;; firewall) service_packages='network firewall' ;; *) service_packages='network dhcp' ;; esac
		service_deferred=0
		for service_package in $service_packages; do
			if ! service_pending=$(uci -q changes "$service_package") || [ -n "$service_pending" ]; then
				printf '%s:%s\n' "$service" "$service_package" >>"$WAL/deferred-services"
				printf 'pending-service:%s:%s\n' "$service" "$service_package" >>"$WAL/conflicts"
				service_deferred=1
			fi
		done
		if [ "$service_deferred" = 1 ]; then
			[ "$reload_mode" = restore ] || return 1
			reload_errors=1; continue
		fi
		if [ ! -x "$RP_ROOT/etc/init.d/$service" ]; then
			[ "$reload_mode" = restore ] || return 1
			printf 'service-unavailable:%s\n' "$service" >>"$WAL/conflicts"; reload_errors=1; continue
		fi
		printf 'reload:%s\n' "$service" >"$WAL/stage" && sync || return 1
		if ! init_dns_call "$service" reload >/dev/null 2>&1; then
			[ "$reload_mode" = restore ] || return 1
			printf 'reload:%s\n' "$service" >>"$WAL/conflicts"; reload_errors=1
		fi
	done
	[ "$reload_errors" = 0 ]
}
guard_start() {
	[ -x "$RP_ROOT/etc/init.d/routepolicy-initguard" ] || return 1
	if init_dns_owned; then
		[ -x "$RP_ROOT/etc/init.d/routepolicy-prerecover" ] || return 1
		rp_native_service routepolicy-prerecover enable >/dev/null 2>&1 &&
			rp_native_service routepolicy-initguard enable >/dev/null 2>&1 || return 1
	fi
	rp_native_service routepolicy-initguard start >/dev/null 2>&1 || return 1
	guard_attempt=0
	while [ "$guard_attempt" -lt 10 ]; do
		if service_state=$(ubus call service list '{"name":"routepolicy-initguard"}' 9>&- 2>/dev/null); then
			running=$(printf '%s\n' "$service_state" | jsonfilter -e '@["routepolicy-initguard"].instances.guard.running') || running=
		else running=; fi
		[ "$running" != true ] || return 0
		guard_attempt=$((guard_attempt + 1)); sleep 0.2
	done
	return 1
}
guard_stop_if_inactive() (
	# Recheck under the writer lock so an old guard cannot delete a newly started instance.
	exec 9>"$TX/lock"
	flock -n 9 || exit 1
	case "$(read_phase)" in
		applying|rolling_back|pending|confirming) exit 1 ;;
		prepared)
			pending_recovery_due || exit 1
			rp_native_run 3 ubus call service delete '{"name":"routepolicy-initguard","instance":"guard"}' >/dev/null 2>&1; exit $? ;;
		conflict) rp_native_run 3 ubus call service delete '{"name":"routepolicy-initguard","instance":"guard"}' >/dev/null 2>&1; exit $? ;;
	esac
	! rp_dns_boot_pending || exit 1
	! rp_writer_event_pending || exit 1
	rp_native_run 3 ubus call service delete '{"name":"routepolicy-initguard","instance":"guard"}' >/dev/null 2>&1
)
rollback_fields() {
	rp_writer_idle || { printf '%s\n' 'previous synchronous writer has not drained; recovery deferred' >"$WAL/verify-error"; return 1; }
	recovery_early=${1:-0}
	phase rolling_back || return 1
	uci_layout || { phase conflict; return 1; }
	printf '%s' '' >"$WAL/conflicts" || return 1
	# A failed commit may leave unapplied private changes; never commit those during restore.
	[ -d "$WAL/delta" ] && [ ! -L "$WAL/delta" ] || { phase conflict; return 1; }
	find "$WAL/delta" -type f -exec rm -f '{}' ';' || { phase conflict; return 1; }
	conflicts=0
	field_attempted=0
	smartdns_coordinate rollback || { phase conflict; return 1; }
	rp_managed_restore "$WAL" || { printf '%s\n' managed-snapshot >>"$WAL/conflicts"; phase conflict; return 1; }
	count=$(cat "$WAL/count" 2>/dev/null) || { phase conflict; return 1; }
	rp_uint_between "$count" 1 2048 || { phase conflict; return 1; }
	while [ "$count" -gt 0 ]; do
		entry="$WAL/fields/$count"
		if [ ! -f "$entry/attempted" ]; then count=$((count - 1)); continue; fi
		field_attempted=1
		key=$(cat "$entry/key") || return 1
		expected=$(cat "$entry/expected") || return 1
		existed=$(cat "$entry/existed") || return 1
		old=$(cat "$entry/old") || return 1
		oldtype=$(cat "$entry/type") || return 1
		if field_pending "$key"; then
			printf 'pending:%s\n' "$key" >>"$WAL/conflicts"; conflicts=1; count=$((count - 1)); continue
		elif [ "$?" -ne 1 ]; then
			printf 'pending-package:%s\n' "${key%%.*}" >>"$WAL/conflicts"; conflicts=1; count=$((count - 1)); continue
		fi
		present=0; current=; currenttype=
		if read_current "$key"; then
			present=1; current=$FIELD_VALUE; currenttype=$FIELD_TYPE
		elif [ "$?" -ne 1 ]; then
			printf '%s\n' "$key" >>"$WAL/conflicts"; conflicts=1; count=$((count - 1)); continue
		fi
		if { [ "$existed" = 0 ] && [ "$present" = 0 ]; } || { [ "$existed" = 1 ] && [ "$present" = 1 ] && [ "$current" = "$old" ] && [ "$currenttype" = "$oldtype" ]; }; then
			:
		elif { [ "$present" = 0 ] && [ "$(cat "$entry/expected-type" 2>/dev/null || printf scalar)" = 0 ]; } ||
			{ [ "$present" = 1 ] && [ "$current" = "$expected" ] && [ "$currenttype" = "$(cat "$entry/expected-type" 2>/dev/null || printf scalar)" ]; }; then
			case "$key" in
				*.*.*) ;;
				*)
					# Unknown children make a newly created section user-owned; preserve it.
					if [ "$(uci_committed show "$key" | wc -l)" -ne 1 ]; then
						printf '%s\n' "$key" >>"$WAL/conflicts"; conflicts=1; count=$((count - 1)); continue
					fi
					;;
			esac
			if [ "$existed" = 1 ]; then
				restore_ok=1
				if [ "$oldtype" = list ]; then
					write_field "$key" list "$old" || restore_ok=0
				else
					uci_private set "$key=$old" || restore_ok=0
				fi
			else
				restore_ok=1; uci_private delete "$key" || restore_ok=0
			fi
			if [ "$restore_ok" = 0 ]; then
				printf 'write:%s\n' "$key" >>"$WAL/conflicts"; conflicts=1
				find "$WAL/delta" -type f -exec rm -f '{}' ';' || return 1
				count=$((count - 1)); continue
			fi
			# Commit a single owned field, never import or overwrite a package.
			if ! uci_private commit "${key%%.*}"; then
				printf 'commit:%s\n' "$key" >>"$WAL/conflicts"; conflicts=1
				find "$WAL/delta" -type f -exec rm -f '{}' ';' || return 1
			fi
		else
			printf '%s\n' "$key" >>"$WAL/conflicts"; conflicts=1
		fi
		count=$((count - 1))
	done
	if [ "$recovery_early" = 1 ]; then
		init_dns_coordinate restore-files && init_dns_coordinate quarantine-boot || conflicts=1
		if [ "$conflicts" = 0 ]; then return 0; fi
		phase conflict; return 1
	fi
	if [ "$field_attempted" = 1 ]; then
		services_reload restore || conflicts=1
		if ! policy_sync restore; then printf '%s\n' policy-runtime >>"$WAL/conflicts"; conflicts=1; fi
	fi
	if ! init_dns_coordinate restore-service; then printf '%s\n' smartdns-service >>"$WAL/conflicts"; conflicts=1; fi
	if ! link_restore; then printf '%s\n' link-ownership >>"$WAL/conflicts"; conflicts=1; fi
	if [ "$conflicts" -eq 0 ]; then phase rolled_back; else phase conflict; return 1; fi
}
recover_locked() {
	case "$(read_phase)" in
		applying|rolling_back|pending) rollback_fields ;;
		prepared|expired|confirmed|rolled_back|exited|absent) return 0 ;;
		conflict) rollback_fields ;;
		*) phase conflict; return 1 ;;
	esac
}
transaction_same_boot() {
	transaction_boot=$(cat "$WAL/boot-id" 2>/dev/null) || return 1
	running_boot=$(cat "$RP_ROOT/proc/sys/kernel/random/boot_id" 2>/dev/null) || return 1
	[ -n "$transaction_boot" ] && [ -n "$running_boot" ] && [ "$transaction_boot" = "$running_boot" ]
}
monotonic_now() {
	# /proc/uptime supplies boot-scoped centiseconds, unaffected by wall-clock correction.
	LC_ALL=C awk '
		NR!=1 || NF!=2 || $1 !~ /^[0-9]+\.[0-9][0-9]$/ || $1>=10000000000 {exit 1}
		{printf "%.0f\n", $1*100}
		END {if(NR!=1) exit 1}
	' "$RP_ROOT/proc/uptime"
}
pending_recovery_due() {
	transaction_same_boot || return 0
	# Legacy or invalid timing evidence is due immediately; never fall back to epoch time.
	pending_started=$(cat "$WAL/uptime-start-cs" 2>/dev/null) || return 0
	case "$pending_started" in 0[0-9]*) return 0 ;; esac
	rp_uint_between "$pending_started" 0 999999999999 || return 0
	pending_now=$(monotonic_now) || return 0
	[ "$pending_now" -ge "$pending_started" ] || return 0
	[ "$pending_now" -ge "$((pending_started + 12000))" ]
}
recover_auto_locked() {
	# The guard's earlier observation is advisory; only this locked state permits rollback.
	case "$(read_phase)" in
		applying|rolling_back) rollback_fields ;;
		pending) if pending_recovery_due; then rollback_fields; fi ;;
		prepared|expired|confirmed|rolled_back|conflict|absent) return 0 ;;
		*) phase conflict; return 1 ;;
	esac
}
status_json() {
	p=$(read_phase)
	printf '{"ok":true,"operation":"init-status","phase":"%s"' "$(rp_json_escape "$p")"
	printf ',"confirmation_transport":"trusted-ssh","http_confirmation_ready":false'
	if [ -e "$WAL/source-bootstrap" ] || [ -L "$WAL/source-bootstrap" ]; then printf ',"source_bootstrap":true,"sources_state":"pending"'; else printf ',"source_bootstrap":false'; fi
	if [ -f "$WAL/token" ] && [ ! -L "$WAL/token" ]; then printf ',"token":"%s"' "$(rp_json_escape "$(cat "$WAL/token")")"; fi
	if [ -f "$WAL/deadline" ]; then printf ',"deadline":"%s"' "$(rp_json_escape "$(cat "$WAL/deadline")")"; fi
	if [ -f "$WAL/stage" ]; then printf ',"stage":"%s"' "$(rp_json_escape "$(cat "$WAL/stage")")"; fi
	if [ -f "$WAL/failed-stage" ]; then printf ',"failed_stage":"%s"' "$(rp_json_escape "$(cat "$WAL/failed-stage")")"; fi
	if [ -f "$WAL/prepared-expired-reason" ]; then printf ',"prepared_expired_reason":"%s"' "$(rp_json_escape "$(cat "$WAL/prepared-expired-reason")")"; fi
	if [ -f "$WAL/conflicts" ]; then printf ',"conflicts":"%s"' "$(rp_json_escape "$(cat "$WAL/conflicts")")"; fi
	if [ -s "$WAL/deferred-services" ]; then printf ',"deferred_services":"%s"' "$(rp_json_escape "$(cat "$WAL/deferred-services")")"; fi
	if [ -s "$WAL/verify-error" ]; then printf ',"verification_error":"%s"' "$(rp_json_escape "$(head -c 4096 "$WAL/verify-error")")"; fi
	if [ -s "$WAL/link-error" ]; then printf ',"link_error":"%s"' "$(rp_json_escape "$(head -c 4096 "$WAL/link-error")")"; fi
	if [ -s "$WAL/link-restore-error" ]; then printf ',"link_restore_error":"%s"' "$(rp_json_escape "$(head -c 4096 "$WAL/link-restore-error")")"; fi
	if [ -s "$WAL/policy-error" ]; then printf ',"policy_error":"%s"' "$(rp_json_escape "$(head -c 4096 "$WAL/policy-error")")"; fi
	if [ -s "$WAL/policy-restore-error" ]; then printf ',"policy_restore_error":"%s"' "$(rp_json_escape "$(head -c 4096 "$WAL/policy-restore-error")")"; fi
	if status_active=$(rp_init_active_record); then
		status_dns=ready
		status_boot=$(cat "$RP_ROOT/proc/sys/kernel/random/boot_id" 2>/dev/null) || status_boot=-
		if [ "$(cat "$status_active/boot-id" 2>/dev/null)" != "$status_boot" ] && [ "$(cat "$status_active/dns-boot-ready" 2>/dev/null)" != "$status_boot" ]; then status_dns=waiting_for_boot_recovery; fi
		if [ -f "$status_active/dns-boot-pending" ]; then status_dns=pending; fi
		status_failure=$(cat "$status_active/failed-stage" 2>/dev/null) || status_failure=
		case "$status_failure:$status_dns" in boot-*:pending) status_dns=retrying ;; esac
		printf ',"active":{"token":"%s","dns_boot_state":"%s","failed_stage":"%s"}' \
			"$(rp_json_escape "$(cat "$status_active/token")")" "$status_dns" "$(rp_json_escape "$status_failure")"
	fi
	printf '}\n'
}
boot_dns_locked() (
	operation=boot-dns
	WAL=$(rp_init_active_record) || return 0
	[ -f "$WAL/dns-boot-pending" ] || return 0
	boot_now=$(cat "$RP_ROOT/proc/sys/kernel/random/boot_id") || return 1
	[ "$(cat "$WAL/dns-boot-pending")" = "$boot_now" ] && init_dns_managed || return 1
	load_args && uci_layout && no_pending || return 1
	if ! init_dns_managed_admit; then
		printf '%s\n' boot-dns-admission >"$WAL/failed-stage"
		printf '%s\n' '受管 DNS/DHCP 字段归属或已提交的 port=0、disabled=1 不匹配；未启动原生 SmartDNS，未修复用户配置' >&2
		return 1
	fi
	# S19 may have been queued before S18 quarantined its link; converge explicitly.
	init_dns_stop &&
		init_dns_call dnsmasq stop && init_dns_call dnsmasq disable || return 1
	case "$(uci_committed get routepolicy.main.enabled)" in
		1)
			printf '%s\n' boot-policy-runtime >"$WAL/stage" && sync || return 1
			if ! ROUTEPOLICY_DNS_DEFER=1 ROUTEPOLICY_OUTPUT=text timeout -s KILL 30 sh -c 'exec "$1"' routepolicy-boot-policy "$LIBEXEC/apply" >"$WAL/policy-result" 2>"$WAL/policy-error" || ! policy_verify_runtime; then
				printf '%s\n' boot-policy-runtime >"$WAL/failed-stage"; return 1
			fi ;;
		0) ;;
		*) return 1 ;;
	esac
	adapter=0; if init_dns_policy_adapter; then adapter=1; fi
	rp_smartdns_set_registration "$RP_SMARTDNS_FILE" "$adapter" || return 1
	# The application's /tmp cache starts cold on every boot, after its nft sets exist.
	init_dns_call smartdns start && init_dns_coordinate verify && init_dns_call smartdns enable || {
		init_dns_stop || true
		printf '%s\n' boot-dns-start >"$WAL/failed-stage"; return 1
	}
	case "$(cat "$WAL/failed-stage" 2>/dev/null || true)" in boot-*) rm -f "$WAL/failed-stage" ;; esac
	printf '%s\n' "$boot_now" >"$WAL/dns-boot-ready.new" && mv "$WAL/dns-boot-ready.new" "$WAL/dns-boot-ready" && rm -f "$WAL/dns-boot-pending" && sync
)
active_boot_early() (
	WAL=$(rp_init_active_record) || return 0
	if ! transaction_same_boot && init_dns_managed; then
		boot_now=$(cat "$RP_ROOT/proc/sys/kernel/random/boot_id") || return 1
		if [ "$(cat "$WAL/dns-boot-ready" 2>/dev/null || true)" != "$boot_now" ]; then
			init_dns_coordinate quarantine-boot || return 1
			printf '%s\n' "$boot_now" >"$WAL/dns-boot-pending" && sync || return 1
		fi
	fi
)

operation=${1:-}; [ "$#" -eq 0 ] || shift
case "$operation" in
	archive-migrate)
		[ "$#" = 0 ] || fail 'archive-migrate 不接受参数'
		lock
		status_json ;;
	repair)
		[ "$#" = 0 ] || fail 'repair 不接受参数'
		lock
		recover_locked || fail '事务恢复存在冲突'
		if repair_record=$(rp_init_active_record); then
			(
				WAL=$repair_record
				load_args && uci_layout && no_pending && init_dns_managed_admit || exit 1
				cat "$RP_ROOT/proc/sys/kernel/random/boot_id" >"$WAL/dns-boot-pending" && sync && init_dns_coordinate quarantine-boot
			) && boot_dns_locked || fail '声明或 DNS/策略运行态不能安全重建'
		else
			[ "$(uci -q get routepolicy.main.enabled)" != 1 ] || "$LIBEXEC/apply" || fail '应用运行态恢复失败'
		fi
		status_json ;;
	exit-preview|exit-prepare|exit-apply)
		case "$operation:$#" in exit-preview:0|exit-prepare:0|exit-apply:1) ;; *) fail '退出参数非法' ;; esac
		lock
		case "$(read_phase)" in confirmed|prepared|expired|rolled_back|exited|absent) ;; *) fail '先完成或恢复当前事务，再退出' ;; esac
		exit_record=$(rp_init_active_record) || fail '没有可验证的已确认旁路由接管'
		uci_layout || fail '不能读取已提交的逐字段状态'
		if [ "$operation" = exit-preview ]; then
			exit_problems=$(exit_check "$exit_record"); exit_ok=$?
			printf '{"ok":%s,"operation":"exit-preview","state":"%s","conflicts":"%s","confirmation_required":true,"management_may_change":true,"routing_will_stop":true}\n' \
				"$( [ "$exit_ok" = 0 ] && printf true || printf false )" "$( [ "$exit_ok" = 0 ] && printf ready || printf blocked )" "$(rp_json_escape "$exit_problems")"
			exit "$exit_ok"
		elif [ "$operation" = exit-prepare ]; then exit_prepare "$exit_record" || fail '不能准备退出'
		else exit_apply "$exit_record" "$1" || fail '退出未完成；已保留原值、外部修改和恢复记录'; status_json; fi
		;;
	shutdown-dns)
		[ "$#" = 0 ] || fail 'shutdown-dns 不接受参数'
		if [ ! -e "$WAL" ] && [ ! -L "$WAL" ] && [ ! -e "$TX/active" ] && [ ! -L "$TX/active" ]; then exit 0; fi
		lock
		# Prefer the current actually applied DNS; a prepared WAL falls back to active.
		if init_dns_owned && init_dns_managed; then :
		else
			shutdown_current=$WAL
			if ! WAL=$(rp_init_active_record); then
				WAL=$shutdown_current
				[ ! -e "$WAL/dns-service-attempted" ] && [ ! -L "$WAL/dns-service-attempted" ] || fail '关机 DNS 字段归属有冲突；未猜测修改配置'
				exit 0
			fi
			init_dns_managed || fail '关机 DNS 字段归属有冲突；未猜测修改配置'
		fi
		# Do not stop SmartDNS: rc.common calls service_stopped even if ubus is empty.
		init_dns_call smartdns disable && [ "$(init_dns_enabled smartdns)" = 0 ] || fail '不能取消原生 SmartDNS 关机回调'
		;;
	discover) [ "$#" -eq 0 ] || fail 'discover 不接受参数'; exec "$LIBEXEC/init-topology" discover ;;
	preview)
		args_valid "$@" || fail '初始化参数非法'
		no_pending || fail '存在外部 UCI pending changes'
		candidate=$(make_plan "$@") || fail '拓扑预检失败'
		# Read-only preview validates the same plan without creating any files.
		printf '%s\n' "$candidate" | plan_valid /dev/stdin || fail '候选格式非法'
		link_preview=$("$LIBEXEC/init-topology" link-plan "$@") || fail '新出口链路预检失败'
		printf '%s\n' "$link_preview" | link_plan_valid /dev/stdin || fail '新出口链路候选非法'
		preview_json "$candidate"
		;;
	prepare)
		args_valid "$@" || fail '初始化参数非法'
		lock
		! rp_dns_boot_pending || fail '已确认接管的启动恢复尚未完成，请稍后重试初始化'
		case "$(read_phase)" in absent|prepared|expired|confirmed|rolled_back|exited) ;; *) fail '存在未完成事务；请先恢复' ;; esac
		no_pending || fail '存在外部 UCI pending changes'
		candidate=$(make_plan "$@") || fail '拓扑预检失败'
		link_preview=$("$LIBEXEC/init-topology" link-plan "$@" 9>&-) || fail '新出口链路预检失败'
		# Build a complete replacement before discarding the previous reviewable candidate.
		original_wal=$WAL
		WAL="$TX/preparing"
		[ ! -L "$WAL" ] || fail '事务准备目录不安全'
		rm -rf "$WAL" || fail '不能清理准备事务目录'
		safe_dir "$WAL"; safe_dir "$WAL/delta"; safe_dir "$WAL/fields"
		printf '%s\n' "$candidate" >"$WAL/candidate" || fail '不能保存候选'
		printf '%s\n' "$link_preview" >"$WAL/link-plan" || fail '不能保存链路候选'
		link_plan_valid "$WAL/link-plan" || fail '新出口链路候选非法'
		plan_valid "$WAL/candidate" || fail '候选字段超出初始化白名单'
		( for parameter do printf '%s\t' "$parameter"; done; printf '\n' ) >"$WAL/parameters" || fail '不能保存固定参数'
		token=$(sed 's/-//g' /proc/sys/kernel/random/uuid) || fail '无法读取内核随机 token'
		[ "${#token}" -eq 32 ] || fail '无法生成事务 token'
		case "$token" in *[!0-9a-f]*) fail '内核随机 token 格式非法' ;; esac
		printf '%s\n' "$token" >"$WAL/token" || fail '不能保存事务token'
		uci_layout || fail '不能建立隔离 UCI 包命名空间'
		snapshot "$WAL/candidate" >"$WAL/baseline" || fail '不能安全保存逐字段基线'
		smartdns_coordinate prepare || fail 'SmartDNS 协调准备阶段失败'
		cat "$RP_ROOT/proc/sys/kernel/random/boot_id" >"$WAL/prepared-boot-id" && [ -s "$WAL/prepared-boot-id" ] || fail '不能记录候选启动身份'
		phase prepared || fail '持久化准备状态失败'
		[ ! -L "$TX/previous" ] || fail '事务旧代目录不安全'
		rm -rf "$TX/previous" || fail '不能清理旧准备代'
		if [ -e "$original_wal" ]; then mv "$original_wal" "$TX/previous" || fail '不能保留旧候选'; fi
		mv "$WAL" "$original_wal" && sync || fail '不能提升准备事务'
		WAL=$original_wal
		rm -rf "$TX/previous" || fail '新候选已保存，但不能清理旧准备代'
		preview_json "$candidate" "$token"
		;;
	apply)
		lock; check_token "$@"
		case "$(read_phase)" in pending|confirmed) status_json; exit 0 ;; prepared) ;; *) fail '事务阶段不能应用' ;; esac
		load_args || fail '事务参数损坏'
		uci_layout || fail '隔离 UCI 包命名空间不可用'
		no_pending || fail '存在外部 UCI pending changes'
		policy_active=0
		policy_enabled=$(uci_committed get routepolicy.main.enabled) || fail '不能读取 RoutePolicy enabled 状态'
		case "$policy_enabled" in
			0) ;;
			1) policy_runtime_present || fail '已启用 RoutePolicy 的运行态缺失；请先恢复服务后再初始化'; policy_active=1 ;;
			*) fail 'RoutePolicy enabled 配置非法' ;;
		esac
		printf '%s\n' "$policy_active" >"$WAL/policy-active" || fail '不能记录原策略运行状态'
		topology plan >"$WAL/recheck" && cmp -s "$WAL/candidate" "$WAL/recheck" || fail '候选已陈旧；请重新准备'
		snapshot "$WAL/candidate" >"$WAL/baseline-now" && cmp -s "$WAL/baseline" "$WAL/baseline-now" || fail '配置基线已变化；拒绝陈旧提交'
		topology link-plan >"$WAL/link-now" && link_plan_valid "$WAL/link-now" || fail '新出口链路候选不能重验'
		for identity_field in required dad_required device ifindex mac device_path up target; do
			[ "$(link_value "$identity_field" "$WAL/link-plan")" = "$(link_value "$identity_field" "$WAL/link-now")" ] || fail '新出口链路身份或管理状态已变化；请重新准备'
		done
		if [ "$(link_value required "$WAL/link-plan")" = 1 ]; then
			cat "$RP_ROOT/proc/sys/kernel/random/boot_id" >"$WAL/link-boot" || fail '无法记录链路启动身份'
		fi
		# A failed pre-apply guard readiness check leaves a prepared, safely retryable candidate.
		rm -rf "$WAL/fields" || fail '不能清理旧字段WAL'
		safe_dir "$WAL/fields"
		count=0
		while IFS="$TAB" read -r _action key value; do
			count=$((count + 1)); entry="$WAL/fields/$count"; mkdir "$entry" || fail '无法准备 WAL'
			printf '%s\n' "$key" >"$entry/key" && printf '%s' "$value" >"$entry/expected" && printf '%s' "$(action_type "$_action")" >"$entry/expected-type" || fail '不能保存字段WAL'
			baseline_type=$(awk -F '\t' -v wanted="$key" '$1==wanted {n++;type=$2} END{if(n!=1)exit 1;print type}' "$WAL/baseline") || fail '准备基线字段损坏'
			baseline_value=$(awk -F '\t' -v wanted="$key" '$1==wanted {print $3}' "$WAL/baseline") || fail '准备基线值损坏'
			case "$baseline_type" in
				0) printf 0 >"$entry/existed" && printf '%s' '' >"$entry/old" && printf scalar >"$entry/type" || fail '不能保存缺失字段基线' ;;
				scalar|list) printf 1 >"$entry/existed" && printf '%s' "$baseline_value" >"$entry/old" && printf '%s' "$baseline_type" >"$entry/type" || fail '不能保存字段旧值和类型' ;;
				*) fail '准备基线类型损坏' ;;
			esac
		done <"$WAL/candidate"
		wall_started=$(date +%s) && rp_uint_between "$wall_started" 0 9999999999 || fail '不能读取确认期限的墙钟时间'
		uptime_started=$(monotonic_now) || fail '不能读取启动单调时钟'
		# Keep the public epoch deadline; enforce the 120-second window using uptime only.
		printf '%s\n' "$count" >"$WAL/count" && printf '%s\n' "$((wall_started + 120))" >"$WAL/deadline" &&
			printf '%s\n' "$uptime_started" >"$WAL/uptime-start-cs" || fail '不能保存WAL计数和确认期限'
		cat "$RP_ROOT/proc/sys/kernel/random/boot_id" >"$WAL/boot-id" || fail '无法记录事务启动身份'
		[ -s "$WAL/boot-id" ] || fail '事务启动身份缺失'
		guard_start || fail '独立 procd 守卫尚未运行；拒绝应用'
		phase applying || fail '持久化 WAL 失败'
		failed_stage=
		init_dns_coordinate quiesce || failed_stage=smartdns-quiesce
		[ -n "$failed_stage" ] || { link_apply || failed_stage=$(cat "$WAL/stage" 2>/dev/null || printf link-preparation); }
		[ -n "$failed_stage" ] || { smartdns_coordinate apply || failed_stage='smartdns-apply'; }
		index=0
		while IFS="$TAB" read -r _action key value; do
			[ -z "$failed_stage" ] || break
			index=$((index + 1)); entry="$WAL/fields/$index"
			present=0; current=; currenttype=scalar
			if read_current "$key"; then present=1; current=$FIELD_VALUE; currenttype=$FIELD_TYPE
			elif [ "$?" -ne 1 ]; then failed_stage='concurrent-write'; break; fi
			old=$(cat "$entry/old")
			if [ "$present" != "$(cat "$entry/existed")" ] || [ "$current" != "$old" ] || [ "$currenttype" != "$(cat "$entry/type")" ]; then failed_stage='concurrent-write'; break; fi
			if ! { printf 'commit:%s\n' "$key" >"$WAL/stage" && sync && printf '%s' '' >"$entry/attempted" && sync; }; then
				failed_stage='wal-persist'; break
			fi
			no_pending && write_field "$key" "$(action_type "$_action")" "$value" && uci_private commit "${key%%.*}" || { failed_stage=commit; break; }
		done <"$WAL/candidate"
		[ -n "$failed_stage" ] || { printf '%s\n' firewall-check >"$WAL/stage" && rp_native_run 15 fw4 check >/dev/null 2>&1 || failed_stage='firewall-check'; }
		[ -n "$failed_stage" ] || { services_reload || failed_stage="reload:$service"; }
		[ -n "$failed_stage" ] || { wait_new_dhcp || failed_stage='dhcp-readiness'; }
		if init_dns_owned; then [ -n "$failed_stage" ] || { init_dns_coordinate handoff || failed_stage='dns-handoff'; }; fi
		source_refresh=0
		if [ -f "$TX/declarations/source-refresh" ] && [ "$(cat "$TX/declarations/init-token" 2>/dev/null)" = "$(cat "$WAL/token")" ]; then source_refresh=1; fi
		if [ -z "$failed_stage" ] && { [ "$source_refresh" = 1 ] || ! rp_sources_ready; }; then
			printf '%s\n' source-preparation >"$WAL/stage"
			if rp_init_window_open "$WAL" && rp_managed_prepare "$WAL"; then
				printf '%s\n' "$(cat "$WAL/token")" >"$WAL/source-bootstrap" && sync || failed_stage='source-bootstrap-intent'
				[ -n "$failed_stage" ] || { policy_sync bootstrap && init_dns_coordinate start || failed_stage='source-bootstrap'; }
				# Bootstrap and DNS startup consume the same original monotonic window.
				source_now=0; source_started=0; source_remaining=0
				if [ -z "$failed_stage" ]; then
					if rp_init_window_open "$WAL" && source_now=$(monotonic_now) && source_started=$(cat "$WAL/uptime-start-cs"); then
						source_remaining=$(( (source_started + 12000 - source_now) / 100 - 10 ))
						[ "$source_remaining" -gt 0 ] || failed_stage='source-timeout'
					else failed_stage='source-timeout'; fi
				fi
				if [ -z "$failed_stage" ]; then
					ROUTEPOLICY_INIT_GENERATION="$(cat "$WAL/token")" timeout -s KILL "$source_remaining" sh -c 'exec "$1" init-stage' routepolicy-init-sources "$LIBEXEC/update" >"$WAL/source-result" 2>"$WAL/source-error" && rp_sources_ready || failed_stage='source-preparation'
				fi
			else failed_stage='source-preparation'; fi
		fi
		if init_dns_owned; then
			[ -n "$failed_stage" ] || { policy_sync || failed_stage=policy-runtime; }
			[ -n "$failed_stage" ] || rm -f "$WAL/source-bootstrap" || failed_stage='source-bootstrap-retire'
			[ -n "$failed_stage" ] || { init_dns_coordinate start || failed_stage=smartdns-start; }
			[ -n "$failed_stage" ] || { printf '%s\n' runtime-verify >"$WAL/stage" && verify_runtime || failed_stage=runtime-verify; }
		else
			[ -n "$failed_stage" ] || { printf '%s\n' runtime-verify >"$WAL/stage" && verify_runtime || failed_stage=runtime-verify; }
			[ -n "$failed_stage" ] || { policy_sync || failed_stage=policy-runtime; }
		fi
		[ -n "$failed_stage" ] || { smartdns_coordinate verify || failed_stage='smartdns-verify'; }
		[ -n "$failed_stage" ] || { ! pending_recovery_due || failed_stage='confirmation-timeout'; }
		case "$a4:$a6" in default:dhcp|policy:dhcp)
			if [ -z "$failed_stage" ]; then
				dhcp_finished=$(monotonic_now) || failed_stage='confirmation-window'
				dhcp_started=$(cat "$WAL/uptime-start-cs") || failed_stage='confirmation-window'
				[ "$dhcp_finished" -le "$((dhcp_started + 10000))" ] || failed_stage='confirmation-window'
			fi ;;
		esac
		if [ -n "$failed_stage" ]; then
			printf '%s\n' "$failed_stage" >"$WAL/failed-stage"
			rollback_fields || fail "阶段 $failed_stage 失败；恢复有冲突，需人工处理"
			fail "阶段 $failed_stage 失败；本事务字段已恢复"
		fi
		phase pending || fail '不能记录待连通性确认状态'
		status_json
		;;
	confirm)
		lock; check_token "$@"
		[ ! -e "$WAL/source-bootstrap" ] && [ ! -L "$WAL/source-bootstrap" ] && rp_sources_ready || fail '来源仍在未确认引导阶段，禁止确认'
		if [ "$(read_phase)" = confirmed ]; then
			if transaction_same_boot && ! rp_dns_boot_pending; then
				init_dns_coordinate confirm || fail '确认已保存，但 watcher 启动或缓存清理失败；请重试确认'
			fi
			status_json; exit 0
		fi
		[ "$(read_phase)" = pending ] || fail '事务不在待确认阶段'
		if ! transaction_same_boot; then
			rollback_fields || fail '不能确认上次启动的事务；恢复有冲突，需人工处理'
			fail '不能确认上次启动的事务；本事务字段已恢复'
		fi
		load_args || fail '事务参数损坏'
		if pending_recovery_due; then
			rollback_fields || fail '连通性确认已超时；恢复有冲突，需人工处理'
			fail '连通性确认已超时；本事务字段已恢复'
		fi
		set -f; set -- ${SSH_CONNECTION:-}
		[ "$#" -eq 4 ] || fail '确认需要来自新管理入口的可信 SSH 会话'
		management=$(topology management-address) || fail '无法确认当前管理地址'
		[ "$3" = "$management" ] || fail 'SSH 会话未连接到预览的新管理入口'
		no_pending && verify_runtime || fail '服务或规则运行证据不满足确认条件'
		[ ! -e "$WAL/source-bootstrap" ] && [ ! -L "$WAL/source-bootstrap" ] && rp_sources_ready || fail '清单 bootstrap 尚未结束或来源未验证齐全，禁止确认'
		init_dns_coordinate verify || fail 'DNS 组或 TCP/UDP 查询验证失败'
		policy_verify_runtime || fail 'RoutePolicy 实际出站策略表与选定角色不一致'
		if init_dns_owned; then phase confirming && active_publish || fail '确认提升尚未完成；保留记录供恢复收敛'
		else phase confirmed || fail '不能持久化确认状态'; fi
		declaration_confirmed_finish || fail '网络已确认，但声明提交点尚未收敛；请重试确认'
		init_dns_coordinate confirm || fail '确认已保存，但 watcher 启动或缓存清理失败；请重试确认'
		if rp_writer_event_pending; then rp_writer_event_wake; fi
		status_json
		;;
	status) [ "$#" -eq 0 ] || fail 'status 不接受参数'; status_json ;;
	watch-ready)
		[ "$#" = 0 ] && [ "${ROUTEPOLICY_WRITER_KIND:-}" = init ] && rp_writer_owned &&
			[ "$(read_phase)" = confirmed ] && transaction_same_boot && ! rp_dns_boot_pending && uci_layout && [ "$(uci_committed get routepolicy.main.enabled)" = 1 ] && init_dns_managed &&
			watch_record=$(rp_init_active_record) && [ "$(cat "$watch_record/token")" = "$(cat "$WAL/token")" ] || exit 1
		;;
	boot-pending) [ "$#" -eq 0 ] || exit 1; rp_dns_boot_pending ;;
	guard-needed)
		rp_dns_boot_pending && exit 0
		rp_writer_event_pending && exit 0
		case "$(read_phase)" in prepared|applying|pending|rolling_back|confirming) exit 0 ;; *) exit 1 ;; esac
		;;
	boot-dns)
		[ "$#" = 0 ] || fail 'boot-dns 不接受参数'
		rp_dns_boot_pending || exit 0
		lock
		recover_locked || fail '启动事务恢复失败；DNS 保持隔离'
		boot_dns_locked || fail '启动策略/DNS 验证失败；SmartDNS 保持停用，自有 WAL 已保留'
		;;
	recover|recover-startup|recover-auto|recover-early)
		[ "$#" -eq 0 ] || fail 'recover 不接受参数'
		if [ ! -e "$WAL" ] && [ ! -L "$WAL" ] && [ ! -e "$TX/previous" ] && [ ! -L "$TX/previous" ] && [ ! -e "$TX/active" ] && [ ! -L "$TX/active" ]; then status_json; exit 0; fi
		lock
		if [ "$operation" = recover-early ]; then
			case "$(read_phase)" in
				applying|rolling_back|pending)
					if ! transaction_same_boot; then
						init_dns_coordinate quarantine-boot || fail '不能阻止候选 DNS 自启动；保留 WAL'
						rollback_fields 1 || fail '早期恢复有冲突；DNS 自启动已阻止，保留 WAL 等待人工处理'
					fi ;;
				conflict)
					init_dns_coordinate quarantine-boot || fail '恢复冲突且不能阻止候选 DNS 自启动；保留 WAL'
					fail '早期恢复存在真实冲突；DNS 自启动已阻止，请先处理并显式recover' ;;
			esac
			active_boot_early || fail '不能按已确认接管合同隔离启动 DNS'
			status_json; exit 0
		fi
		if [ "$operation" = recover-startup ] && [ "$(read_phase)" = conflict ]; then fail '启动恢复存在真实冲突；请先处理并显式recover'; fi
		if [ "$operation" = recover-auto ]; then
			recover_auto_locked || fail '自动恢复有冲突；已保留未知配置与 WAL'
		else recover_locked || fail '恢复有冲突；已保留未知配置与 WAL'; fi
		if [ "$(cat "$WAL/kind" 2>/dev/null)" = exit ] && [ "$(read_phase)" = rolled_back ]; then exit_finish || fail '退出字段已恢复，但终态尚未收敛'; fi
		if [ "$operation" != recover-startup ] && [ "$(read_phase)" = confirmed ] && transaction_same_boot && ! rp_dns_boot_pending; then
			init_dns_coordinate confirm || fail '确认已保存，但 watcher 启动或缓存清理失败；请重试恢复'
		fi
		if rp_writer_event_pending; then rp_writer_event_wake; fi
		status_json
		;;
	guard)
		[ "$#" -eq 0 ] || fail 'guard 不接受参数'
		while :; do
			if rp_dns_boot_pending; then
				"$0" boot-dns >/dev/null 2>&1 || true
				if rp_dns_boot_pending; then sleep 10; continue; fi
			fi
			if rp_writer_event_pending; then "$LIBEXEC/apply" reconcile-event >"$RP_RUN_DIR/event-reconcile.log" 2>&1 || true; fi
			case "$(read_phase)" in
				applying|rolling_back|confirming) "$0" recover-auto >/dev/null 2>&1 || true ;;
				pending) if pending_recovery_due; then "$0" recover-auto >/dev/null 2>&1 || true; fi ;;
				prepared)
					"$0" recover-auto >/dev/null 2>&1 || true
					if pending_recovery_due; then guard_stop_if_inactive && exit 0; fi ;;
				*) guard_stop_if_inactive && exit 0 ;;
			esac
			sleep 2
		done
		;;
	*) fail '未知初始化操作' ;;
esac
