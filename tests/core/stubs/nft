#!/bin/sh
[ -z "${TEST_NFT_LOG:-}" ] || printf '%s\n' "$*" >>"$TEST_NFT_LOG"
case "$*" in
	'list table inet routepolicy')
		[ "${TEST_NFT_ABSENT:-0}" != 1 ] || exit 1
		if [ "${TEST_NFT_DELETE_FAIL:-0}" = 1 ] || [ -z "${TEST_NFT_LOG:-}" ] || ! grep -Fxq 'delete table inet routepolicy' "$TEST_NFT_LOG"; then
			echo 'table inet routepolicy { }'
		else
			exit 1
		fi
		;;
	'list tables') exit 0 ;;
	'delete table inet routepolicy') [ "${TEST_NFT_DELETE_FAIL:-0}" != 1 ] ;;
	'list set inet routepolicy '*) printf 'set x {\n elements = { 8.8.8.8, 1.1.1.1 }\n}\n' ;;
	'list chain inet routepolicy classify') echo 'udp dport 53 redirect to :53' ;;
	'-c -f '*) [ "${TEST_NFT_FAIL_CHECK:-0}" = 1 ] && exit 1 || exit 0 ;;
	'-f '*) exit 0 ;;
	*) exit 1 ;;
esac
