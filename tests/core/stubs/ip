#!/bin/sh
[ -z "${TEST_IP_LOG:-}" ] || printf '%s\n' "$*" >>"$TEST_IP_LOG"
case "$*" in
	'-4 rule show')
		if [ "${TEST_IP_RULE_DELETE_FAIL:-0}" = 1 ] || [ -z "${TEST_IP_LOG:-}" ] || ! grep -Fq -- '-4 rule del priority 12000 fwmark 0x100/0x100 lookup 200' "$TEST_IP_LOG"; then
			echo '12000: from all fwmark 0x100/0x100 lookup 200'
		fi
		;;
	'-4 rule del '*) [ "${TEST_IP_RULE_DELETE_FAIL:-0}" != 1 ] ;;
	'-4 route flush table '*) [ "${TEST_IP_ROUTE_FLUSH_FAIL:-0}" != 1 ] ;;
	'-4 route show table 200')
		if [ "${TEST_IP_ROUTE_FLUSH_FAIL:-0}" = 1 ] || [ -z "${TEST_IP_LOG:-}" ] || ! grep -Fq -- '-4 route flush table 200' "$TEST_IP_LOG"; then
			printf 'default via 198.18.0.1 dev usb0 metric 10\nblackhole default metric 32760\n'
		fi
		;;
	'-4 route show table main') echo 'default via 192.0.2.254 dev eth0' ;;
esac
