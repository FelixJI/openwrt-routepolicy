'use strict';

/*
 * rpcd object deliberately exposes a small, enumerable operation surface.
 * OpenWrt 25.12 fs.popen() accepts command strings only. Every shell command
 * below is therefore a complete literal; no request field becomes a command,
 * path, nft expression, or shell fragment. Dynamic content is written to the
 * child process through stdin.
 */
import { popen } from 'fs';

const LISTS = {
    'domain-policy': {
        read: '/usr/sbin/routepolicyctl user-list read domain-policy --json',
        write: '/usr/sbin/routepolicyctl user-list write domain-policy --json'
    },
    'domain-default': {
        read: '/usr/sbin/routepolicyctl user-list read domain-default --json',
        write: '/usr/sbin/routepolicyctl user-list write domain-default --json'
    },
    'ipv4-policy': {
        read: '/usr/sbin/routepolicyctl user-list read ipv4-policy --json',
        write: '/usr/sbin/routepolicyctl user-list write ipv4-policy --json'
    },
    'ipv4-default': {
        read: '/usr/sbin/routepolicyctl user-list read ipv4-default --json',
        write: '/usr/sbin/routepolicyctl user-list write ipv4-default --json'
    }
};

/* Keep this policy aligned with converter-lib reserved(). */
const RESERVED_IPV4_RANGES = [
    [ 0, 16777215 ], [ 167772160, 184549375 ],
    [ 1681915904, 1686110207 ], [ 2130706432, 2147483647 ],
    [ 2851995648, 2852061183 ], [ 2886729728, 2887778303 ],
    [ 3221225472, 3221225727 ], [ 3221225984, 3221226239 ],
    [ 3227017984, 3227018239 ], [ 3232235520, 3232301055 ],
    [ 3323068416, 3323199487 ], [ 3325256704, 3325256959 ],
    [ 3405803776, 3405804031 ], [ 3758096384, 4294967295 ]
];

const COMMANDS = {
    status: '/usr/sbin/routepolicyctl status --json',
    validate: '/usr/sbin/routepolicyctl validate --json',
    apply: '/etc/init.d/routepolicy restart',
    reload: '/etc/init.d/routepolicy restart',
    update: '/usr/sbin/routepolicyctl update --json',
    rollback: '/usr/sbin/routepolicyctl rollback --json',
    diagnose: '/usr/sbin/routepolicyctl diagnose --json',
    smartdns_status: '/usr/sbin/routepolicyctl smartdns-status --json',
    smartdns_save: '/usr/sbin/routepolicyctl smartdns-save --json',
    smartdns_validate: '/usr/sbin/routepolicyctl smartdns-validate --json',
    smartdns_apply: '/usr/sbin/routepolicyctl smartdns-apply --json',
    smartdns_discard_candidate: '/usr/sbin/routepolicyctl smartdns-discard --json',
    read_local_hosts: '/usr/sbin/routepolicyctl smartdns-read-local-hosts --json',
    write_local_hosts: '/usr/sbin/routepolicyctl smartdns-write-local-hosts --json',
    import_legacy: '/usr/sbin/routepolicyctl import-legacy /etc/splitroute --json',
    observe_interfaces: '/usr/sbin/routepolicyctl observe-interfaces --json',
    observe_sets: '/usr/sbin/routepolicyctl observe-sets --json'
};

/*
 * OpenWrt 25.12 popen() is single-directional. Query input therefore never
 * enters a child process: rpcd selects one complete literal export command,
 * then performs bounded filtering and pagination in-process.
 */
const OBSERVE_DATASETS = {
    domain_policy: {
        field: 'domain', default_sort: 'domain', source: false,
        commands: { domain: '/usr/sbin/routepolicyctl observe-export-domain-policy --json' }
    },
    domain_default: {
        field: 'domain', default_sort: 'domain', source: false,
        commands: { domain: '/usr/sbin/routepolicyctl observe-export-domain-default --json' }
    },
    static_policy4: {
        field: 'address', default_sort: 'address', source: false,
        commands: { address: '/usr/sbin/routepolicyctl observe-export-static-policy4 --json' }
    },
    static_default4: {
        field: 'address', default_sort: 'address', source: false,
        commands: { address: '/usr/sbin/routepolicyctl observe-export-static-default4 --json' }
    },
    dynamic_policy4: {
        field: 'address', default_sort: 'address', source: false,
        commands: { address: '/usr/sbin/routepolicyctl observe-export-dynamic-policy4 --json' }
    },
    dynamic_default4: {
        field: 'address', default_sort: 'address', source: false,
        commands: { address: '/usr/sbin/routepolicyctl observe-export-dynamic-default4 --json' }
    },
    source_ingress4: {
        field: 'address', default_sort: 'bytes', source: true,
        commands: {
            address: '/usr/sbin/routepolicyctl observe-export-source-ingress4-address --json',
            bytes: '/usr/sbin/routepolicyctl observe-export-source-ingress4-bytes --json',
            packets: '/usr/sbin/routepolicyctl observe-export-source-ingress4-packets --json'
        }
    },
    source_egress4: {
        field: 'address', default_sort: 'bytes', source: true,
        commands: {
            address: '/usr/sbin/routepolicyctl observe-export-source-egress4-address --json',
            bytes: '/usr/sbin/routepolicyctl observe-export-source-egress4-bytes --json',
            packets: '/usr/sbin/routepolicyctl observe-export-source-egress4-packets --json'
        }
    }
};

function result(ok, message, extra) {
    let response = { ok: ok, message: message };
    for (let key in (extra || {}))
        response[key] = extra[key];
    return response;
}

function run(operation) {
    let proc = popen(COMMANDS[operation], 'r');
    if (!proc)
        return result(false, '无法启动 RoutePolicy 控制程序');

    let output = proc.read('all') || '';
    let exitcode = proc.close();

    if (operation == 'apply' || operation == 'reload') {
        let lifecycle = trim(output);
        return exitcode == 0
            ? result(true, lifecycle || '服务生命周期已与保存的 UCI 配置同步')
            : result(false, lifecycle || 'RoutePolicy 服务启停或应用失败', { output: output });
    }

    let payload = null;

    try {
        payload = json(output);
    }
    catch (e) {
        payload = { output: output };
    }

    if (type(payload) != 'object')
        payload = { output: output };

    /* A missing or malformed reply must never turn a failed child into success. */
    payload.ok = (exitcode == 0 && payload.ok === true);
    if (!payload.message)
        payload.message = payload.ok ? '操作完成' : 'RoutePolicy 控制程序执行失败';
    return payload;
}

function write_core(command, content, success_message) {
    if (type(content) != 'string' || length(content) > 262144)
        return result(false, '候选内容必须是小于 256 KiB 的文本');
    let proc = popen(command, 'w');
    if (!proc)
        return result(false, '无法启动 RoutePolicy 控制程序');
    let written = proc.write(content);
    if (written != length(content)) {
        proc.close();
        return result(false, '向核心事务层传递候选失败');
    }
    let exitcode = proc.close();
    return exitcode == 0 ? result(true, success_message) : result(false, '核心事务层拒绝候选');
}

function list_name(req) {
    if (!req || type(req.list) != 'string' || !LISTS[req.list])
        return null;
    return req.list;
}

function request_args(request) {
    return request && type(request.args) == 'object' ? request.args : {};
}

function array_has(values, wanted) {
    if (type(values) != 'array')
        return false;
    for (let value in values)
        if (value == wanted)
            return true;
    return false;
}

function valid_device(value) {
    return type(value) == 'string' && length(value) > 0 && length(value) <= 32 &&
        match(value, /^[A-Za-z0-9_.:@-]+$/) && substr(value, 0, 1) != '.' &&
        substr(value, 0, 1) != '-' && !match(value, /\.\./);
}

function valid_ipv4_query(value) {
    if (value == '')
        return true;
    if (!match(value, /^[0-9.\/]+$/))
        return false;
    let slash = split(value, '/');
    if (length(slash) > 2)
        return false;
    let octets = split(slash[0], '.');
    if (length(octets) > 4)
        return false;
    for (let i = 0; i < length(octets); i++) {
        if (octets[i] == '') {
            if (i != length(octets) - 1 || length(slash) > 1)
                return false;
            continue;
        }
        if (!match(octets[i], /^[0-9]{1,3}$/) || +octets[i] > 255)
            return false;
    }
    if (length(slash) == 2) {
        if (length(octets) != 4 || slash[1] == '' || !match(slash[1], /^[0-9]{1,2}$/) || +slash[1] > 32)
            return false;
    }
    return true;
}

function observe_query(request) {
    let req = request_args(request);
    if (type(req.dataset) != 'string' || !OBSERVE_DATASETS[req.dataset])
        return result(false, '未知的观测数据集');
    let spec = OBSERVE_DATASETS[req.dataset];
    let query = req.query == null ? '' : req.query;
    if (type(query) != 'string' || length(query) > 128)
        return result(false, '查询必须是不超过 128 字节的文本');
    if (spec.field == 'domain') {
        if (query != '' && !match(query, /^[A-Za-z0-9.-]+$/))
            return result(false, '域名查询只能包含字母、数字、点和连字符');
    }
    else if (!valid_ipv4_query(query)) {
        return result(false, 'IP 查询必须是 IPv4、CIDR 或点号数字前缀');
    }

    let sort_key = req.sort == null || req.sort == '' ? spec.default_sort : req.sort;
    if (type(sort_key) != 'string' || !spec.commands[sort_key])
        return result(false, '该数据集不支持请求的排序');
    let limit = req.limit == null ? 50 : req.limit;
    let limit_type = type(limit);
    if (limit_type != 'int' && limit_type != 'double' && limit_type != 'number')
        return result(false, 'limit 必须是 1..200 的整数');
    if (limit < 1 || limit > 200 || limit % 1 != 0)
        return result(false, 'limit 必须是 1..200 的整数');
    let cursor = req.cursor == null ? '' : req.cursor;
    if (type(cursor) != 'string' || length(cursor) > 256)
        return result(false, 'cursor 超出长度上限');
    if (cursor != '') {
        let early_cursor = split(cursor, ':');
        if (length(early_cursor) != 4 || early_cursor[0] != 'v1' ||
            early_cursor[1] != req.dataset || early_cursor[2] == 'unavailable')
            return result(false, 'cursor 已失效或不属于当前数据集');
    }
    let device = req.device == null ? '' : req.device;
    if (type(device) != 'string' || (!spec.source && device != '') || (device != '' && !valid_device(device)))
        return result(false, 'device 不是该数据集允许的设备过滤条件');

    let proc = popen(spec.commands[sort_key], 'r');
    if (!proc)
        return result(false, '无法启动 RoutePolicy 观测程序');
    let output = proc.read('all') || '';
    let exitcode = proc.close();
    let payload = null;
    try { payload = json(output); } catch (e) {}
    if (exitcode != 0 || type(payload) != 'object' || payload.ok !== true ||
        payload.dataset != req.dataset || type(payload.items) != 'array' ||
        length(payload.items) > 16384 || type(payload.generation) != 'string' ||
        length(payload.generation) < 1 || length(payload.generation) > 64 ||
        !match(payload.generation, /^[A-Za-z0-9_.-]+$/) || type(payload.devices) != 'array' ||
        length(payload.devices) > 3)
        return result(false, 'RoutePolicy 观测程序返回非法数据');
    if (device != '' && !array_has(payload.devices, device))
        return result(false, 'device 不属于当前受管实际设备');

    let offset = 0;
    if (cursor != '') {
        let parts = split(cursor, ':');
        if (length(parts) != 4 || parts[0] != 'v1' || parts[1] != req.dataset ||
            parts[2] != payload.generation || !match(parts[3], /^(0|[1-9][0-9]{0,4})$/))
            return result(false, 'cursor 已失效或不属于当前数据集');
        offset = +parts[3];
        if (offset > 16384)
            return result(false, 'cursor 页偏移超出上限');
    }

    let matches = [];
    for (let item in payload.items) {
        if (type(item) != 'object' || type(item[spec.field]) != 'string')
            continue;
        if (device != '' && item.device != device)
            continue;
        if (query != '' && index(lc(item[spec.field]), lc(query)) < 0)
            continue;
        push(matches, item);
    }
    if (offset > length(matches))
        return result(false, 'cursor 页偏移已超出当前结果');
    let items = [];
    for (let i = offset; i < length(matches) && length(items) < limit; i++)
        push(items, matches[i]);
    let next_offset = offset + length(items);
    let stable_generation = payload.generation != 'unavailable';
    let more_items = next_offset < length(matches);
    let next_cursor = more_items && stable_generation
        ? 'v1:' + req.dataset + ':' + payload.generation + ':' + next_offset
        : null;
    return {
        ok: true,
        dataset: req.dataset,
        items: items,
        next_cursor: next_cursor,
        total_matched: payload.truncated === true ? null : length(matches),
        generation: payload.generation,
        enabled: payload.enabled !== false,
        volatile: payload.volatile === true,
        truncated: payload.truncated === true || (more_items && !stable_generation)
    };
}

function allowed_ipv4_range(value) {
    let parts = split(value, '/');
    let octets = split(parts[0], '.');
    let address = 0;
    for (let i = 0; i < length(octets); i++)
        address = address * 256 + (+octets[i]);

    let prefix = length(parts) > 1 ? +parts[1] : 32;
    let block = 1;
    for (let i = prefix; i < 32; i++)
        block *= 2;
    let first = address - (address % block);
    let last = first + block - 1;

    for (let i = 0; i < length(RESERVED_IPV4_RANGES); i++) {
        let reserved = RESERVED_IPV4_RANGES[i];
        if (first <= reserved[1] && reserved[0] <= last)
            return false;
    }
    return true;
}

function normalize_lines(content, kind) {
    if (type(content) != 'string' || length(content) > 262144)
        return result(false, '规则内容必须是小于 256 KiB 的纯文本');

    let valid = [], invalid = [], duplicate = 0, seen = {};
    for (let raw in split(content, /\r?\n/)) {
        let line = trim(raw);
        if (!line || substr(line, 0, 1) == '#')
            continue;

        let is_domain = (kind == 'domain-policy' || kind == 'domain-default');
        let accepted = is_domain
            ? match(line, /^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$/i)
            : match(line, /^((25[0-5]|2[0-4][0-9]|1?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9][0-9]?)(\/([0-9]|[12][0-9]|3[0-2]))?$/);

        if (accepted && is_domain)
            accepted = length(line) <= 253;

        if (accepted && !is_domain)
            accepted = allowed_ipv4_range(line);

        if (!accepted) {
            push(invalid, line);
            continue;
        }
        line = lc(line);
        if (seen[line]) {
            duplicate++;
            continue;
        }
        seen[line] = true;
        push(valid, line);
    }

    return result(length(invalid) == 0, length(invalid) ? '发现非法规则，未保存' : '规则校验通过', {
        valid: valid,
        valid_count: length(valid),
        duplicate_count: duplicate,
        invalid_count: length(invalid),
        invalid: invalid
    });
}

return {
    routepolicy: {
    status: { args: {}, call: function(req) { return run('status'); } },
    observe_interfaces: { args: {}, call: function(req) { return run('observe_interfaces'); } },
    observe_sets: { args: {}, call: function(req) { return run('observe_sets'); } },
    observe_query: {
        args: { dataset: 'String', query: 'String', cursor: 'String', limit: 'Integer', device: 'String', sort: 'String' },
        call: observe_query
    },
    validate: { args: {}, call: function(req) { return run('validate'); } },
    apply: { args: {}, call: function(req) { return run('apply'); } },
    reload: { args: {}, call: function(req) { return run('reload'); } },
    update: { args: {}, call: function(req) { return run('update'); } },
    rollback: { args: {}, call: function(req) { return run('rollback'); } },
    diagnose: { args: {}, call: function(req) { return run('diagnose'); } },
    smartdns_status: { args: {}, call: function(req) { return run('smartdns_status'); } },
    smartdns_save: {
        args: { content: 'String' },
        call: function(request) {
            let req = request_args(request);
            return write_core(COMMANDS.smartdns_save, req.content, 'SmartDNS 候选已保存');
        }
    },
    smartdns_validate: { args: {}, call: function(req) { return run('smartdns_validate'); } },
    smartdns_apply: { args: {}, call: function(req) { return run('smartdns_apply'); } },
    smartdns_discard_candidate: { args: {}, call: function(req) { return run('smartdns_discard_candidate'); } },
    read_local_hosts: { args: {}, call: function(req) { return run('read_local_hosts'); } },
    write_local_hosts: {
        args: { content: 'String' },
        call: function(request) {
            let req = request_args(request);
            return write_core(COMMANDS.write_local_hosts, req.content, '本地主机候选已保存');
        }
    },
    import_legacy: { args: {}, call: function(req) { return run('import_legacy'); } },
    read_user_list: {
        args: { list: 'String' },
        call: function(request) {
            let req = request_args(request);
            let kind = list_name(req);
            if (!kind)
                return result(false, '未知的人工规则类型');
            let proc = popen(LISTS[kind].read, 'r');
            if (!proc)
                return result(false, '无法启动 RoutePolicy 控制程序');
            let output = proc.read('all') || '';
            let exitcode = proc.close();
            try {
                let payload = json(output);
                if (exitcode == 0 && type(payload) == 'object')
                    return payload;
            }
            catch (e) {}
            return result(false, '读取人工规则失败');
        }
    },
    write_user_list: {
        args: { list: 'String', content: 'String' },
        call: function(request) {
            let req = request_args(request);
            let kind = list_name(req);
            if (!kind)
                return result(false, '未知的人工规则类型');
            let checked = normalize_lines(req.content, kind);
            if (!checked.ok)
                return checked;
            /*
             * The selected command is a complete literal from LISTS. The core
             * command owns same-directory candidate creation, regular-file
             * checks and atomic replacement after accepting the enumerated kind.
             */
            let proc = popen(LISTS[kind].write, 'w');
            if (!proc)
                return result(false, '无法启动 RoutePolicy 控制程序');
            let content = join('\n', checked.valid) + (length(checked.valid) ? '\n' : '');
            let written = proc.write(content);
            if (written != length(content)) {
                proc.close();
                return result(false, '向核心校验器传递人工规则失败');
            }
            if (proc.close() != 0)
                return result(false, '核心校验或原子写入人工规则失败');
            checked.message = '人工规则已保存；RoutePolicy 启用时需重新应用配置后进入运行态';
            return checked;
        }
    }
    }
};
