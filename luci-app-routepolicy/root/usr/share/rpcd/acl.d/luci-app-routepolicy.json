{
  "luci-app-routepolicy": {
    "description": "Grant LuCI access to RoutePolicy's restricted configuration and RPC methods",
    "read": {
      "uci": [ "routepolicy" ],
      "ubus": {
        "routepolicy": [ "status", "observe_interfaces", "observe_sets", "observe_query", "validate", "diagnose", "read_user_list", "smartdns_status", "smartdns_validate", "read_local_hosts" ]
      }
    },
    "write": {
      "uci": [ "routepolicy" ],
      "ubus": {
        "routepolicy": [ "apply", "reload", "update", "rollback", "import_legacy", "write_user_list", "smartdns_save", "smartdns_apply", "smartdns_discard_candidate", "write_local_hosts" ]
      }
    }
  }
}
